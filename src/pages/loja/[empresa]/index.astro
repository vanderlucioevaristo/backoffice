---
import LojaLayout from '../../../layouts/LojaLayout.astro';
import { db, getLojaEmpresa, getSessionClient, CLIENT_SESSION_COOKIE } from '../../../lib/auth';
import { formatMoney, formatQty, parseNum } from '../../../lib/validate';

const empCodigo = String(Astro.params.empresa ?? '').toLowerCase();
const empresa = await getLojaEmpresa(empCodigo);
if (!empresa) return new Response('Loja não encontrada.', { status: 404 });

const token = Astro.cookies.get(CLIENT_SESSION_COOKIE)?.value;
const cliente = token ? await getSessionClient(token, empCodigo) : null;
if (!cliente) {
  return Astro.redirect(`/loja/${empCodigo}/login`);
}

let msgOk = '';
let msgErro = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const produtoId = Number(f.get('produto_id')) || 0;
  const qtd = Math.max(1, parseNum(f.get('quantidade'), 1));

  const prod = await db()
    .prepare('SELECT id, nome, estoque_atual FROM produtos WHERE id = ? AND empresa_id = ? AND ativo = 1 AND estoque_atual >= 1')
    .bind(produtoId, empresa.id)
    .first<{ id: number; nome: string; estoque_atual: number }>();

  if (!prod) {
    msgErro = 'Este produto não está mais disponível em estoque.';
  } else {
    const noCarrinho = await db()
      .prepare('SELECT quantidade FROM loja_carrinho WHERE empresa_id = ? AND parceiro_id = ? AND produto_id = ?')
      .bind(empresa.id, cliente.id, prod.id)
      .first<{ quantidade: number }>();

    const novaQtd = Math.min(prod.estoque_atual, Number(noCarrinho?.quantidade ?? 0) + qtd);

    await db()
      .prepare(
        `INSERT INTO loja_carrinho (empresa_id, parceiro_id, produto_id, quantidade)
         VALUES (?, ?, ?, ?)
         ON CONFLICT (empresa_id, parceiro_id, produto_id)
         DO UPDATE SET quantidade = excluded.quantidade`,
      )
      .bind(empresa.id, cliente.id, prod.id, novaQtd)
      .run();

    msgOk = `"${prod.nome}" foi adicionado ao seu carrinho!`;
  }
}

const sp = Astro.url.searchParams;
const cat = (sp.get('cat') ?? '').trim();
const q = (sp.get('q') ?? '').trim().slice(0, 80);

// Categorias que possuem ao menos 1 produto ativo com estoque >= 1
const { results: categoriasRows } = await db()
  .prepare(
    `SELECT COALESCE(NULLIF(TRIM(categoria), ''), 'Geral') AS categoria, COUNT(*) AS qtd
       FROM produtos
      WHERE empresa_id = ? AND ativo = 1 AND estoque_atual >= 1
      GROUP BY COALESCE(NULLIF(TRIM(categoria), ''), 'Geral')
      ORDER BY categoria COLLATE NOCASE`,
  )
  .bind(empresa.id)
  .all<{ categoria: string; qtd: number }>();

const where = ['p.empresa_id = ?', 'p.ativo = 1', 'p.estoque_atual >= 1'];
const args: unknown[] = [empresa.id];

if (cat) {
  if (cat === 'Geral') {
    where.push("(p.categoria IS NULL OR TRIM(p.categoria) = '' OR p.categoria = 'Geral')");
  } else {
    where.push('p.categoria = ?');
    args.push(cat);
  }
}
if (q) {
  where.push('(p.nome LIKE ? OR p.descricao LIKE ? OR p.marca LIKE ? OR p.codigo LIKE ?)');
  args.push(`%${q}%`, `%${q}%`, `%${q}%`, `%${q}%`);
}

// Ofertas ativas para o carrossel da loja (somente produtos com estoque >= 1)
const { results: ofertas } = await db()
  .prepare(
    `SELECT o.id AS oferta_id, o.titulo_oferta, o.preco_oferta,
            p.id, p.codigo, p.nome, p.descricao, p.categoria, p.marca, p.unidade,
            p.preco_venda, p.estoque_atual, p.foto
       FROM loja_ofertas o
       JOIN produtos p ON p.id = o.produto_id AND p.empresa_id = o.empresa_id
      WHERE o.empresa_id = ? AND o.ativa = 1 AND p.ativo = 1 AND p.estoque_atual >= 1
      ORDER BY o.ordem ASC, o.id DESC`,
  )
  .bind(empresa.id)
  .all<{
    oferta_id: number;
    titulo_oferta: string | null;
    preco_oferta: number;
    id: number;
    codigo: string | null;
    nome: string;
    descricao: string | null;
    categoria: string | null;
    marca: string | null;
    unidade: string;
    preco_venda: number;
    estoque_atual: number;
    foto: string | null;
  }>();

const { results: produtos } = await db()
  .prepare(
    `SELECT p.id, p.codigo, p.nome, p.descricao, p.categoria, p.marca, p.unidade,
            p.preco_venda, p.estoque_atual, p.foto,
            o.preco_oferta, o.titulo_oferta
       FROM produtos p
       LEFT JOIN loja_ofertas o ON o.produto_id = p.id AND o.empresa_id = p.empresa_id AND o.ativa = 1
      WHERE ${where.join(' AND ')}
      ORDER BY p.nome COLLATE NOCASE`,
  )
  .bind(...args)
  .all<{
    id: number;
    codigo: string | null;
    nome: string;
    descricao: string | null;
    categoria: string | null;
    marca: string | null;
    unidade: string;
    preco_venda: number;
    estoque_atual: number;
    foto: string | null;
    preco_oferta: number | null;
    titulo_oferta: string | null;
  }>();

const countCart = await db()
  .prepare('SELECT COALESCE(SUM(quantidade), 0) AS n FROM loja_carrinho WHERE empresa_id = ? AND parceiro_id = ?')
  .bind(empresa.id, cliente.id)
  .first<{ n: number }>();

const baseUrl = `/loja/${empCodigo}`;
---
<LojaLayout
  title="Catálogo de Produtos"
  empresa={empresa}
  cliente={cliente}
  qtdCarrinho={Number(countCart?.n ?? 0)}
  busca={q}
  catAtiva={cat}
  categorias={categoriasRows}
>
  {msgOk && (
    <div class="msg ok row">
      <span>{msgOk}</span>
      <span class="spacer"></span>
      <a href={`${baseUrl}/carrinho`} style="font-weight:700">Ir para o carrinho →</a>
    </div>
  )}
  {msgErro && <div class="msg err">{msgErro}</div>}

  <div class="row" style="margin-bottom:12px">
    <div style="font-size:18px;font-weight:600">
      {cat ? `Categoria: ${cat}` : 'Ofertas e Produtos em Estoque'}
      <span class="muted" style="font-size:13px;font-weight:400"> ({produtos.length} resultado{produtos.length === 1 ? '' : 's'})</span>
    </div>
    <span class="spacer"></span>
    {(q || cat) && <a class="btn sec" href={baseUrl} style="font-size:13px;padding:5px 10px">Limpar filtros</a>}
  </div>

  {ofertas.length > 0 && (
    <section class="ofertas-section" aria-label="Carrossel de Ofertas">
      <div class="ofertas-header">
        <div class="ofertas-title">
          <span class="ofertas-pill">🔥 Ofertas</span>
          <span>Destaques selecionados para você</span>
          <span class="muted" style="font-size:12px;font-weight:400">
            (clique em uma oferta para abrir e adicionar ao carrinho)
          </span>
        </div>
        <div class="ofertas-nav">
          <button type="button" class="ofertas-btn" id="of-prev" title="Oferta anterior">‹</button>
          <button type="button" class="ofertas-btn" id="of-next" title="Próxima oferta">›</button>
        </div>
      </div>

      <div class="ofertas-track" id="ofertas-track">
        {ofertas.map((of) => {
          const temDesconto = of.preco_venda > 0 && of.preco_oferta < of.preco_venda;
          const percOff = temDesconto
            ? Math.round(((of.preco_venda - of.preco_oferta) / of.preco_venda) * 100)
            : 0;
          return (
            <div
              class="oferta-slide prod-mini"
              tabindex="0"
              role="button"
              data-id={of.id}
              data-codigo={of.codigo || ''}
              data-nome={of.nome}
              data-desc={of.descricao || ''}
              data-cat={[of.categoria || 'Geral', of.marca].filter(Boolean).join(' · ')}
              data-preco={formatMoney(of.preco_oferta)}
              data-preco-antigo={temDesconto ? formatMoney(of.preco_venda) : ''}
              data-selo={of.titulo_oferta || 'OFERTA'}
              data-est={of.estoque_atual}
              data-est-fmt={`${formatQty(of.estoque_atual)} ${of.unidade}`}
              data-foto={of.foto || ''}
              title="Clique para abrir a oferta e colocar no carrinho"
            >
              <div class="oferta-top-badges">
                <span class="oferta-tag">🔥 {of.titulo_oferta || 'Oferta Especial'}</span>
                {percOff > 0 && <span class="oferta-off">{percOff}% OFF</span>}
              </div>

              <div class="oferta-thumb">
                {of.foto ? <img src={of.foto} alt={of.nome} loading="lazy" /> : <div class="ml-no-img">📦</div>}
              </div>

              <div>
                <div class="oferta-old-price">
                  {temDesconto ? `De ${formatMoney(of.preco_venda)}` : '\u00A0'}
                </div>
                <div class="oferta-new-price">{formatMoney(of.preco_oferta)}</div>
                <div class="ml-stock-badge" style="margin-top:2px">
                  Quantidade disponível: {formatQty(of.estoque_atual)} {of.unidade}
                </div>
              </div>

              <div class="ml-title" style="font-weight:500">{of.nome}</div>

              <div class="oferta-cta">
                <span>Comprar oferta</span>
                <span>🛒 →</span>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <div class="ml-cat-bar">
    <a href={baseUrl} class={`ml-cat-chip ${!cat ? 'on' : ''}`}>Todas </a>
    {categoriasRows.map((c) => (
      <a
        href={`${baseUrl}?cat=${encodeURIComponent(c.categoria)}`}
        class={`ml-cat-chip ${cat === c.categoria ? 'on' : ''}`}
      >
        {c.categoria} ({c.qtd})
      </a>
    ))}
  </div>

  {produtos.length === 0 ? (
    <div class="card muted">Nenhum produto disponível em estoque para esta seleção no momento.</div>
  ) : (
    <div class="prod-grid">
      {produtos.map((p) => {
        const precoFinal = p.preco_oferta !== null && p.preco_oferta !== undefined ? p.preco_oferta : p.preco_venda;
        const temDesc = p.preco_oferta !== null && p.preco_oferta !== undefined && p.preco_oferta < p.preco_venda;
        return (
          <div
            class="ml-card prod-mini"
            tabindex="0"
            role="button"
            data-id={p.id}
            data-codigo={p.codigo || ''}
            data-nome={p.nome}
            data-desc={p.descricao || ''}
            data-cat={[p.categoria || 'Geral', p.marca].filter(Boolean).join(' · ')}
            data-preco={formatMoney(precoFinal)}
            data-preco-antigo={temDesc ? formatMoney(p.preco_venda) : ''}
            data-selo={p.titulo_oferta || ''}
            data-est={p.estoque_atual}
            data-est-fmt={`${formatQty(p.estoque_atual)} ${p.unidade}`}
            data-foto={p.foto || ''}
            title="Clique para expandir e adicionar ao carrinho"
          >
            <div class="ml-card-thumb">
              {p.foto ? <img src={p.foto} alt={p.nome} loading="lazy" /> : <div class="ml-no-img">📦</div>}
            </div>
            <div class="ml-card-body">
              {temDesc && (
                <div style="font-size:11px;color:#94a3b8;text-decoration:line-through">
                  {formatMoney(p.preco_venda)}
                </div>
              )}
              <div class="ml-price">{formatMoney(precoFinal)}</div>
              <div class="ml-stock-badge">
                Quantidade disponível: {formatQty(p.estoque_atual)} {p.unidade}
              </div>
              <div class="ml-title">{p.nome}</div>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <dialog id="dlg-prod" class="modal" style="max-width:520px;border:none;border-radius:8px">
    <form method="post" id="form-add-cart">
      <input type="hidden" name="produto_id" id="m-id" />
      <div class="row" style="align-items:flex-start;gap:16px;margin-bottom:14px">
        <div
          id="m-icon-box"
          style="width:88px;height:88px;border-radius:6px;border:1px solid #eee;background:#fff;display:grid;place-items:center;overflow:hidden;font-size:30px;flex-shrink:0;padding:4px"
        >
          <img id="m-foto" src="" alt="" style="max-width:100%;max-height:100%;object-fit:contain;display:none" />
          <span id="m-placeholder">📦</span>
        </div>
        <div style="flex:1;min-width:180px">
          <div id="m-cat" class="muted" style="font-size:12px"></div>
          <h2 id="m-nome" style="margin:2px 0 6px;font-size:18px;font-weight:600"></h2>
          <div id="m-preco-antigo" style="font-size:13px;color:#94a3b8;text-decoration:line-through;display:none"></div>
          <div id="m-preco" style="font-size:26px;font-weight:400;color:#111"></div>
          <div style="font-size:13px;margin-top:4px;color:#00a650;font-weight:600">
            ✓ Quantidade disponível: <span id="m-est"></span>
          </div>
        </div>
      </div>

      <p id="m-desc" class="muted" style="font-size:14px;margin:0 0 14px;display:none"></p>

      <div class="row" style="padding-top:12px;border-top:1px solid #eee">
        <div style="width:120px">
          <label for="m-qtd">Quantidade</label>
          <input id="m-qtd" name="quantidade" type="number" min="1" step="1" value="1" required />
        </div>
        <span class="spacer"></span>
        <div class="row" style="margin-top:18px">
          <button type="button" class="btn sec" id="btn-fechar-prod">Fechar</button>
          <button type="submit" style="font-weight:600">🛒 Adicionar ao carrinho</button>
        </div>
      </div>
    </form>
  </dialog>
</LojaLayout>

<script is:inline>
  const dlg = document.getElementById('dlg-prod');
  const btnFechar = document.getElementById('btn-fechar-prod');
  const mId = document.getElementById('m-id');
  const mFoto = document.getElementById('m-foto');
  const mPlaceholder = document.getElementById('m-placeholder');
  const mCat = document.getElementById('m-cat');
  const mNome = document.getElementById('m-nome');
  const mPrecoAntigo = document.getElementById('m-preco-antigo');
  const mPreco = document.getElementById('m-preco');
  const mEst = document.getElementById('m-est');
  const mDesc = document.getElementById('m-desc');
  const mQtd = document.getElementById('m-qtd');

  function abrirProduto(card) {
    const d = card.dataset;
    mId.value = d.id;
    mCat.textContent = d.codigo ? `${d.cat} · Cód. ${d.codigo}` : d.cat;
    mNome.textContent = d.nome;
    if (mPrecoAntigo) {
      if (d.precoAntigo) {
        mPrecoAntigo.textContent = 'De ' + d.precoAntigo;
        mPrecoAntigo.style.display = 'block';
      } else {
        mPrecoAntigo.style.display = 'none';
      }
    }
    mPreco.textContent = d.preco;
    mEst.textContent = d.estFmt;
    if (d.desc) {
      mDesc.textContent = d.desc;
      mDesc.style.display = 'block';
    } else {
      mDesc.style.display = 'none';
    }
    if (d.foto) {
      mFoto.src = d.foto;
      mFoto.alt = d.nome;
      mFoto.style.display = 'block';
      mPlaceholder.style.display = 'none';
    } else {
      mFoto.style.display = 'none';
      mPlaceholder.style.display = 'block';
    }
    mQtd.max = d.est;
    mQtd.value = '1';
    dlg.showModal();
    setTimeout(() => mQtd.focus(), 40);
  }

  document.querySelectorAll('.prod-mini').forEach((card) => {
    card.addEventListener('click', () => abrirProduto(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        abrirProduto(card);
      }
    });
  });

  // Navegação e rotação automática do carrossel de ofertas
  const track = document.getElementById('ofertas-track');
  const btnPrev = document.getElementById('of-prev');
  const btnNext = document.getElementById('of-next');
  if (track) {
    const step = 185;
    btnPrev?.addEventListener('click', () => {
      track.scrollBy({ left: -step, behavior: 'smooth' });
    });
    btnNext?.addEventListener('click', () => {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step, behavior: 'smooth' });
      }
    });
    let autoTimer = setInterval(() => {
      if (track.matches(':hover')) return;
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step, behavior: 'smooth' });
      }
    }, 4500);
  }

  btnFechar?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>
