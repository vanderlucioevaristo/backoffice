---
import '../styles/global.css';
import { db } from '../lib/auth';
import { contarNotificacoesAgendamentoBackoffice } from '../lib/empresa-service';

interface Props { title: string; active?: string; bare?: boolean }
const { title, active = '', bare = false } = Astro.props;
const user = Astro.locals.user;

let qtdAgendamentosNovos = 0;
if (!bare && user) {
  try {
    qtdAgendamentosNovos = await contarNotificacoesAgendamentoBackoffice(db(), user.empresaId);
  } catch {
    qtdAgendamentosNovos = 0;
  }
}
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Backoffice</title>
    <style>
      .bell-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff !important;
        text-decoration: none !important;
        transition: background 0.15s, transform 0.15s;
      }
      .bell-link:hover {
        background: rgba(255, 255, 255, 0.2);
      }
      .bell-link.has-new {
        background: rgba(245, 158, 11, 0.22);
        box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.45);
      }
      .bell-icon {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transform-origin: 50% 2px;
      }
      .bell-link.has-new .bell-icon {
        color: #fbbf24;
        fill: rgba(251, 191, 36, 0.25);
        animation: bellSwing 1.1s ease-in-out infinite;
      }
      .bell-badge {
        position: absolute;
        top: -4px;
        right: -5px;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        border-radius: 999px;
        background: #ef4444;
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
        line-height: 19px;
        text-align: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.35);
        border: 1.5px solid #111827;
      }
      @keyframes bellSwing {
        0%   { transform: rotate(0deg); }
        15%  { transform: rotate(18deg); }
        30%  { transform: rotate(-16deg); }
        45%  { transform: rotate(13deg); }
        60%  { transform: rotate(-10deg); }
        75%  { transform: rotate(6deg); }
        90%  { transform: rotate(-3deg); }
        100% { transform: rotate(0deg); }
      }
    </style>
  </head>
  <body>
    {bare ? (
      <main class="auth"><slot /></main>
    ) : (
      <>
        <header class="top">
          <strong class="brand">Backoffice</strong>
          <nav>
            <a href="/" class={active === 'home' ? 'on' : ''}>Início</a>
            <a href="/clientes" class={active === 'clientes' ? 'on' : ''}>Clientes / Fornecedores</a>
            <a href="/produtos" class={active === 'produtos' ? 'on' : ''}>Produtos</a>
            <a href="/servicos" class={active === 'servicos' ? 'on' : ''}>Serviços</a>
            <a href="/agendamentos" class={active === 'agendamentos' ? 'on' : ''}>Agenda</a>
            <a href="/ofertas" class={active === 'ofertas' ? 'on' : ''}>Ofertas</a>
            <a href="/pedidos" class={active === 'pedidos' ? 'on' : ''}>Pedidos</a>
            <a href="/notas-entrada" class={active === 'notas' ? 'on' : ''}>Entrada de NF</a>
            <a href="/estoque" class={active === 'estoque' ? 'on' : ''}>Estoque</a>
            <a href="/loja-config" class={active === 'loja-config' ? 'on' : ''}>Minha Loja</a>
            {user?.perfil === 'admin' && <a href="/usuarios" class={active === 'usuarios' ? 'on' : ''}>Usuários</a>}
          </nav>
          <div class="who">
            <a
              href="/agendamentos"
              id="bell-agendamentos"
              class={`bell-link ${qtdAgendamentosNovos > 0 ? 'has-new' : ''}`}
              title={
                qtdAgendamentosNovos > 0
                  ? `${qtdAgendamentosNovos} agendamento(s) novo(s) na loja!`
                  : 'Nenhum novo agendamento pendente de visualização'
              }
            >
              <svg class="bell-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              {qtdAgendamentosNovos > 0 && (
                <span class="bell-badge" id="bell-badge">{qtdAgendamentosNovos}</span>
              )}
            </a>
            <span>{user?.empresaNome} · <a href="/conta">{user?.nome}</a></span>
            <form method="post" action="/logout" id="logout-form"><button class="link">Sair</button></form>
          </div>
        </header>
        <main class="page"><slot /></main>
        <script is:inline>
          (function () {
            const IDLE_LIMIT_MS = 5 * 60 * 1000; // 5 minutos
            let timer;
            function dropSession() {
              const form = document.getElementById('logout-form');
              if (form) {
                form.action = '/logout?expirado=1';
                form.submit();
              } else {
                window.location.href = '/logout?expirado=1';
              }
            }
            function resetIdleTimer() {
              clearTimeout(timer);
              timer = setTimeout(dropSession, IDLE_LIMIT_MS);
            }
            ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach((ev) => {
              window.addEventListener(ev, resetIdleTimer, { passive: true });
            });
            resetIdleTimer();
          })();
        </script>
      </>
    )}
  </body>
</html>
