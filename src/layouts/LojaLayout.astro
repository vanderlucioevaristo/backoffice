---
import '../styles/global.css';
import { IDLE_TIMEOUT_MS, type LojaEmpresa, type SessionClient } from '../lib/auth';
import { iconeCategoriaLoja } from '../lib/empresa-service';
import { formatDoc } from '../lib/validate';

interface Props {
  title: string;
  empresa: LojaEmpresa;
  cliente?: SessionClient | null;
  qtdCarrinho?: number;
  busca?: string;
  catAtiva?: string;
  categorias?: Array<{ categoria: string; qtd: number; icone?: string | null }>;
  bare?: boolean;
}
const {
  title,
  empresa,
  cliente = null,
  qtdCarrinho = 0,
  busca = '',
  catAtiva = '',
  categorias = [],
  bare = false,
} = Astro.props;
const baseUrl = `/loja/${empresa.codigo}`;

// Usa as cores personalizadas pelo lojista; quando estão no padrão inicial,
// aplica a identidade estilo Mercado Livre (cabeçalho amarelo #ffe600 e botões azuis #3483fa)
const headerBg =
  !empresa.cor_secundaria || empresa.cor_secundaria === '#111827' ? '#ffe600' : empresa.cor_secundaria;
const primaryColor =
  !empresa.cor_primaria || empresa.cor_primaria === '#2563eb' ? '#3483fa' : empresa.cor_primaria;
const pageBg = !empresa.cor_fundo || empresa.cor_fundo === '#f4f6f9' ? '#ebebeb' : empresa.cor_fundo;
const textColor = !empresa.cor_texto || empresa.cor_texto === '#1c2430' ? '#333333' : empresa.cor_texto;
const footerBg = empresa.rodape_cor_fundo || '#ffffff';
const footerTx = empresa.rodape_cor_texto || '#333333';
const whatsDigits = (empresa.rodape_whatsapp ?? '').replace(/\D/g, '');
const whatsHref = whatsDigits
  ? `https://wa.me/${whatsDigits.length <= 11 ? '55' + whatsDigits : whatsDigits}`
  : '';
const anoAtual = new Date().getFullYear();

// Calcula se o fundo do cabeçalho é claro ou escuro para ajustar o contraste do texto
const hex = headerBg.replace('#', '');
const r = parseInt(hex.slice(0, 2) || 'ff', 16);
const g = parseInt(hex.slice(2, 4) || 'e6', 16);
const b = parseInt(hex.slice(4, 6) || '00', 16);
const headerText = (r * 299 + g * 587 + b * 114) / 1000 > 155 ? '#2d3277' : '#ffffff';
const catHeaderText =
  empresa.cor_texto_categorias_topo && /^#[0-9a-fA-F]{6}$/.test(empresa.cor_texto_categorias_topo)
    ? empresa.cor_texto_categorias_topo
    : headerText;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {empresa.nome}</title>
    <link rel="manifest" href={`/loja/${empresa.codigo}/manifest.webmanifest`} />
    <meta name="theme-color" content={headerBg} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={empresa.nome} />
    <link rel="icon" href={empresa.loja_logo || `/loja/${empresa.codigo}/icon.svg`} />
    <link rel="apple-touch-icon" href={empresa.loja_logo || `/loja/${empresa.codigo}/icon.svg`} />
    <style is:global define:vars={{
      pr: primaryColor,
      topBg: headerBg,
      topTx: headerText,
      topCatTx: catHeaderText,
      bg: pageBg,
      tx: textColor,
      ftBg: footerBg,
      ftTx: footerTx,
    }}>
      :root {
        --pr: var(--pr);
        --bg: var(--bg);
        --tx: var(--tx);
      }
      body {
        background: var(--bg);
        color: var(--tx);
        font-family: "Proxima Nova", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* Cabeçalho estilo Mercado Livre (suporta cor sólida ou imagem de fundo ocupando toda a barra) */
      .ml-header {
        position: sticky;
        top: 0;
        z-index: 90;
        background-color: var(--topBg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: var(--topTx);
        box-shadow: 0 2px 6px rgba(0,0,0,.12);
      }
      .ml-header-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 10px 18px 10px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .ml-top-row {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
      }
      .ml-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--topTx) !important;
        font-size: 20px;
        font-weight: 800;
        text-decoration: none !important;
        letter-spacing: -0.3px;
      }
      .ml-brand img {
        max-height: 36px;
        max-width: 130px;
        object-fit: contain;
        border-radius: 4px;
      }
      .ml-search {
        flex: 1;
        min-width: 240px;
        max-width: 600px;
        display: flex;
        background: #fff;
        border-radius: 2px;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,.2);
        overflow: hidden;
      }
      .ml-search input {
        border: none;
        padding: 9px 14px;
        font-size: 15px;
        color: #333;
        width: 100%;
        outline: none;
      }
      .ml-search button {
        background: #fff;
        color: #666;
        border: none;
        border-left: 1px solid #e6e6e6;
        border-radius: 0;
        padding: 0 14px;
        cursor: pointer;
        font-size: 15px;
      }
      .ml-search button:hover { color: #111; }

      .ml-nav-row {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        padding-top: 2px;
        border-top: 1px solid rgba(0, 0, 0, 0.07);
      }
      .ml-cats {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: nowrap;
        overflow-x: auto;
        scrollbar-width: thin;
        padding: 1px 2px 2px;
        flex: 1;
      }
      .ml-cats a {
        color: var(--topCatTx) !important;
        opacity: 0.92;
        text-decoration: none;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        padding: 2px 6px;
        border-radius: 6px;
        background: transparent;
        border: none;
        text-align: center;
        line-height: 1.15;
        transition: transform 0.14s ease, opacity 0.14s ease;
        flex-shrink: 0;
      }
      .ml-cats a .nav-cat-ico {
        font-size: 15px;
        line-height: 1;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
      }
      .ml-cats a .nav-cat-txt {
        font-size: 11.5px;
        white-space: nowrap;
      }
      .ml-user-links a {
        color: var(--topTx);
        opacity: 0.85;
        text-decoration: none;
      }
      .ml-cats a:hover, .ml-cats a.on {
        opacity: 1;
        text-decoration: none;
        font-weight: 700;
        background: transparent;
        transform: translateY(-1px);
      }
      .ml-user-links a:hover {
        opacity: 1;
        text-decoration: none;
        font-weight: 600;
      }
      .ml-user-links {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
      }
      .ml-cart-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 700;
        background: #ffffff;
        color: #000000 !important;
        opacity: 1 !important;
        padding: 5px 11px;
        border-radius: 999px;
        box-shadow: 0 1px 3px rgba(0,0,0,.18);
      }
      .ml-cart-pill svg {
        width: 16px;
        height: 16px;
        stroke: #000000;
        fill: none;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
      }
      .ml-badge {
        background: var(--pr);
        color: #fff;
        font-size: 11px;
        padding: 1px 6px;
        border-radius: 99px;
      }
      .ml-logout-btn {
        background: none;
        border: none;
        color: var(--topTx);
        opacity: 0.8;
        padding: 0;
        font-size: 13px;
        cursor: pointer;
      }
      .ml-logout-btn:hover { opacity: 1; text-decoration: underline; }

      /* Área principal e cards estilo Mercado Livre */
      .ml-page {
        max-width: 1320px;
        margin: 18px auto 40px;
        padding: 0 18px;
      }
      .prod-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
        gap: 14px;
        align-items: stretch;
      }
      @media (min-width: 960px) {
        .prod-grid {
          grid-template-columns: repeat(5, minmax(0, 1fr));
        }
      }
      .ml-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 6px 0 rgba(0,0,0,.12);
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: box-shadow .16s ease, transform .16s ease;
        overflow: hidden;
        position: relative;
      }
      .fav-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 4;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid rgba(0, 0, 0, 0.08);
        background: rgba(255, 255, 255, 0.92);
        color: #64748b;
        padding: 0;
        display: grid;
        place-items: center;
        font-size: 15px;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
        transition: transform 0.15s ease, background 0.15s ease;
      }
      .fav-btn:hover {
        transform: scale(1.12);
        background: #ffffff;
      }
      .fav-btn.is-fav {
        background: #fff1f2;
        border-color: #fecdd3;
        color: #e11d48;
      }
      .ml-card:hover {
        box-shadow: 0 7px 16px 0 rgba(0,0,0,.18);
        transform: translateY(-2px);
      }
      .ml-card-thumb {
        height: 92px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        background: #fff;
      }
      .ml-card-thumb img {
        max-width: 72px;
        max-height: 72px;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 10px;
      }
      .ml-card-thumb .ml-no-img {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #f5f5f5;
        display: grid;
        place-items: center;
        font-size: 22px;
      }
      .ml-card-body {
        padding: 10px 12px 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }
      .ml-price {
        font-size: 20px;
        font-weight: 500;
        color: #111;
        line-height: 1.15;
      }
      .ml-stock-badge {
        font-size: 11px;
        font-weight: 600;
        color: #00a650;
      }
      .ml-title {
        font-size: 13px;
        color: rgba(0,0,0,.8);
        font-weight: 400;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 2px;
      }
      .ml-cat-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
      }
      .ml-cat-chip {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 4px 10px;
        font-size: 12px;
        color: #1e293b;
        text-decoration: none !important;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        text-align: center;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease;
      }
      .ml-cat-chip:hover {
        border-color: var(--pr);
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.06);
      }
      .ml-cat-chip .cat-chip-ico {
        width: auto;
        height: 17px;
        background: transparent;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        line-height: 1;
        box-shadow: none;
        flex-shrink: 0;
      }
      .ml-cat-chip .cat-chip-lbl {
        line-height: 1.15;
        font-weight: 600;
        white-space: nowrap;
      }
      .ml-cat-chip .cat-chip-qtd {
        font-size: 11px;
        opacity: 0.75;
        font-weight: 500;
      }
      .ml-cat-chip.on {
        background: var(--pr);
        border-color: var(--pr);
        color: #fff;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(52, 131, 250, 0.28);
      }
      .ml-cat-chip.on .cat-chip-ico {
        background: transparent;
        border: none;
      }
      .ml-cat-chip.on .cat-chip-qtd {
        opacity: 0.92;
      }

      /* Carrossel de Ofertas em Destaque */
      .ofertas-section {
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 14px;
        padding: 10px 14px 12px;
        margin-bottom: 14px;
        box-shadow: 0 2px 6px rgba(0,0,0,.05);
        position: relative;
      }
      .ofertas-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        gap: 8px;
      }
      .ofertas-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        font-weight: 700;
        color: #111;
      }
      .ofertas-pill {
        background: #ef4444;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        padding: 1px 7px;
        border-radius: 99px;
        letter-spacing: .03em;
        text-transform: uppercase;
      }
      .ofertas-nav {
        display: flex;
        gap: 5px;
      }
      .ofertas-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #1e293b;
        padding: 0;
        display: grid;
        place-items: center;
        font-size: 15px;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0,0,0,.06);
      }
      .ofertas-btn:hover {
        background: var(--pr);
        border-color: var(--pr);
        color: #fff;
      }
      .ofertas-track {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        padding: 2px 2px 4px;
        scrollbar-width: none;
      }
      .ofertas-track::-webkit-scrollbar {
        display: none;
      }
      .oferta-slide {
        flex: 0 0 175px;
        scroll-snap-align: start;
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 14px;
        padding: 8px 10px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 4px;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
        position: relative;
      }
      .oferta-slide:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(0,0,0,.12);
        border-color: var(--pr);
      }
      .oferta-top-badges {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4px;
      }
      .oferta-tag {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        font-size: 9.5px;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 99px;
        text-transform: uppercase;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .oferta-off {
        background: #00a650;
        color: #fff;
        font-size: 9.5px;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 99px;
        white-space: nowrap;
      }
      .oferta-thumb {
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 4px;
      }
      .oferta-thumb img {
        max-width: 50px;
        max-height: 50px;
        object-fit: contain;
        border-radius: 8px;
      }
      .oferta-old-price {
        font-size: 11px;
        color: #94a3b8;
        text-decoration: line-through;
        min-height: 14px;
        line-height: 1.1;
      }
      .oferta-new-price {
        font-size: 16px;
        font-weight: 700;
        color: #111;
        line-height: 1.1;
      }
      .oferta-cta {
        margin-top: auto;
        padding-top: 3px;
        font-size: 11px;
        font-weight: 700;
        color: var(--pr);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      /* Rodapé personalizável da loja (recolhido por padrão, expansível ao clicar) */
      .ml-footer {
        margin-top: auto;
        background: var(--ftBg);
        color: var(--ftTx);
        border-top: 1px solid rgba(0,0,0,.1);
        font-size: 13px;
        line-height: 1.5;
      }
      .ml-footer-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 11px 16px;
        background: rgba(128,128,128,.08);
        color: var(--ftTx);
        border: none;
        border-bottom: 1px solid rgba(128,128,128,.15);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s ease;
      }
      .ml-footer-toggle:hover {
        background: rgba(128,128,128,.15);
      }
      .ml-footer-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 28px 16px 22px;
        display: none;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 28px;
      }
      .ml-footer.expanded .ml-footer-inner {
        display: grid;
      }
      .ml-footer-col h4 {
        margin: 0 0 10px;
        font-size: 14px;
        font-weight: 700;
        color: var(--ftTx);
      }
      .ml-footer-col p,
      .ml-footer-col div {
        color: var(--ftTx);
        opacity: 0.85;
        margin: 0 0 6px;
      }
      .ml-footer-col a {
        color: var(--ftTx);
        opacity: 0.88;
        text-decoration: none;
      }
      .ml-footer-col a:hover {
        opacity: 1;
        text-decoration: underline;
      }
      .ml-footer-bottom {
        border-top: 1px solid rgba(128,128,128,.2);
        padding: 14px 16px;
        text-align: center;
        font-size: 12px;
        opacity: 0.78;
      }

      /* Bot de Atendimento da Loja */
      .bot-fab {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 95;
        background: var(--pr);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 12px 18px;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 6px 20px rgba(0,0,0,.22);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: transform .15s ease, box-shadow .15s ease;
      }
      .bot-fab:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,.28);
      }
      .bot-win {
        position: fixed;
        right: 20px;
        bottom: 76px;
        width: 360px;
        max-width: calc(100vw - 32px);
        height: 490px;
        max-height: calc(100vh - 110px);
        background: #fff;
        color: #1e293b;
        border-radius: 14px;
        box-shadow: 0 12px 36px rgba(0,0,0,.24);
        border: 1px solid #e2e8f0;
        z-index: 96;
        display: none;
        flex-direction: column;
        overflow: hidden;
      }
      .bot-win.open {
        display: flex;
      }
      .bot-head {
        background: var(--pr);
        color: #fff;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .bot-head-title {
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
      }
      .bot-head-sub {
        font-size: 11px;
        opacity: 0.9;
      }
      .bot-close {
        background: rgba(255,255,255,.18);
        color: #fff;
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        padding: 0;
        cursor: pointer;
        font-size: 14px;
      }
      .bot-msgs {
        flex: 1;
        padding: 12px;
        overflow-y: auto;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .bot-bubble {
        max-width: 86%;
        padding: 9px 12px;
        border-radius: 12px;
        font-size: 13px;
        line-height: 1.45;
        word-wrap: break-word;
      }
      .bot-bubble.bot {
        align-self: flex-start;
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        border-bottom-left-radius: 3px;
      }
      .bot-bubble.user {
        align-self: flex-end;
        background: var(--pr);
        color: #ffffff;
        border-bottom-right-radius: 3px;
      }
      .bot-chips {
        display: flex;
        gap: 6px;
        padding: 8px 10px;
        background: #f1f5f9;
        border-top: 1px solid #e2e8f0;
        overflow-x: auto;
        white-space: nowrap;
      }
      .bot-chip {
        background: #fff;
        color: #334155;
        border: 1px solid #cbd5e1;
        border-radius: 99px;
        padding: 4px 10px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
      }
      .bot-chip:hover {
        border-color: var(--pr);
        color: var(--pr);
      }
      .bot-form {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px;
        background: #fff;
        border-top: 1px solid #e2e8f0;
        flex-shrink: 0;
      }
      .bot-form input {
        flex: 1 1 auto;
        width: auto;
        min-width: 0;
        font-size: 13px;
        padding: 8px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
      }
      .bot-form button {
        flex-shrink: 0;
        white-space: nowrap;
        background: var(--pr);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 13px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }

      /* Responsividade para celulares e telas menores */
      @media (max-width: 768px) {
        .ml-header-inner {
          padding: 8px 12px;
          gap: 6px;
        }
        .ml-top-row {
          gap: 8px;
        }
        .ml-brand {
          font-size: 16px;
          gap: 8px;
        }
        .ml-brand img {
          max-height: 28px;
          max-width: 96px;
        }
        .ml-search {
          order: 3;
          flex: 1 1 100%;
          min-width: 100%;
          max-width: 100%;
          border-radius: 6px;
        }
        .ml-search input {
          padding: 7px 10px;
          font-size: 14px;
        }
        .ml-user-links {
          gap: 10px;
          font-size: 12px;
          margin-left: auto;
        }
        .ml-nav-row {
          overflow-x: auto;
          scrollbar-width: none;
          padding-bottom: 2px;
        }
        .ml-nav-row::-webkit-scrollbar {
          display: none;
        }
        .ml-cats {
          flex-wrap: nowrap;
          white-space: nowrap;
          gap: 12px;
          font-size: 12px;
        }
        .ml-page {
          margin: 12px auto 28px;
          padding: 0 10px;
        }
        .ml-cat-bar {
          display: flex;
          flex-wrap: nowrap;
          overflow-x: auto;
          padding-bottom: 4px;
          margin-bottom: 10px;
          scrollbar-width: none;
        }
        .ml-cat-bar::-webkit-scrollbar {
          display: none;
        }
        .ml-cat-chip {
          padding: 4px 9px;
          font-size: 11.5px;
          flex-shrink: 0;
        }
        /* Grid de 2 colunas em celulares para nunca virar lista de 1 coluna */
        .prod-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
        }
        .ml-card {
          border-radius: 12px;
        }
        .ml-card-thumb {
          height: 80px;
          padding: 6px;
        }
        .ml-card-thumb img {
          max-width: 62px;
          max-height: 62px;
        }
        .ml-card-body {
          padding: 8px 10px 10px;
        }
        .ml-price {
          font-size: 16px;
        }
        .ml-stock-badge {
          font-size: 10.5px;
        }
        .ml-title {
          font-size: 12px;
        }
        /* Carrossel compacto no celular */
        .ofertas-section {
          padding: 8px 10px 10px;
          margin-bottom: 12px;
          border-radius: 12px;
        }
        .ofertas-title {
          font-size: 13px;
        }
        .ofertas-hint {
          display: none;
        }
        .oferta-slide {
          flex: 0 0 148px;
          padding: 7px 8px;
