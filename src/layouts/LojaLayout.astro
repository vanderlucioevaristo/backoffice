    </style>
  </head>
  <body
    data-empresa-codigo={empresa.codigo}
    data-sair-url={!bare && cliente ? `${baseUrl}/sair?expirado=1` : ''}
    data-idle-ms={
      Number(empresa.tempo_sessao_minutos) > 0
        ? Number(empresa.tempo_sessao_minutos) * 60 * 1000
        : IDLE_TIMEOUT_MS
    }
  >
    <header
      class="ml-header"
      style={
        empresa.loja_topo_imagem
          ? `background-image:url('${empresa.loja_topo_imagem.replace(/'/g, "\\'")}');background-size:cover;background-position:center;background-repeat:no-repeat;`
