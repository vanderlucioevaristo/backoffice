---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/auth';
import { str, onlyDigits, parseNum, formatDoc, formatMoney, formatQty } from '../../lib/validate';

const u = Astro.locals.user!;
const hoje = new Date().toISOString().slice(0, 10);

const { results: fornecedores } = await db()
  .prepare('SELECT id, nome, documento FROM parceiros WHERE empresa_id = ? AND eh_fornecedor = 1 AND ativo = 1 ORDER BY nome COLLATE NOCASE')
  .bind(u.empresaId)
  .all<{ id: number; nome: string; documento: string | null }>();

const { results: produtos } = await db()
  .prepare('SELECT id, codigo, nome, unidade, preco_custo, preco_venda, estoque_atual FROM produtos WHERE empresa_id = ? AND ativo = 1 ORDER BY nome COLLATE NOCASE')
  .bind(u.empresaId)
  .all<{ id: number; codigo: string | null; nome: string; unidade: string; preco_custo: number; preco_venda: number; estoque_atual: number }>();

type ItemForm = {
  produto_id: number;
  quantidade: number;
  valor_unitario: number;
  novo_preco_venda: number | null;
};

let erro = '';
let cab = {
  fornecedor_id: 0,
  numero: '',
  serie: '1',
  chave_acesso: '',
  data_emissao: hoje,
  data_entrada: hoje,
  valor_frete: 0,
  valor_desconto: 0,
  valor_outros: 0,
  observacoes: '',
};
let itens: ItemForm[] = [];

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  cab = {
    fornecedor_id: Number(f.get('fornecedor_id')) || 0,
    numero: str(f, 'numero', 30),
    serie: str(f, 'serie', 10),
    chave_acesso: onlyDigits(str(f, 'chave_acesso', 60)),
    data_emissao: str(f, 'data_emissao', 10) || hoje,
    data_entrada: str(f, 'data_entrada', 10) || hoje,
    valor_frete: Math.max(0, parseNum(f.get('valor_frete'), 0)),
    valor_desconto: Math.max(0, parseNum(f.get('valor_desconto'), 0)),
    valor_outros: Math.max(0, parseNum(f.get('valor_outros'), 0)),
    observacoes: str(f, 'observacoes', 2000),
  };

  const pIds = f.getAll('produto_id').map((x) => Number(x));
  const qtds = f.getAll('quantidade').map((x) => parseNum(x, 0));
  const vUnits = f.getAll('valor_unitario').map((x) => parseNum(x, -1));
  const vVendas = f.getAll('novo_preco_venda').map((x) => String(x ?? '').trim());

  const prodMap = new Map(produtos.map((p) => [p.id, p]));
  const fornOk = fornecedores.some((fn) => fn.id === cab.fornecedor_id);

  itens = [];
  for (let i = 0; i < pIds.length; i++) {
    const pid = pIds[i];
    if (!pid && !qtds[i]) continue; // linha vazia
    const pvRaw = vVendas[i];
    const pv = pvRaw ? parseNum(pvRaw, -1) : null;
    itens.push({
      produto_id: pid,
      quantidade: qtds[i],
      valor_unitario: vUnits[i],
      novo_preco_venda: pv,
    });
  }

  if (!fornOk) erro = 'Selecione um fornecedor válido.';
  else if (!cab.numero) erro = 'Informe o número da Nota Fiscal.';
  else if (cab.chave_acesso && cab.chave_acesso.length !== 44) erro = 'A chave de acesso da NF-e deve ter 44 dígitos.';
  else if (itens.length === 0) erro = 'Adicione pelo menos um produto à nota fiscal.';
  else {
    for (const it of itens) {
      if (!prodMap.has(it.produto_id)) {
        erro = 'Selecione um produto previamente cadastrado em todas as linhas.';
        break;
      }
      if (it.quantidade <= 0) {
        erro = 'A quantidade de cada item deve ser maior que zero.';
        break;
      }
      if (it.valor_unitario < 0) {
        erro = 'Informe um custo unitário válido para cada item.';
        break;
      }
      if (it.novo_preco_venda !== null && it.novo_preco_venda < 0) {
        erro = 'O preço de venda não pode ser negativo.';
        break;
      }
    }
  }

  if (!erro) {
    const dup = await db()
      .prepare("SELECT id FROM notas_entrada WHERE empresa_id = ? AND fornecedor_id = ? AND numero = ? AND COALESCE(serie,'') = ?")
      .bind(u.empresaId, cab.fornecedor_id, cab.numero, cab.serie)
      .first();
    if (dup) erro = 'Já foi dada entrada nesta Nota Fiscal para este fornecedor.';
  }

  if (!erro) {
    const valorProdutos = itens.reduce((acc, it) => acc + it.quantidade * it.valor_unitario, 0);
    const valorTotal = Math.max(0, valorProdutos + cab.valor_frete + cab.valor_outros - cab.valor_desconto);

    // 1. Grava o cabeçalho da NF
    const nf = await db()
      .prepare(
        `INSERT INTO notas_entrada
           (empresa_id, fornecedor_id, numero, serie, chave_acesso, data_emissao, data_entrada,
            valor_produtos, valor_frete, valor_desconto, valor_outros, valor_total, observacoes, usuario_id)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) RETURNING id`,
      )
      .bind(
        u.empresaId,
        cab.fornecedor_id,
        cab.numero,
        cab.serie || null,
        cab.chave_acesso || null,
        cab.data_emissao,
        cab.data_entrada,
        valorProdutos,
        cab.valor_frete,
        cab.valor_desconto,
        cab.valor_outros,
        valorTotal,
        cab.observacoes || null,
        u.id,
      )
      .first<{ id: number }>();

    const notaId = nf!.id;

    // 2. Para cada item: grava item da nota, alimenta o estoque, atualiza preço de compra (e venda, se informado),
    //    vincula/atualiza o fornecedor no produto e registra movimentação no Kardex.
    for (const it of itens) {
      const subtotal = it.quantidade * it.valor_unitario;

      await db()
        .prepare(
          `INSERT INTO notas_entrada_itens
             (empresa_id, nota_id, produto_id, quantidade, valor_unitario, valor_total, novo_preco_venda)
           VALUES (?, ?, ?, ?, ?, ?, ?)`,
        )
        .bind(u.empresaId, notaId, it.produto_id, it.quantidade, it.valor_unitario, subtotal, it.novo_preco_venda)
        .run();

      const atual = await db()
        .prepare('SELECT estoque_atual, preco_venda FROM produtos WHERE id = ? AND empresa_id = ?')
        .bind(it.produto_id, u.empresaId)
        .first<{ estoque_atual: number; preco_venda: number }>();

      const saldoAnt = Number(atual?.estoque_atual ?? 0);
      const saldoPost = saldoAnt + it.quantidade;
      const precoVendaFinal = it.novo_preco_venda !== null ? it.novo_preco_venda : Number(atual?.preco_venda ?? 0);

      await db()
        .prepare(
          `UPDATE produtos
              SET estoque_atual = ?,
                  preco_custo   = ?,
                  preco_venda   = ?,
                  atualizado_em = datetime('now')
            WHERE id = ? AND empresa_id = ?`,
        )
        .bind(saldoPost, it.valor_unitario, precoVendaFinal, it.produto_id, u.empresaId)
        .run();

      // Atualiza ou cria vínculo produto <-> fornecedor com o último preço e número da NF
      await db()
        .prepare(
          `INSERT INTO produtos_fornecedores
             (empresa_id, produto_id, fornecedor_id, ultimo_preco, ultimo_nf, data_ultima_nf, preferencial)
           VALUES (?, ?, ?, ?, ?, ?, 0)
           ON CONFLICT (empresa_id, produto_id, fornecedor_id)
           DO UPDATE SET ultimo_preco   = excluded.ultimo_preco,
                         ultimo_nf      = excluded.ultimo_nf,
                         data_ultima_nf = excluded.data_ultima_nf`,
        )
        .bind(u.empresaId, it.produto_id, cab.fornecedor_id, it.valor_unitario, cab.numero, cab.data_emissao)
        .run();

      // Registra no histórico de estoque (Kardex)
      await db()
        .prepare(
          `INSERT INTO estoque_movimentacoes
             (empresa_id, produto_id, tipo, origem, referencia_id, quantidade,
              saldo_anterior, saldo_posterior, custo_unitario, observacao, usuario_id)
           VALUES (?, ?, 'E', 'NF_ENTRADA', ?, ?, ?, ?, ?, ?, ?)`,
        )
        .bind(
          u.empresaId,
          it.produto_id,
          notaId,
          it.quantidade,
          saldoAnt,
          saldoPost,
          it.valor_unitario,
          `Entrada NF ${cab.numero}${cab.serie ? '/' + cab.serie : ''}`,
          u.id,
        )
        .run();
    }

    return Astro.redirect('/notas-entrada?ok=salva');
  }
}

const rowsToRender: ItemForm[] =
  itens.length > 0 ? itens : [{ produto_id: 0, quantidade: 1, valor_unitario: 0, novo_preco_venda: null }];
---
<Layout title="Dar entrada em Nota Fiscal" active="notas">
  <div class="row" style="margin-bottom:16px">
    <h1 style="margin:0">Dar entrada em Nota Fiscal (Compra)</h1>
    <span class="spacer"></span>
    <button type="button" class="btn sec" id="btn-auto-nf">⚡ Cadastro automático</button>
  </div>
  {erro && <div class="msg err">{erro}</div>}
  <div id="nf-auto-aviso" class="msg ok" style="display:none"></div>

  <dialog id="dlg-auto-nf" class="modal" style="max-width:520px">
    <form method="dialog" id="form-auto-nf">
      <h2>Cadastro automático de NF-e</h2>
      <p class="muted" style="margin-top:0;font-size:13px">
        Informe a Chave de Acesso da NF-e (44 dígitos) ou selecione o arquivo XML da nota fiscal eletrônica para carregar os dados automaticamente.
      </p>
      <div id="nf-auto-erro" class="msg err" style="display:none"></div>
      <p>
        <label for="inp-auto-chave">Chave de acesso / Nº da NF-e (44 dígitos)</label>
        <input
          id="inp-auto-chave"
          placeholder="Digite ou leia no código de barras os 44 dígitos da NF-e"
          inputmode="numeric"
          maxlength="54"
          autocomplete="off"
        />
      </p>
      <p>
        <label for="inp-auto-xml">Ou arquivo XML da NF-e (carrega cabeçalho + todos os produtos e valores)</label>
        <input id="inp-auto-xml" type="file" accept=".xml,text/xml,application/xml" />
      </p>
      <div class="row" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn sec" id="btn-auto-nf-fechar">Cancelar</button>
        <button type="submit" id="btn-auto-nf-buscar">Buscar</button>
      </div>
    </form>
  </dialog>

  <dialog id="dlg-sug-forn" class="modal" style="max-width:620px">
    <form method="dialog" id="form-sug-forn">
      <h2>Cadastrar fornecedor da Nota Fiscal?</h2>
      <p class="muted" style="margin-top:0;font-size:13px">
        O emitente desta NF-e ainda não está no seu cadastro de fornecedores. Confira os dados abaixo e confirme para cadastrá-lo automaticamente.
      </p>
      <div id="sug-forn-erro" class="msg err" style="display:none"></div>
      <div class="grid">
        <div class="c4">
          <label>CNPJ / CPF</label>
          <input id="sf-doc" required />
        </div>
        <div class="c4">
          <label>Inscrição Estadual</label>
          <input id="sf-ie" />
        </div>
        <div class="c4">
          <label>Telefone</label>
          <input id="sf-fone" />
        </div>
        <div class="c8">
          <label>Razão Social / Nome *</label>
          <input id="sf-nome" required />
        </div>
        <div class="c4">
          <label>Nome Fantasia</label>
          <input id="sf-fantasia" />
        </div>
        <div class="c3">
          <label>CEP</label>
          <input id="sf-cep" />
        </div>
        <div class="c6">
          <label>Logradouro</label>
          <input id="sf-logr" />
        </div>
        <div class="c3">
          <label>Número</label>
          <input id="sf-num" />
        </div>
        <div class="c4">
          <label>Bairro</label>
          <input id="sf-bairro" />
        </div>
        <div class="c6">
          <label>Cidade</label>
          <input id="sf-cid" />
        </div>
        <div class="c2">
          <label>UF</label>
          <input id="sf-uf" maxlength="2" style="text-transform:uppercase" />
        </div>
      </div>
      <div class="row" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn sec" id="btn-forn-ignorar">Não cadastrar agora</button>
        <button type="submit" id="btn-forn-confirmar">✓ Confirmar e cadastrar fornecedor</button>
      </div>
    </form>
  </dialog>

  <dialog id="dlg-sug-prod" class="modal" style="max-width:780px">
    <form method="dialog" id="form-sug-prod">
      <h2>Cadastrar produtos encontrados na Nota Fiscal?</h2>
      <p class="muted" style="margin-top:0;font-size:13px">
        Os produtos abaixo constam na NF-e e ainda não estão no seu cadastro de produtos. Confira os dados, informe o preço de venda sugerido e confirme para incluí-los automaticamente no cadastro antes de dar entrada na nota.
      </p>
      <div id="sug-prod-erro" class="msg err" style="display:none"></div>
      <div class="tbl-wrap" style="max-height:320px;overflow-y:auto">
        <table>
          <thead>
            <tr>
              <th style="width:4%"></th>
              <th style="width:16%">Código</th>
              <th style="width:36%">Nome do Produto</th>
              <th style="width:10%">Unid.</th>
              <th style="width:16%">Custo NF (R$)</th>
              <th style="width:18%">Preço Venda (R$)</th>
            </tr>
          </thead>
          <tbody id="tbody-sug-prod"></tbody>
        </table>
      </div>
      <div class="row" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn sec" id="btn-sug-ignorar">Não cadastrar agora</button>
        <button type="submit" id="btn-sug-confirmar">✓ Confirmar e incluir no cadastro de produtos</button>
      </div>
    </form>
  </dialog>

  {fornecedores.length === 0 && (
    <div class="msg err" id="aviso-sem-fornecedores">
      Você ainda não possui fornecedores ativos cadastrados. Use o botão <strong>⚡ Cadastro automático</strong> para importar e cadastrar o fornecedor direto da NF-e ou <a href="/clientes/novo">cadastre manualmente</a>.
    </div>
  )}
  {produtos.length === 0 && (
    <div class="msg err" id="aviso-sem-produtos">
      Você ainda não possui produtos ativos cadastrados. Use o botão <strong>⚡ Cadastro automático</strong> para importar e cadastrar os produtos direto da NF-e ou <a href="/produtos/novo">cadastre manualmente</a>.
    </div>
  )}

  <form method="post" id="form-nf">
    <div class="card">
      <h2>Dados da Nota Fiscal</h2>
      <div class="grid">
        <div class="c6">
          <label>Fornecedor *</label>
          <select name="fornecedor_id" required>
            <option value="">— Selecione o fornecedor —</option>
            {fornecedores.map((fn) => (
              <option value={fn.id} selected={cab.fornecedor_id === fn.id}>
                {fn.nome}{fn.documento ? ` (${formatDoc(fn.documento)})` : ''}
              </option>
            ))}
          </select>
        </div>
        <div class="c2">
          <label>Número da NF *</label>
          <input name="numero" value={cab.numero} required placeholder="000123" />
        </div>
        <div class="c2">
          <label>Série</label>
          <input name="serie" value={cab.serie} placeholder="1" />
        </div>
        <div class="c2">
          <label>Data de emissão *</label>
          <input name="data_emissao" type="date" value={cab.data_emissao} required />
        </div>

        <div class="c3">
          <label>Data de entrada *</label>
          <input name="data_entrada" type="date" value={cab.data_entrada} required />
        </div>
        <div class="c9" style="grid-column:span 9">
          <label>Chave de acesso NF-e (44 dígitos, opcional)</label>
          <input name="chave_acesso" value={cab.chave_acesso} inputmode="numeric" maxlength="54" placeholder="Somente números" />
        </div>
      </div>
    </div>

    <div class="card">
      <div class="row" style="margin-bottom:8px">
        <h2 style="margin:0">Produtos da Nota Fiscal</h2>
        <span class="spacer"></span>
        <span class="muted" style="font-size:13px">Os produtos precisam estar previamente cadastrados</span>
        <button type="button" class="btn sec" id="btn-add-item" style="font-size:13px;padding:5px 10px">+ Adicionar produto</button>
      </div>

      <div class="tbl-wrap">
        <table id="tbl-itens">
          <thead>
            <tr>
              <th style="width:36%">Produto cadastrado *</th>
              <th style="width:14%">Quantidade *</th>
              <th style="width:16%">Custo unit. NF (R$) *</th>
              <th style="width:14%">Subtotal (R$)</th>
              <th style="width:16%">Preço venda (R$)</th>
              <th style="width:4%"></th>
            </tr>
          </thead>
          <tbody id="tbody-itens">
            {rowsToRender.map((it) => (
              <tr class="item-row">
                <td>
                  <select name="produto_id" class="sel-prod" required>
                    <option value="">— Selecione um produto —</option>
                    {produtos.map((pr) => (
                      <option
                        value={pr.id}
                        data-un={pr.unidade}
                        data-custo={pr.preco_custo}
                        data-venda={pr.preco_venda}
                        data-est={pr.estoque_atual}
                        selected={it.produto_id === pr.id}
                      >
                        {pr.codigo ? `[${pr.codigo}] ` : ''}{pr.nome} ({pr.unidade} · est: {formatQty(pr.estoque_atual)})
                      </option>
                    ))}
                  </select>
                </td>
                <td>
                  <input name="quantidade" class="inp-qtd" type="number" step="0.001" min="0.001" value={it.quantidade} required />
                </td>
                <td>
                  <input name="valor_unitario" class="inp-unit" type="number" step="0.01" min="0" value={it.valor_unitario} required />
                </td>
                <td>
                  <input class="inp-sub" readonly tabindex="-1" style="background:#f9fafb;font-weight:600" value="0,00" />
                </td>
                <td>
                  <input
                    name="novo_preco_venda"
                    class="inp-venda"
                    type="number"
                    step="0.01"
                    min="0"
                    value={it.novo_preco_venda ?? ''}
                    placeholder="Manter atual"
                    title="Se preenchido, atualiza o preço de venda do produto no cadastro"
                  />
                </td>
                <td>
                  <button type="button" class="btn sec btn-rm-item" style="padding:4px 8px" title="Remover item">✕</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>Totais e Observações</h2>
      <div class="grid">
        <div class="c3">
          <label>Total dos produtos (R$)</label>
          <input id="tot-produtos" readonly tabindex="-1" style="background:#f9fafb;font-weight:600" />
        </div>
        <div class="c2">
          <label>Frete (R$)</label>
          <input name="valor_frete" id="inp-frete" type="number" step="0.01" min="0" value={cab.valor_frete} />
        </div>
        <div class="c2">
          <label>Outras desp. (R$)</label>
          <input name="valor_outros" id="inp-outros" type="number" step="0.01" min="0" value={cab.valor_outros} />
        </div>
        <div class="c2">
          <label>Desconto (R$)</label>
          <input name="valor_desconto" id="inp-desc" type="number" step="0.01" min="0" value={cab.valor_desconto} />
        </div>
        <div class="c3">
          <label>Valor total da NF (R$)</label>
          <input id="tot-nf" readonly tabindex="-1" style="background:#eef2ff;font-weight:700;color:#1e3a8a" />
        </div>
        <div class="c12">
          <label>Observações</label>
          <textarea name="observacoes" rows="2">{cab.observacoes}</textarea>
        </div>
      </div>
    </div>

    <div class="row">
      <button id="btn-submit-nf">Confirmar entrada e alimentar estoque</button>
      <a class="btn sec" href="/notas-entrada">Cancelar</a>
    </div>
  </form>
</Layout>

<script is:inline>
  const tbody = document.getElementById('tbody-itens');
  const btnAdd = document.getElementById('btn-add-item');
  const inpFrete = document.getElementById('inp-frete');
  const inpOutros = document.getElementById('inp-outros');
  const inpDesc = document.getElementById('inp-desc');
  const totProd = document.getElementById('tot-produtos');
  const totNf = document.getElementById('tot-nf');

  const fmt = (n) => Number(n || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  function recalc() {
    let somaProd = 0;
    tbody.querySelectorAll('tr.item-row').forEach((tr) => {
      const q = parseFloat(tr.querySelector('.inp-qtd').value) || 0;
      const u = parseFloat(tr.querySelector('.inp-unit').value) || 0;
      const sub = q * u;
      somaProd += sub;
      tr.querySelector('.inp-sub').value = fmt(sub);
    });
    const frete = parseFloat(inpFrete.value) || 0;
    const outros = parseFloat(inpOutros.value) || 0;
    const desc = parseFloat(inpDesc.value) || 0;
    const total = Math.max(0, somaProd + frete + outros - desc);
    totProd.value = fmt(somaProd);
    totNf.value = fmt(total);
  }

  // Ao escolher um produto, sugere o último preço de custo e o preço de venda atual
  tbody.addEventListener('change', (e) => {
    if (!e.target.classList.contains('sel-prod')) return;
    const tr = e.target.closest('tr.item-row');
    const opt = e.target.selectedOptions[0];
    if (opt && opt.value) {
      const unitInput = tr.querySelector('.inp-unit');
      const vendaInput = tr.querySelector('.inp-venda');
      if (!parseFloat(unitInput.value)) unitInput.value = opt.dataset.custo || 0;
      if (!vendaInput.value && opt.dataset.venda) vendaInput.value = opt.dataset.venda;
    }
    recalc();
  });

  tbody.addEventListener('input', recalc);
  [inpFrete, inpOutros, inpDesc].forEach((el) => el.addEventListener('input', recalc));

  btnAdd.addEventListener('click', () => {
    const first = tbody.querySelector('tr.item-row');
    const clone = first.cloneNode(true);
    clone.querySelector('.sel-prod').value = '';
    clone.querySelector('.inp-qtd').value = '1';
    clone.querySelector('.inp-unit').value = '0';
    clone.querySelector('.inp-sub').value = '0,00';
    clone.querySelector('.inp-venda').value = '';
    tbody.appendChild(clone);
    recalc();
  });

  tbody.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-rm-item');
    if (!btn) return;
    const rows = tbody.querySelectorAll('tr.item-row');
    const tr = btn.closest('tr.item-row');
    if (rows.length === 1) {
      tr.querySelector('.sel-prod').value = '';
      tr.querySelector('.inp-qtd').value = '1';
      tr.querySelector('.inp-unit').value = '0';
      tr.querySelector('.inp-venda').value = '';
    } else {
      tr.remove();
    }
    recalc();
  });

  recalc();

  // Cadastro automático de NF-e (via chave de 44 dígitos ou XML da NF-e)
  const dlgNf = document.getElementById('dlg-auto-nf');
  const btnAutoNf = document.getElementById('btn-auto-nf');
  const btnFecharNf = document.getElementById('btn-auto-nf-fechar');
  const btnBuscarNf = document.getElementById('btn-auto-nf-buscar');
  const formAutoNf = document.getElementById('form-auto-nf');
  const inpChave = document.getElementById('inp-auto-chave');
  const inpXml = document.getElementById('inp-auto-xml');
  const boxErroNf = document.getElementById('nf-auto-erro');
  const boxAvisoNf = document.getElementById('nf-auto-aviso');
  const formNf = document.getElementById('form-nf');

  function abrirDialogoNf() {
    boxErroNf.style.display = 'none';
    boxErroNf.textContent = '';
    const chaveAtual = formNf.querySelector('[name="chave_acesso"]')?.value || '';
    if (chaveAtual && !inpChave.value) inpChave.value = chaveAtual;
    dlgNf.showModal();
    setTimeout(() => inpChave.focus(), 50);
  }

  btnAutoNf.addEventListener('click', abrirDialogoNf);
  btnFecharNf.addEventListener('click', () => dlgNf.close());
  dlgNf.addEventListener('click', (e) => {
    if (e.target === dlgNf) dlgNf.close();
  });

  if (new URLSearchParams(location.search).get('auto') === '1') {
    abrirDialogoNf();
  }

  function preencherLinhaItem(tr, it) {
    const sel = tr.querySelector('.sel-prod');
    sel.value = it.produto_id ? String(it.produto_id) : '';
    tr.querySelector('.inp-qtd').value = it.quantidade || 1;
    tr.querySelector('.inp-unit').value = it.valor_unitario ?? 0;
    const vendaEl = tr.querySelector('.inp-venda');
    vendaEl.value = it.preco_venda_atual ?? '';
    let hint = tr.querySelector('.nfe-item-hint');
    if (it.nome && !it.produto_id) {
      if (!hint) {
        hint = document.createElement('div');
        hint.className = 'nfe-item-hint muted';
        hint.style.fontSize = '12px';
        hint.style.color = 'var(--dg)';
        sel.parentElement.appendChild(hint);
      }
      hint.textContent = `Item na NF-e: [${it.codigo || 's/cód'}] ${it.nome} — selecione o produto cadastrado`;
    } else if (hint) {
      hint.remove();
    }
  }

  formAutoNf.addEventListener('submit', async (e) => {
    e.preventDefault();
    boxErroNf.style.display = 'none';

    const chave = (inpChave.value || '').replace(/\D/g, '');
    const file = inpXml.files && inpXml.files[0];

    if (!chave && !file) {
      boxErroNf.textContent = 'Informe a chave de acesso da NF-e (44 dígitos) ou selecione o arquivo XML.';
      boxErroNf.style.display = 'block';
      return;
    }

    btnBuscarNf.disabled = true;
    const txtOrig = btnBuscarNf.textContent;
    btnBuscarNf.textContent = 'Buscando NF-e...';

    try {
      const xmlText = file ? await file.text() : '';
      const res = await fetch('/api/consulta-nfe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chave, xml: xmlText }),
      });
      const data = await res.json();
      if (!res.ok || data.erro) {
        boxErroNf.textContent = data.erro || 'Não foi possível carregar os dados da NF-e.';
        boxErroNf.style.display = 'block';
        return;
      }

      const nf = data.nota || {};
      if (nf.fornecedor_id) formNf.querySelector('[name="fornecedor_id"]').value = String(nf.fornecedor_id);
      if (nf.numero) formNf.querySelector('[name="numero"]').value = nf.numero;
      if (nf.serie !== undefined) formNf.querySelector('[name="serie"]').value = nf.serie;
      if (nf.data_emissao) formNf.querySelector('[name="data_emissao"]').value = nf.data_emissao;
      if (nf.chave_acesso) formNf.querySelector('[name="chave_acesso"]').value = nf.chave_acesso;
      if (nf.valor_frete !== undefined) inpFrete.value = nf.valor_frete;
      if (nf.valor_desconto !== undefined) inpDesc.value = nf.valor_desconto;
      if (nf.valor_outros !== undefined) inpOutros.value = nf.valor_outros;
      if (nf.observacoes) formNf.querySelector('[name="observacoes"]').value = nf.observacoes;

      if (Array.isArray(nf.itens) && nf.itens.length > 0) {
        const template = tbody.querySelector('tr.item-row').cloneNode(true);
        tbody.innerHTML = '';
        nf.itens.forEach((it) => {
          const row = template.cloneNode(true);
          preencherLinhaItem(row, it);
          tbody.appendChild(row);
        });
      }

      recalc();
      dlgNf.close();

      // Itens da NF-e que ainda não estão cadastrados como produtos
      const itensNovos = (nf.itens || [])
        .map((it, idx) => ({ ...it, idx }))
        .filter((it) => !it.produto_id && it.nome);

      // Se o fornecedor emitente da NF-e ainda não está cadastrado, sugere primeiro o cadastro do fornecedor
      // e, logo em seguida, sugere o cadastro dos produtos contidos na nota
      if (!nf.fornecedor_id && (nf.emitente_cnpj || (nf.emitente && nf.emitente.nome))) {
        abrirSugestaoFornecedor(nf.emitente || { documento: nf.emitente_cnpj, nome: nf.emitente_nome }, itensNovos, data.aviso);
      } else if (itensNovos.length > 0) {
        abrirSugestaoProdutos(itensNovos, nf.fornecedor_id || Number(formNf.querySelector('[name="fornecedor_id"]').value) || 0);
      } else if (data.aviso) {
        boxAvisoNf.textContent = data.aviso;
        boxAvisoNf.style.display = 'block';
      }
    } catch {
      boxErroNf.textContent = 'Falha ao consultar os dados da NF-e.';
      boxErroNf.style.display = 'block';
    } finally {
      btnBuscarNf.disabled = false;
      btnBuscarNf.textContent = txtOrig;
    }
  });

  // Diálogo de sugestão e confirmação de cadastro do FORNECEDOR emitente da NF-e
  const dlgSugForn = document.getElementById('dlg-sug-forn');
  const formSugForn = document.getElementById('form-sug-forn');
  const btnIgnorarForn = document.getElementById('btn-forn-ignorar');
  const btnConfirmarForn = document.getElementById('btn-forn-confirmar');
  const boxErroForn = document.getElementById('sug-forn-erro');
  let filaItensNovosPosForn = [];
  let avisoPosForn = '';

  function abrirSugestaoFornecedor(emit, itensNovos, aviso) {
    filaItensNovosPosForn = itensNovos || [];
    avisoPosForn = aviso || '';
    boxErroForn.style.display = 'none';

    document.getElementById('sf-doc').value = emit.documento || '';
    document.getElementById('sf-ie').value = emit.rg_ie || '';
    document.getElementById('sf-fone').value = emit.telefone || '';
    document.getElementById('sf-nome').value = emit.nome || '';
    document.getElementById('sf-fantasia').value = emit.nome_fantasia || '';
    document.getElementById('sf-cep').value = emit.cep || '';
    document.getElementById('sf-logr').value = emit.logradouro || '';
    document.getElementById('sf-num').value = emit.numero || '';
    document.getElementById('sf-bairro').value = emit.bairro || '';
    document.getElementById('sf-cid').value = emit.cidade || '';
    document.getElementById('sf-uf').value = emit.uf || '';

    dlgSugForn.showModal();
  }

  function prosseguirParaProdutosSeHouver(fornId) {
    if (filaItensNovosPosForn.length > 0) {
      abrirSugestaoProdutos(filaItensNovosPosForn, fornId);
      filaItensNovosPosForn = [];
    } else if (avisoPosForn) {
      boxAvisoNf.textContent = avisoPosForn;
      boxAvisoNf.style.display = 'block';
    }
  }

  btnIgnorarForn?.addEventListener('click', () => {
    dlgSugForn.close();
    prosseguirParaProdutosSeHouver(Number(formNf.querySelector('[name="fornecedor_id"]').value) || 0);
  });

  formSugForn?.addEventListener('submit', async (e) => {
    e.preventDefault();
    boxErroForn.style.display = 'none';
    btnConfirmarForn.disabled = true;
    const txtOrig = btnConfirmarForn.textContent;
    btnConfirmarForn.textContent = 'Cadastrando fornecedor...';

    try {
      const payload = {
        documento: document.getElementById('sf-doc').value,
        rg_ie: document.getElementById('sf-ie').value,
        telefone: document.getElementById('sf-fone').value,
        nome: document.getElementById('sf-nome').value,
        nome_fantasia: document.getElementById('sf-fantasia').value,
        cep: document.getElementById('sf-cep').value,
        logradouro: document.getElementById('sf-logr').value,
        numero: document.getElementById('sf-num').value,
        bairro: document.getElementById('sf-bairro').value,
        cidade: document.getElementById('sf-cid').value,
        uf: document.getElementById('sf-uf').value,
      };
      const res = await fetch('/api/cadastrar-fornecedor-nfe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || data.erro) {
        boxErroForn.textContent = data.erro || 'Não foi possível cadastrar o fornecedor.';
        boxErroForn.style.display = 'block';
        return;
      }

      const fn = data.fornecedor;
      const selForn = formNf.querySelector('[name="fornecedor_id"]');
      let opt = selForn.querySelector(`option[value="${fn.id}"]`);
      if (!opt) {
        opt = document.createElement('option');
        opt.value = String(fn.id);
        opt.textContent = fn.label || fn.nome;
        selForn.appendChild(opt);
      }
      selForn.value = String(fn.id);

      const avisoSemForn = document.getElementById('aviso-sem-fornecedores');
      if (avisoSemForn) avisoSemForn.style.display = 'none';

      dlgSugForn.close();
      boxAvisoNf.textContent = `Fornecedor "${fn.nome}" cadastrado e selecionado na nota!`;
      boxAvisoNf.style.display = 'block';

      prosseguirParaProdutosSeHouver(fn.id);
    } catch {
      boxErroForn.textContent = 'Falha de comunicação ao cadastrar o fornecedor.';
      boxErroForn.style.display = 'block';
    } finally {
      btnConfirmarForn.disabled = false;
      btnConfirmarForn.textContent = txtOrig;
    }
  });

  // Diálogo de sugestão e confirmação de cadastro dos produtos contidos na NF-e
  const dlgSug = document.getElementById('dlg-sug-prod');
  const formSug = document.getElementById('form-sug-prod');
  const tbodySug = document.getElementById('tbody-sug-prod');
  const btnIgnorarSug = document.getElementById('btn-sug-ignorar');
  const btnConfirmarSug = document.getElementById('btn-sug-confirmar');
  const boxErroSug = document.getElementById('sug-prod-erro');
  let sugFornecedorId = 0;

  function abrirSugestaoProdutos(itensNovos, fornId) {
    sugFornecedorId = fornId;
    boxErroSug.style.display = 'none';
    tbodySug.innerHTML = '';

    itensNovos.forEach((it) => {
      const custo = Number(it.valor_unitario || 0);
      const tr = document.createElement('tr');
      tr.className = 'sug-row';
      tr.dataset.idx = String(it.idx);
      tr.dataset.ean = it.ean || '';
      tr.dataset.ncm = it.ncm || '';

      tr.innerHTML = `
        <td style="text-align:center"><input type="checkbox" class="sug-chk" checked style="width:auto" /></td>
        <td><input class="sug-cod" value="${(it.codigo || '').replace(/"/g, '&quot;')}" /></td>
        <td><input class="sug-nome" value="${(it.nome || '').replace(/"/g, '&quot;')}" required /></td>
        <td><input class="sug-un" value="${(it.unidade || 'UN').replace(/"/g, '&quot;')}" style="text-transform:uppercase" /></td>
        <td><input class="sug-custo" type="number" step="0.01" min="0" value="${custo}" /></td>
        <td><input class="sug-venda" type="number" step="0.01" min="0" value="${custo}" /></td>
      `;
      tbodySug.appendChild(tr);
    });

    dlgSug.showModal();
  }

  btnIgnorarSug?.addEventListener('click', () => dlgSug.close());

  formSug?.addEventListener('submit', async (e) => {
    e.preventDefault();
    boxErroSug.style.display = 'none';

    const selecionados = [];
    tbodySug.querySelectorAll('tr.sug-row').forEach((tr) => {
      if (!tr.querySelector('.sug-chk').checked) return;
      selecionados.push({
        idx: Number(tr.dataset.idx),
        codigo: tr.querySelector('.sug-cod').value.trim(),
        nome: tr.querySelector('.sug-nome').value.trim(),
        unidade: tr.querySelector('.sug-un').value.trim() || 'UN',
        ean: tr.dataset.ean || '',
        ncm: tr.dataset.ncm || '',
        preco_custo: parseFloat(tr.querySelector('.sug-custo').value) || 0,
        preco_venda: parseFloat(tr.querySelector('.sug-venda').value) || 0,
      });
    });

    if (selecionados.length === 0) {
      dlgSug.close();
      return;
    }

    btnConfirmarSug.disabled = true;
    const txtOrig = btnConfirmarSug.textContent;
    btnConfirmarSug.textContent = 'Cadastrando produtos...';

    try {
      const res = await fetch('/api/cadastrar-produtos-nfe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fornecedor_id: sugFornecedorId || Number(formNf.querySelector('[name="fornecedor_id"]').value) || 0,
          produtos: selecionados,
        }),
      });
      const data = await res.json();
      if (!res.ok || data.erro) {
        boxErroSug.textContent = data.erro || 'Não foi possível cadastrar os produtos.';
        boxErroSug.style.display = 'block';
        return;
      }

      const criados = data.criados || [];
      const allSelects = tbody.querySelectorAll('select.sel-prod');

      // Adiciona os novos produtos nas listas <select> de todas as linhas da nota
      criados.forEach((pr) => {
        allSelects.forEach((sel) => {
          if (!sel.querySelector(`option[value="${pr.id}"]`)) {
            const opt = document.createElement('option');
            opt.value = String(pr.id);
            opt.dataset.un = pr.unidade;
            opt.dataset.custo = String(pr.preco_custo);
            opt.dataset.venda = String(pr.preco_venda);
            opt.dataset.est = '0';
            opt.textContent = `${pr.codigo ? `[${pr.codigo}] ` : ''}${pr.nome} (${pr.unidade} · est: 0)`;
            sel.appendChild(opt);
          }
        });
      });

      // Seleciona automaticamente o produto recém-cadastrado na respectiva linha da NF
      const rowsNf = tbody.querySelectorAll('tr.item-row');
      criados.forEach((pr) => {
        const tr = rowsNf[pr.idx];
        if (!tr) return;
        const sel = tr.querySelector('.sel-prod');
        sel.value = String(pr.id);
        const vendaEl = tr.querySelector('.inp-venda');
        if (vendaEl && pr.preco_venda) vendaEl.value = pr.preco_venda;
        const hint = tr.querySelector('.nfe-item-hint');
        if (hint) hint.remove();
      });

      const avisoSemProd = document.getElementById('aviso-sem-produtos');
      if (avisoSemProd) avisoSemProd.style.display = 'none';

      dlgSug.close();
      boxAvisoNf.textContent = `${criados.length} produto(s) incluído(s) no cadastro e vinculados aos itens da nota! Confira os dados e clique em "Confirmar entrada e alimentar estoque".`;
      boxAvisoNf.style.display = 'block';
    } catch {
      boxErroSug.textContent = 'Falha de comunicação ao cadastrar os produtos.';
      boxErroSug.style.display = 'block';
    } finally {
      btnConfirmarSug.disabled = false;
      btnConfirmarSug.textContent = txtOrig;
    }
  });
</script>
