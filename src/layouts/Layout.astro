---
import '../styles/global.css';
interface Props { title: string; active?: string; bare?: boolean }
const { title, active = '', bare = false } = Astro.props;
const user = Astro.locals.user;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Backoffice</title>
  </head>
  <body>
    {bare ? (
      <main class="auth"><slot /></main>
    ) : (
      <>
        <header class="top">
          <strong class="brand">Backoffice</strong>
          <nav>
            <a href="/" class={active === 'home' ? 'on' : ''}>Início</a>
            <a href="/clientes" class={active === 'clientes' ? 'on' : ''}>Clientes / Fornecedores</a>
            <a href="/produtos" class={active === 'produtos' ? 'on' : ''}>Produtos</a>
            <a href="/ofertas" class={active === 'ofertas' ? 'on' : ''}>Ofertas</a>
            <a href="/pedidos" class={active === 'pedidos' ? 'on' : ''}>Pedidos</a>
            <a href="/notas-entrada" class={active === 'notas' ? 'on' : ''}>Entrada de NF</a>
            <a href="/estoque" class={active === 'estoque' ? 'on' : ''}>Estoque</a>
            <a href="/loja-config" class={active === 'loja-config' ? 'on' : ''}>Minha Loja</a>
            {user?.perfil === 'admin' && <a href="/usuarios" class={active === 'usuarios' ? 'on' : ''}>Usuários</a>}
          </nav>
          <div class="who">
            <span>{user?.empresaNome} · <a href="/conta">{user?.nome}</a></span>
            <form method="post" action="/logout" id="logout-form"><button class="link">Sair</button></form>
          </div>
        </header>
        <main class="page"><slot /></main>
        <script is:inline>
          (function () {
            const IDLE_LIMIT_MS = 5 * 60 * 1000; // 5 minutos
            let timer;
            function dropSession() {
              const form = document.getElementById('logout-form');
              if (form) {
                form.action = '/logout?expirado=1';
                form.submit();
              } else {
                window.location.href = '/logout?expirado=1';
              }
            }
            function resetIdleTimer() {
              clearTimeout(timer);
              timer = setTimeout(dropSession, IDLE_LIMIT_MS);
            }
            ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach((ev) => {
              window.addEventListener(ev, resetIdleTimer, { passive: true });
            });
            resetIdleTimer();
          })();
        </script>
      </>
    )}
  </body>
</html>
