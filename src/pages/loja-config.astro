---
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/auth';
import { enviarEmailTesteConfiguracao } from '../lib/email';
import {
  DIAS_SEMANA_LABELS,
  normalizarHandleInfinitePay,
  validarUrlExternaSegura,
} from '../lib/empresa-service';
import { onlyDigits, str } from '../lib/validate';

const u = Astro.locals.user!;
const validColor = (c: string, def: string) => (/^#[0-9a-fA-F]{6}$/.test(c) ? c : def);

let erro = '';
let ok = false;
let msgEmailTeste = '';
let emailTesteOk = false;

let emp = await db()
  .prepare(
    `SELECT codigo, razao_social, nome_fantasia, cnpj,
            loja_nome, loja_logo, cor_primaria, cor_secundaria, cor_fundo, cor_texto,
            rodape_sobre, rodape_telefone, rodape_whatsapp, rodape_email,
            rodape_horario, rodape_endereco, rodape_suporte, rodape_instagram,
            rodape_facebook, rodape_copyright, rodape_cor_fundo, rodape_cor_texto,
            COALESCE(agenda_ativa, 0) AS agenda_ativa,
            COALESCE(NULLIF(agenda_menu_texto, ''), 'Agenda') AS agenda_menu_texto,
            COALESCE(agenda_inicio, '08:00') AS agenda_inicio,
            COALESCE(agenda_fim, '18:00') AS agenda_fim,
            COALESCE(agenda_intervalo_min, 30) AS agenda_intervalo_min,
            COALESCE(agenda_dias_semana, '1,2,3,4,5') AS agenda_dias_semana,
            agenda_datas_fechadas,
            COALESCE(NULLIF(cep_origem, ''), '01001000') AS cep_origem,
            COALESCE(mostrar_frete_vitrine, 1) AS mostrar_frete_vitrine,
            COALESCE(NULLIF(frete_provedor, ''), 'CORREIOS') AS frete_provedor,
            COALESCE(NULLIF(cepcerto_public_key, ''), 'pk_live_98e56b325596efba0c511533a46f05a3ceae960d091bc459') AS cepcerto_public_key,
            COALESCE(tempo_sessao_minutos, 10) AS tempo_sessao_minutos,
            COALESCE(nubank_pix_ativo, 1) AS nubank_pix_ativo,
            COALESCE(nubank_link_ativo, 1) AS nubank_link_ativo,
            nubank_chave_pix,
            COALESCE(NULLIF(nubank_cidade_pix, ''), 'SAO PAULO') AS nubank_cidade_pix,
            nubank_link_padrao,
            nupay_merchant_key,
            nupay_merchant_token,
            COALESCE(infinitepay_ativo, 0) AS infinitepay_ativo,
            infinitepay_handle,
            infinitepay_api_key,
            COALESCE(email_notificacoes_ativo, 1) AS email_notificacoes_ativo,
            resend_api_key,
            COALESCE(NULLIF(email_remetente, ''), 'onboarding@resend.dev') AS email_remetente,
            email_webhook_url
       FROM empresas WHERE id = ?`,
  )
  .bind(u.empresaId)
  .first<any>();

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const lojaNome = str(f, 'loja_nome', 120);
  const corPrimaria = validColor(str(f, 'cor_primaria', 10), '#2563eb');
  const corSecundaria = validColor(str(f, 'cor_secundaria', 10), '#111827');
  const corFundo = validColor(str(f, 'cor_fundo', 10), '#f4f6f9');
  const corTexto = validColor(str(f, 'cor_texto', 10), '#1c2430');
  let lojaLogo = str(f, 'loja_logo', 300_000); // aceita URL ou Data-URL (base64)
  if (f.get('remover_logo')) lojaLogo = '';

  const rodapeSobre = str(f, 'rodape_sobre', 600);
  const rodapeTelefone = str(f, 'rodape_telefone', 60);
  const rodapeWhatsapp = str(f, 'rodape_whatsapp', 60);
  const rodapeEmail = str(f, 'rodape_email', 120);
  const rodapeHorario = str(f, 'rodape_horario', 120);
  const rodapeEndereco = str(f, 'rodape_endereco', 400);
  const rodapeSuporte = str(f, 'rodape_suporte', 600);
  const rodapeInstagram = str(f, 'rodape_instagram', 160);
  const rodapeFacebook = str(f, 'rodape_facebook', 160);
  const rodapeCopyright = str(f, 'rodape_copyright', 240);
  const rodapeCorFundo = validColor(str(f, 'rodape_cor_fundo', 10), '#ffffff');
  const rodapeCorTexto = validColor(str(f, 'rodape_cor_texto', 10), '#333333');
  const agendaAtiva = f.get('agenda_ativa') ? 1 : 0;
  const agendaMenuTexto = str(f, 'agenda_menu_texto', 60) || 'Agenda';
  const agendaInicio = /^\d{2}:\d{2}$/.test(str(f, 'agenda_inicio', 10)) ? str(f, 'agenda_inicio', 10) : '08:00';
  const agendaFim = /^\d{2}:\d{2}$/.test(str(f, 'agenda_fim', 10)) ? str(f, 'agenda_fim', 10) : '18:00';
  const agendaIntervaloMin = Math.max(10, Math.min(120, Number(f.get('agenda_intervalo_min')) || 30));
  const diasMarcados = f
    .getAll('agenda_dias_semana')
    .map((v) => String(v).trim())
    .filter((v) => /^[0-6]$/.test(v));
  const agendaDiasSemana = diasMarcados.join(',');
  const agendaDatasFechadas = str(f, 'agenda_datas_fechadas', 1000);
  const cepOrigem = onlyDigits(str(f, 'cep_origem', 12)) || '01001000';
  const freteProvedor = f.get('frete_provedor') === 'CEPCERTO' ? 'CEPCERTO' : 'CORREIOS';
  const cepcertoPublicKey =
    str(f, 'cepcerto_public_key', 160) || 'pk_live_98e56b325596efba0c511533a46f05a3ceae960d091bc459';
  const tempoSessaoMinutos = Math.max(1, Math.min(1440, Math.round(Number(f.get('tempo_sessao_minutos')) || 10)));
  // Se o CEP Certo estiver habilitado, desabilita automaticamente o frete na apresentação do produto na vitrine
  const mostrarFreteVitrine = freteProvedor === 'CEPCERTO' ? 0 : f.get('mostrar_frete_vitrine') ? 1 : 0;
  const nubankPixAtivo = f.get('nubank_pix_ativo') ? 1 : 0;
  const nubankLinkAtivo = f.get('nubank_link_ativo') ? 1 : 0;
  const nubankChavePix = str(f, 'nubank_chave_pix', 140);
  const nubankCidadePix = str(f, 'nubank_cidade_pix', 30) || 'SAO PAULO';
  const nubankLinkPadrao = str(f, 'nubank_link_padrao', 400);
  const nupayMerchantKey = str(f, 'nupay_merchant_key', 160);
  const nupayMerchantToken = str(f, 'nupay_merchant_token', 240);
  const infinitepayAtivo = f.get('infinitepay_ativo') ? 1 : 0;
  const infinitepayHandle = normalizarHandleInfinitePay(str(f, 'infinitepay_handle', 80));
  const infinitepayApiKey = str(f, 'infinitepay_api_key', 240);
  const emailNotificacoesAtivo = f.get('email_notificacoes_ativo') ? 1 : 0;
  const resendApiKey = str(f, 'resend_api_key', 240);
  const emailRemetente = str(f, 'email_remetente', 140) || 'onboarding@resend.dev';
  const emailWebhookUrl = str(f, 'email_webhook_url', 400);

  if (
    lojaLogo &&
    !/^(https:\/\/|data:image\/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$)/i.test(lojaLogo)
  ) {
    erro =
      'A logo deve ser uma URL segura (https://...) ou uma imagem PNG/JPG/WebP enviada do seu computador.';
  } else if (!validarUrlExternaSegura(nubankLinkPadrao)) {
    erro = 'O Link de Cobrança Nubank padrão deve ser uma URL https:// externa válida.';
  } else if (!validarUrlExternaSegura(emailWebhookUrl)) {
    erro = 'A URL de Webhook de E-mail deve usar protocolo seguro https:// para um domínio público válido.';
  } else {
    await db()
      .prepare(
        `UPDATE empresas
            SET loja_nome = ?, loja_logo = ?, cor_primaria = ?, cor_secundaria = ?, cor_fundo = ?, cor_texto = ?,
                rodape_sobre = ?, rodape_telefone = ?, rodape_whatsapp = ?, rodape_email = ?,
                rodape_horario = ?, rodape_endereco = ?, rodape_suporte = ?, rodape_instagram = ?,
                rodape_facebook = ?, rodape_copyright = ?, rodape_cor_fundo = ?, rodape_cor_texto = ?,
                agenda_ativa = ?, agenda_menu_texto = ?, agenda_inicio = ?, agenda_fim = ?, agenda_intervalo_min = ?,
                agenda_dias_semana = ?, agenda_datas_fechadas = ?, cep_origem = ?, mostrar_frete_vitrine = ?,
                frete_provedor = ?, cepcerto_public_key = ?, tempo_sessao_minutos = ?,
                nubank_pix_ativo = ?, nubank_link_ativo = ?,
                nubank_chave_pix = ?, nubank_cidade_pix = ?, nubank_link_padrao = ?,
                nupay_merchant_key = ?, nupay_merchant_token = ?,
                infinitepay_ativo = ?, infinitepay_handle = ?, infinitepay_api_key = ?,
                email_notificacoes_ativo = ?, resend_api_key = ?, email_remetente = ?, email_webhook_url = ?
          WHERE id = ?`,
      )
      .bind(
        lojaNome || null,
        lojaLogo || null,
        corPrimaria,
        corSecundaria,
        corFundo,
        corTexto,
        rodapeSobre || null,
        rodapeTelefone || null,
        rodapeWhatsapp || null,
        rodapeEmail || null,
        rodapeHorario || null,
        rodapeEndereco || null,
        rodapeSuporte || null,
        rodapeInstagram || null,
        rodapeFacebook || null,
        rodapeCopyright || null,
        rodapeCorFundo,
        rodapeCorTexto,
        agendaAtiva,
        agendaMenuTexto,
        agendaInicio,
        agendaFim,
        agendaIntervaloMin,
        agendaDiasSemana,
        agendaDatasFechadas || null,
        cepOrigem,
        mostrarFreteVitrine,
        freteProvedor,
        cepcertoPublicKey,
        tempoSessaoMinutos,
        nubankPixAtivo,
        nubankLinkAtivo,
        nubankChavePix || null,
        nubankCidadePix,
        nubankLinkPadrao || null,
        nupayMerchantKey || null,
        nupayMerchantToken || null,
        infinitepayAtivo,
        infinitepayHandle || null,
        infinitepayApiKey || null,
        emailNotificacoesAtivo,
        resendApiKey || null,
        emailRemetente,
        emailWebhookUrl || null,
        u.empresaId,
      )
      .run();
    emp = {
      ...emp,
      loja_nome: lojaNome,
      loja_logo: lojaLogo,
      cor_primaria: corPrimaria,
      cor_secundaria: corSecundaria,
      cor_fundo: corFundo,
      cor_texto: corTexto,
      rodape_sobre: rodapeSobre,
      rodape_telefone: rodapeTelefone,
      rodape_whatsapp: rodapeWhatsapp,
      rodape_email: rodapeEmail,
      rodape_horario: rodapeHorario,
      rodape_endereco: rodapeEndereco,
      rodape_suporte: rodapeSuporte,
      rodape_instagram: rodapeInstagram,
      rodape_facebook: rodapeFacebook,
      rodape_copyright: rodapeCopyright,
      rodape_cor_fundo: rodapeCorFundo,
      rodape_cor_texto: rodapeCorTexto,
      agenda_ativa: agendaAtiva,
      agenda_menu_texto: agendaMenuTexto,
      agenda_inicio: agendaInicio,
      agenda_fim: agendaFim,
      agenda_intervalo_min: agendaIntervaloMin,
      agenda_dias_semana: agendaDiasSemana,
      agenda_datas_fechadas: agendaDatasFechadas,
      cep_origem: cepOrigem,
      mostrar_frete_vitrine: mostrarFreteVitrine,
      frete_provedor: freteProvedor,
      cepcerto_public_key: cepcertoPublicKey,
      tempo_sessao_minutos: tempoSessaoMinutos,
      nubank_pix_ativo: nubankPixAtivo,
      nubank_link_ativo: nubankLinkAtivo,
      nubank_chave_pix: nubankChavePix,
      nubank_cidade_pix: nubankCidadePix,
      nubank_link_padrao: nubankLinkPadrao,
      nupay_merchant_key: nupayMerchantKey,
      nupay_merchant_token: nupayMerchantToken,
      infinitepay_ativo: infinitepayAtivo,
      infinitepay_handle: infinitepayHandle,
      infinitepay_api_key: infinitepayApiKey,
      email_notificacoes_ativo: emailNotificacoesAtivo,
      resend_api_key: resendApiKey,
      email_remetente: emailRemetente,
      email_webhook_url: emailWebhookUrl,
    };
    ok = true;

    if (f.get('testar_email_resend') === '1') {
      const destTeste = str(f, 'email_destino_teste', 140) || rodapeEmail;
      const resTeste = await enviarEmailTesteConfiguracao({
        empresaNome: lojaNome || emp.nome_fantasia || emp.razao_social,
        destinatario: destTeste,
        resendApiKey,
        emailRemetente,
        emailWebhookUrl,
      });
      emailTesteOk = resTeste.ok;
      msgEmailTeste = resTeste.mensagem;
    }
  }
}

const urlLoja = `/loja/${emp.codigo}`;
const nomeExibicao = emp.loja_nome || emp.nome_fantasia || emp.razao_social;
---
<Layout title="Personalizar Loja Virtual" active="loja-config">
  <style is:global>
    #form-loja .card.cfg-card {
      padding: 0;
      overflow: hidden;
      transition: box-shadow 0.15s ease;
    }
    #form-loja .card.cfg-card:hover {
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.07);
    }
    #form-loja .cfg-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 15px 18px;
      cursor: pointer;
      user-select: none;
      background: #ffffff;
      transition: background 0.15s ease;
    }
    #form-loja .cfg-head:hover {
      background: #f8fafc;
    }
    #form-loja .cfg-head h2 {
      margin: 0 !important;
      font-size: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    #form-loja .cfg-toggle-hint {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
      background: #f1f5f9;
      padding: 4px 10px;
      border-radius: 999px;
      white-space: nowrap;
      transition: background 0.15s, color 0.15s;
    }
    #form-loja .cfg-card.open .cfg-toggle-hint {
      background: #dbeafe;
      color: #1d4ed8;
    }
    #form-loja .cfg-chevron {
      display: inline-block;
      transition: transform 0.2s ease;
      font-size: 11px;
    }
    #form-loja .cfg-card.open .cfg-chevron {
      transform: rotate(180deg);
    }
    #form-loja .cfg-body {
      display: none;
      padding: 4px 18px 18px;
      border-top: 1px solid #e2e8f0;
      background: #ffffff;
    }
    #form-loja .cfg-card.open .cfg-body {
      display: block;
    }
  </style>

  <div class="row">
    <div>
      <h1 style="margin-bottom:2px">Personalizar Minha Loja Virtual</h1>
      <span class="muted" style="font-size:13px">
        Clique no título de qualquer parâmetro abaixo para expandir ou recolher suas opções.
      </span>
    </div>
    <span class="spacer"></span>
    <button type="button" class="sec sm" id="btn-toggle-all-cfg">📂 Expandir todos</button>
    <a class="btn" href={urlLoja} target="_blank">🛒 Abrir minha loja ({urlLoja}) ↗</a>
  </div>
  {erro && <div class="msg err">{erro}</div>}
  {ok && <div class="msg ok">Personalização da loja salva com sucesso!</div>}
  {msgEmailTeste && <div class={`msg ${emailTesteOk ? 'ok' : 'err'}`}>{msgEmailTeste}</div>}

  <form method="post" id="form-loja">
    <div class="card cfg-card" style="border-left:4px solid #334155">
      <div class="cfg-head" role="button" tabindex="0" aria-expanded="false">
        <h2>🏪 Identidade, Logomarca e Tempo de Queda do Login</h2>
        <span class="cfg-toggle-hint"><span class="cfg-toggle-lbl">Clique para abrir</span> <span class="cfg-chevron">▼</span></span>
      </div>
      <div class="cfg-body">
      <div class="grid" style="margin-top:8px">
        <div class="c6">
          <label>Nome de exibição na loja</label>
          <input name="loja_nome" id="inp-nome" value={emp.loja_nome ?? ''} placeholder={emp.nome_fantasia || emp.razao_social} />
        </div>
        <div class="c6">
          <label>Endereço público da sua loja</label>
          <input readonly value={`${Astro.url.origin}${urlLoja}`} onclick="this.select()" style="background:#f9fafb" />
        </div>

        <div class="c6">
          <label>Enviar imagem da logo (PNG, JPG, SVG ou WebP)</label>
          <input type="file" id="inp-file-logo" accept="image/*" />
        </div>
        <div class="c6">
          <label>Ou informe a URL da logo</label>
          <input name="loja_logo" id="inp-logo" value={emp.loja_logo ?? ''} placeholder="https://..." />
        </div>
        {emp.loja_logo && (
          <div class="c12">
            <label class="check"><input type="checkbox" name="remover_logo" value="1" /> Remover logo atual</label>
          </div>
        )}
        <div class="c4">
          <label>⏱️ Tempo de queda do login por inatividade (minutos)</label>
          <input
            type="number"
            name="tempo_sessao_minutos"
            min="1"
            max="1440"
            step="1"
            value={emp.tempo_sessao_minutos ?? 10}
            required
          />
          <small class="muted" style="display:block;margin-top:4px">
            Tempo sem interação (em minutos) até desconectar automaticamente o login na loja e no backoffice.
          </small>
        </div>
      </div>
      </div>
    </div>

    <div class="card cfg-card" style="border-left:4px solid #0f766e">
      <div class="cfg-head" role="button" tabindex="0" aria-expanded="false">
        <h2 style="color:#0f766e">📅 Agenda de Serviços na Loja Virtual</h2>
        <span class="cfg-toggle-hint"><span class="cfg-toggle-lbl">Clique para abrir</span> <span class="cfg-chevron">▼</span></span>
      </div>
      <div class="cfg-body">
      <div class="grid" style="margin-top:8px">
        <div class="c12">
          <label class="check" style="font-size:15px;font-weight:700;color:#0f172a">
            <input type="checkbox" name="agenda_ativa" value="1" checked={emp.agenda_ativa === 1} />
            Exibir o menu da Agenda na Loja Virtual (permite que clientes agendem serviços online)
          </label>
          <small class="muted" style="display:block;margin-top:4px">
            Quando marcado, o link aparece no topo da sua loja virtual com o texto personalizado abaixo. Você pode cadastrar os procedimentos e tempos de execução em <a href="/servicos"><strong>Serviços</strong></a> e acompanhar as marcações em <a href="/agendamentos"><strong>Agendamentos</strong></a>.
          </small>
        </div>
        <div class="c6">
          <label>Texto que aparecerá no menu da agenda na loja</label>
          <input
            name="agenda_menu_texto"
            value={emp.agenda_menu_texto || 'Agenda'}
            placeholder="Ex: Agende aqui seu serviço"
          />
        </div>
        <div class="c2">
          <label>Início da agenda</label>
          <input type="time" name="agenda_inicio" value={emp.agenda_inicio || '08:00'} />
        </div>
        <div class="c2">
          <label>Fim da agenda</label>
          <input type="time" name="agenda_fim" value={emp.agenda_fim || '18:00'} />
        </div>
        <div class="c2">
          <label>Intervalo da grade</label>
          <select name="agenda_intervalo_min">
            {[15, 20, 30, 45, 60].map((m) => (
              <option value={m} selected={(emp.agenda_intervalo_min || 30) === m}>
                {m} min
              </option>
            ))}
          </select>
        </div>

        <div class="c12">
          <label>Dias da semana com prestação de serviço</label>
          <div style="display:flex;gap:14px;flex-wrap:wrap;padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
            {DIAS_SEMANA_LABELS.map((d) => {
              const ativos = String(emp.agenda_dias_semana ?? '1,2,3,4,5')
                .split(',')
                .map((s: string) => s.trim());
              return (
                <label class="check" style="font-weight:600;color:#1e293b">
                  <input
                    type="checkbox"
                    name="agenda_dias_semana"
                    value={String(d.valor)}
                    checked={ativos.includes(String(d.valor))}
                  />
                  {d.longo}
                </label>
              );
            })}
          </div>
          <small class="muted" style="display:block;margin-top:4px">
            Desmarque os dias da semana em que não há atendimento (ex.: Domingo, Sábado).
          </small>
        </div>

        <div class="c12">
          <label>Datas específicas sem expediente / feriados / folgas (opcional)</label>
          <div class="row" style="gap:8px;margin-bottom:6px">
            <input type="date" id="inp-add-data-fechada" style="max-width:200px" />
            <button
              type="button"
              class="sec sm"
              onclick="const d=document.getElementById('inp-add-data-fechada').value;const t=document.getElementById('inp-datas-fechadas');if(d&&!t.value.includes(d)){t.value=(t.value?t.value+', ':'')+d;}"
            >
              + Adicionar data sem expediente
            </button>
          </div>
          <input
            name="agenda_datas_fechadas"
            id="inp-datas-fechadas"
            value={emp.agenda_datas_fechadas ?? ''}
            placeholder="Ex: 2026-12-25, 2027-01-01 (datas no formato AAAA-MM-DD separadas por vírgula)"
          />
          <small class="muted" style="display:block;margin-top:4px">
            Nessas datas a agenda mostrará aos clientes que não haverá prestação de serviço.
          </small>
        </div>
      </div>
      </div>
    </div>

    <div class="card cfg-card" style="border-left:4px solid #0284c7">
      <div class="cfg-head" role="button" tabindex="0" aria-expanded="false">
        <h2 style="color:#0369a1">🚚 Cálculo de Frete na Loja (Correios ou CEP Certo Multi-Fornecedor)</h2>
        <span class="cfg-toggle-hint"><span class="cfg-toggle-lbl">Clique para abrir</span> <span class="cfg-chevron">▼</span></span>
      </div>
      <div class="cfg-body">
      <p class="muted" style="margin-top:8px;font-size:13px">
