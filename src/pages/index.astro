---
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/auth';
import {
  formatarDuracaoHumana,
  iconeCategoriaLoja,
  obterMetricasDashboardLoja,
} from '../lib/empresa-service';
import { formatMoney, formatQty } from '../lib/validate';

const u = Astro.locals.user!;

const [c, pr, ped, dash] = await Promise.all([
  db()
    .prepare(
      `SELECT COUNT(*) total, COALESCE(SUM(eh_cliente),0) clientes, COALESCE(SUM(eh_fornecedor),0) fornecedores
         FROM parceiros WHERE empresa_id = ? AND ativo = 1`,
    )
    .bind(u.empresaId)
    .first<{ total: number; clientes: number; fornecedores: number }>(),
  db()
    .prepare(
      `SELECT COUNT(*) total, COALESCE(SUM(CASE WHEN estoque_minimo > 0 AND estoque_atual <= estoque_minimo THEN 1 ELSE 0 END),0) baixo
         FROM produtos WHERE empresa_id = ? AND ativo = 1`,
    )
    .bind(u.empresaId)
    .first<{ total: number; baixo: number }>(),
  db()
    .prepare(
      "SELECT COUNT(*) total, COALESCE(SUM(CASE WHEN status = 'novo' THEN 1 ELSE 0 END),0) novos FROM loja_pedidos WHERE empresa_id = ? AND status <> 'cancelado'",
    )
    .bind(u.empresaId)
    .first<{ total: number; novos: number }>(),
  obterMetricasDashboardLoja(db(), u.empresaId),
]);

const sp = Astro.url.searchParams;
const erro = sp.get('erro') === 'permissao';
const buscaProd = (sp.get('q') ?? '').trim().toLowerCase();
const catFiltro = (sp.get('cat') ?? '').trim();
const ordem = sp.get('ordem') ?? 'vendas';

let listaProdutos = [...dash.produtos];
if (buscaProd) {
  listaProdutos = listaProdutos.filter(
    (p: any) =>
      String(p.nome || '').toLowerCase().includes(buscaProd) ||
      String(p.codigo || '').toLowerCase().includes(buscaProd) ||
      String(p.categoria || '').toLowerCase().includes(buscaProd),
  );
}
if (catFiltro) {
  listaProdutos = listaProdutos.filter(
    (p: any) => String(p.categoria || 'Geral').toLowerCase() === catFiltro.toLowerCase(),
  );
}

if (ordem === 'visualizacoes') {
  listaProdutos.sort(
    (a: any, b: any) =>
      Number(b.visualizacoes) - Number(a.visualizacoes) ||
      Number(b.insercoes_carrinho) - Number(a.insercoes_carrinho) ||
      String(a.nome).localeCompare(String(b.nome)),
  );
} else if (ordem === 'carrinho') {
  listaProdutos.sort(
    (a: any, b: any) =>
      Number(b.insercoes_carrinho) - Number(a.insercoes_carrinho) ||
      Number(b.visualizacoes) - Number(a.visualizacoes) ||
      String(a.nome).localeCompare(String(b.nome)),
  );
} else if (ordem === 'nome') {
  listaProdutos.sort((a: any, b: any) => String(a.nome).localeCompare(String(b.nome)));
} else {
  // 'vendas' (padrão)
  listaProdutos.sort(
    (a: any, b: any) =>
      Number(b.vendas_quantidade) - Number(a.vendas_quantidade) ||
      Number(b.insercoes_carrinho) - Number(a.insercoes_carrinho) ||
      Number(b.visualizacoes) - Number(a.visualizacoes) ||
      String(a.nome).localeCompare(String(b.nome)),
  );
}

const maxCatConsultas = Math.max(
  1,
  ...dash.categoriasMaisConsultadas.map((cat) => Number(cat.totalConsultas || 0)),
);
const maxPaisAcessos = Math.max(
  1,
  ...(dash.origensPaises || []).map((p: any) => Number(p.acessos || 0)),
);
const maxCidadeAcessos = Math.max(
  1,
  ...(dash.origensCidadesPaises || []).map((c: any) => Number(c.acessos || 0)),
);
---
<Layout title="Dashboard & Início" active="home">
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    crossorigin=""
  />
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    crossorigin=""
  ></script>
  <style>
    .kpi-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 4px;
      position: relative;
      overflow: hidden;
    }
    .kpi-label {
      font-size: 12.5px;
      font-weight: 700;
      color: #475569;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .kpi-val {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.15;
      margin: 2px 0;
    }
    .kpi-sub {
      font-size: 11.5px;
      color: #64748b;
    }
    .cat-rank-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      background: #f8fafc;
      margin-bottom: 8px;
    }
    .cat-rank-ico {
      font-size: 22px;
      line-height: 1;
      width: 32px;
      text-align: center;
      flex-shrink: 0;
    }
    .cat-rank-bar-bg {
      height: 8px;
      background: #e2e8f0;
      border-radius: 99px;
      overflow: hidden;
      margin-top: 5px;
    }
    .cat-rank-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #2563eb, #0ea5e9);
      border-radius: 99px;
    }
    .metric-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }
    .geo-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      background: #f8fafc;
      margin-bottom: 8px;
      transition: border-color 0.15s, background 0.15s;
    }
    .geo-row:hover {
      border-color: #93c5fd;
      background: #eff6ff;
    }
    .geo-flag {
      font-size: 22px;
      line-height: 1;
      width: 28px;
      text-align: center;
      flex-shrink: 0;
    }
    .geo-map-box {
      display: none;
      margin-top: 12px;
      border: 1.5px solid #cbd5e1;
      border-radius: 12px;
      overflow: hidden;
      background: #0f172a;
    }
    .geo-map-box.open {
      display: block;
    }
    #mapa-origem-leaflet {
      width: 100%;
      height: 390px;
      background: #e2e8f0;
    }
  </style>

  <div class="row" style="margin-bottom:14px">
    <div>
      <h1 style="margin-bottom:2px">📊 Dashboard da Loja — Olá, {u.nome}</h1>
      <span class="muted" style="font-size:13px">
        Acompanhe visualizações de produtos, inserções no carrinho, vendas efetivadas, categorias mais consultadas e tempo médio de permanência e retorno.
      </span>
    </div>
    <span class="spacer"></span>
    <a class="btn sec" href={`/loja/${u.empresaCodigo}`} target="_blank">🛒 Abrir minha Loja Virtual ↗</a>
    <a class="btn sec" href="/loja-config">🎨 Personalizar Loja</a>
  </div>

  {erro && <div class="msg err">Você não tem permissão para acessar essa área.</div>}

  <!-- Linha 1: Indicadores de Comportamento, Permanência, Retorno e Funil da Loja -->
  <div class="grid">
    <div class="card c4 kpi-card" style="border-left:4px solid #0284c7">
      <div class="kpi-label">⏱️ Média de Permanência no Site</div>
      <div class="kpi-val" style="color:#0369a1">
        {dash.resumo.mediaPermanenciaSegundos > 0
          ? formatarDuracaoHumana(dash.resumo.mediaPermanenciaSegundos)
          : 'Aguardando visitas'}
      </div>
      <div class="kpi-sub">
        Métrica geral anônima (sem individualizar por cliente) ·{' '}
        <strong>{dash.resumo.totalVisitas}</strong> sessão(ões) registrada(s)
      </div>
    </div>

    <div class="card c4 kpi-card" style="border-left:4px solid #7c3aed">
      <div class="kpi-label">🔄 Média de Intervalo de Retorno no Site</div>
      <div class="kpi-val" style="color:#6d28d9">
        {dash.resumo.mediaIntervaloRetornoSegundos > 0
          ? formatarDuracaoHumana(dash.resumo.mediaIntervaloRetornoSegundos)
          : 'Aguardando retornos'}
      </div>
      <div class="kpi-sub">
        Tempo médio entre uma visita e o retorno à loja ·{' '}
        <strong>{dash.resumo.totalRetornos}</strong> retorno(s) contabilizado(s)
      </div>
    </div>

    <div class="card c4 kpi-card" style="border-left:4px solid #059669">
      <div class="kpi-label">✅ Vendas Efetivadas na Loja</div>
      <div class="kpi-val" style="color:#047857">
        {formatQty(dash.resumo.totalUnidadesVendidas)} un. · {formatMoney(dash.resumo.totalValorVendido)}
      </div>
      <div class="kpi-sub">
        Em <a href="/pedidos"><strong>{ped?.total ?? 0} pedido(s) ativo(s)</strong></a> (
        <a href="/pedidos?status=novo">{ped?.novos ?? 0} novo(s)</a>)
      </div>
    </div>

    <div class="card c4 kpi-card" style="border-left:4px solid #2563eb">
      <div class="kpi-label">👁️ Visualizações de Produtos</div>
      <div class="kpi-val" style="color:#1d4ed8">{dash.resumo.totalVisualizacoes}</div>
      <div class="kpi-sub">Total de aberturas de produtos na vitrine</div>
    </div>

    <div class="card c4 kpi-card">
      <div class="kpi-label">👥 Clientes e Fornecedores</div>
      <div class="kpi-val">{c?.clientes ?? 0} <span style="font-size:14px;font-weight:500;color:#64748b">clientes</span></div>
      <div class="kpi-sub">
        {c?.fornecedores ?? 0} fornecedor(es) · <a href="/clientes/novo">+ Cadastrar</a>
      </div>
    </div>

    <div class="card c4 kpi-card">
      <div class="kpi-label">📦 Produtos Ativos</div>
      <div class="kpi-val">{pr?.total ?? 0}</div>
      <div class="kpi-sub">
        {Number(pr?.baixo || 0) > 0 ? (
          <a href="/estoque" style="color:#dc2626;font-weight:700">⚠️ {pr?.baixo} com estoque baixo</a>
        ) : (
          <span>Estoque regular · <a href="/produtos/novo">+ Novo produto</a></span>
        )}
      </div>
    </div>
  </div>

  <!-- Linha 1.5: Origem Geográfica dos Acessos (Item para Países + Item para Cidades/Países + Opção Mostrar no Mapa) -->
  <div class="card" style="border-left:4px solid #0ea5e9">
    <div class="row" style="margin-bottom:12px;flex-wrap:wrap;gap:10px">
      <div>
        <h2 style="margin:0;color:#0369a1">🌍 Origem dos Acessos na Loja (Países e Cidades/Países)</h2>
        <small class="muted">
          Distribuição geográfica das visitas por <strong>Países</strong> e por <strong>Cidades / Países</strong> ({dash.resumo.totalAcessosGeograficos || 0} acesso(s) mapeado(s)).
        </small>
      </div>
      <span class="spacer"></span>
      <button
        type="button"
        class="btn sm"
        id="btn-toggle-mapa-acessos"
        style="background:#0284c7;border-color:#0284c7;font-weight:700;display:inline-flex;align-items:center;gap:6px"
      >
        🗺️ Mostrar no Mapa
      </button>
    </div>

    <!-- Painel do Mapa Interativo (recolhido por padrão, abre ao clicar em "Mostrar no Mapa" ou em qualquer País/Cidade) -->
    <div id="box-mapa-acessos" class="geo-map-box">
      <div
        class="row"
        style="padding:10px 14px;background:#0f172a;color:#ffffff;justify-content:space-between;gap:10px;flex-wrap:wrap"
      >
        <div style="font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px">
          <span>🗺️ Mapa Interativo de Origem dos Acessos</span>
          <span
            id="lbl-foco-mapa"
            style="font-size:11.5px;background:rgba(56,189,248,0.2);color:#bae6fd;padding:2px 9px;border-radius:99px"
          >
            Visão geral de todas as localidades
          </span>
        </div>
        <div class="row" style="gap:6px;margin:0">
          <button
            type="button"
            class="btn sec sm"
            id="btn-reset-zoom-mapa"
            style="padding:4px 10px;font-size:12px;background:#1e293b;color:#e2e8f0;border-color:#334155"
          >
            🌐 Ver Todos os Pontos
          </button>
          <button
            type="button"
            class="btn sec sm"
            id="btn-fechar-mapa-acessos"
            style="padding:4px 10px;font-size:12px;background:#1e293b;color:#e2e8f0;border-color:#334155"
          >
            ✕ Ocultar Mapa
          </button>
        </div>
      </div>
      <div id="mapa-origem-leaflet"></div>
    </div>

    <div class="grid" style="margin-top:12px">
      <!-- Item 1: Países -->
      <div class="c6">
        <div style="padding:14px;border:1px solid #e2e8f0;border-radius:12px;background:#ffffff;height:100%">
          <div class="row" style="justify-content:space-between;margin-bottom:10px">
            <h3 style="margin:0;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:6px">
              🏳️ Acessos por Países
            </h3>
            <span class="tag" style="background:#e0f2fe;color:#0369a1;font-weight:700">
              {(dash.origensPaises || []).length} país(es)
            </span>
          </div>

          {(dash.origensPaises || []).length === 0 ? (
            <p class="muted" style="font-size:13px;margin:8px 0">
              Nenhum acesso geográfico por país registrado até o momento.
            </p>
          ) : (
            <div style="max-height:310px;overflow-y:auto;padding-right:2px">
              {(dash.origensPaises || []).map((p: any, idx: number) => {
                const percBarra = Math.min(100, Math.round((Number(p.acessos || 0) / maxPaisAcessos) * 100));
                return (
                  <div class="geo-row">
                    <div style="font-size:12px;font-weight:800;color:#64748b;width:22px">#{idx + 1}</div>
                    <div class="geo-flag">{p.bandeira}</div>
                    <div style="flex:1;min-width:0">
                      <div class="row" style="justify-content:space-between;gap:8px;margin:0">
                        <strong style="color:#0f172a;font-size:13.5px">
                          {p.paisNome}{' '}
                          <span class="muted" style="font-weight:500;font-size:12px">({p.paisCodigo})</span>
                        </strong>
                        <div class="row" style="gap:6px;margin:0">
                          <span class="metric-pill" style="background:#e0f2fe;color:#0369a1">
                            {p.acessos} {p.acessos === 1 ? 'acesso' : 'acessos'} ({p.percentual}%)
                          </span>
                          <button
                            type="button"
                            class="btn sec sm btn-focar-mapa"
                            style="padding:2px 8px;font-size:11.5px;border-color:#7dd3fc;color:#0284c7"
                            data-lat={p.latitude}
                            data-lon={p.longitude}
                            data-zoom="4"
                            data-label={`${p.bandeira} ${p.paisNome} (${p.acessos} acesso(s))`}
                            title={`Ver ${p.paisNome} no mapa`}
                          >
                            📍 Mapa
                          </button>
                        </div>
                      </div>
                      <div class="cat-rank-bar-bg">
                        <div
                          class="cat-rank-bar-fill"
                          style={`width:${Math.max(5, percBarra)}%;background:linear-gradient(90deg,#0284c7,#38bdf8)`}
                        ></div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>

      <!-- Item 2: Cidades / Países -->
      <div class="c6">
        <div style="padding:14px;border:1px solid #e2e8f0;border-radius:12px;background:#ffffff;height:100%">
          <div class="row" style="justify-content:space-between;margin-bottom:10px">
            <h3 style="margin:0;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:6px">
              🏙️ Acessos por Cidades / Países
            </h3>
            <span class="tag" style="background:#ede9fe;color:#6d28d9;font-weight:700">
              {(dash.origensCidadesPaises || []).length} cidade(s)
            </span>
          </div>

          {(dash.origensCidadesPaises || []).length === 0 ? (
            <p class="muted" style="font-size:13px;margin:8px 0">
              Nenhum acesso geográfico por cidade/país registrado até o momento.
            </p>
          ) : (
            <div style="max-height:310px;overflow-y:auto;padding-right:2px">
              {(dash.origensCidadesPaises || []).map((cid: any, idx: number) => {
                const percBarra = Math.min(100, Math.round((Number(cid.acessos || 0) / maxCidadeAcessos) * 100));
                return (
                  <div class="geo-row">
                    <div style="font-size:12px;font-weight:800;color:#64748b;width:22px">#{idx + 1}</div>
                    <div class="geo-flag">{cid.bandeira}</div>
                    <div style="flex:1;min-width:0">
                      <div class="row" style="justify-content:space-between;gap:8px;margin:0">
                        <strong
                          style="color:#0f172a;font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                          title={cid.cidadePaisLabel}
                        >
                          {cid.cidade}
                          {cid.regiao ? `/${cid.regiao}` : ''}{' '}
                          <span class="muted" style="font-weight:500;font-size:12px">· {cid.paisNome}</span>
                        </strong>
                        <div class="row" style="gap:6px;margin:0">
                          <span class="metric-pill" style="background:#ede9fe;color:#6d28d9">
                            {cid.acessos} {cid.acessos === 1 ? 'acesso' : 'acessos'} ({cid.percentual}%)
                          </span>
                          <button
                            type="button"
                            class="btn sec sm btn-focar-mapa"
                            style="padding:2px 8px;font-size:11.5px;border-color:#c4b5fd;color:#6d28d9"
                            data-lat={cid.latitude}
                            data-lon={cid.longitude}
                            data-zoom="10"
                            data-label={`${cid.bandeira} ${cid.cidadePaisLabel} (${cid.acessos} acesso(s))`}
                            title={`Ver ${cid.cidadePaisLabel} no mapa`}
                          >
                            📍 Mapa
                          </button>
                        </div>
                      </div>
                      <div class="cat-rank-bar-bg">
                        <div
                          class="cat-rank-bar-fill"
                          style={`width:${Math.max(5, percBarra)}%;background:linear-gradient(90deg,#7c3aed,#a78bfa)`}
                        ></div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Linha 2: Categorias Mais Consultadas -->
  <div class="card" style="border-left:4px solid #2563eb">
    <div class="row" style="margin-bottom:10px">
      <div>
        <h2 style="margin:0">🏷️ Categorias Mais Consultadas na Loja</h2>
        <small class="muted">
          Exibindo apenas categorias com pelo menos um indicador maior que zero (consultas, visualizações, intenções no carrinho ou vendas).
        </small>
      </div>
      <span class="spacer"></span>
      <a class="btn sec sm" href="/categorias">⚙️ Gerenciar Categorias e Ícones</a>
    </div>

    {dash.categoriasMaisConsultadas.length === 0 ? (
      <p class="muted">Nenhuma categoria possui consultas, visualizações, inserções no carrinho ou vendas registradas até o momento.</p>
    ) : (
      <div class="grid">
        {dash.categoriasMaisConsultadas.slice(0, 12).map((cat, idx) => {
          const perc = Math.min(100, Math.round((Number(cat.totalConsultas || 0) / maxCatConsultas) * 100));
          return (
            <div class="c6">
              <div class="cat-rank-row">
                <div style="font-size:12px;font-weight:800;color:#64748b;width:22px">#{idx + 1}</div>
                <div class="cat-rank-ico">{cat.icone}</div>
                <div style="flex:1;min-width:0">
                  <div class="row" style="justify-content:space-between;gap:8px;margin:0">
                    <a
                      href={`/?cat=${encodeURIComponent(cat.categoria)}#tabela-metricas-produtos`}
                      style="font-weight:700;color:#0f172a;text-decoration:none"
                    >
                      {cat.categoria}
                    </a>
                    <div class="row" style="gap:6px;margin:0">
                      <span class="metric-pill" style="background:#dbeafe;color:#1e40af" title="Consultas / Visualizações">
                        👁️ {cat.totalConsultas} consulta{cat.totalConsultas === 1 ? '' : 's'}
                      </span>
                      <span class="metric-pill" style="background:#dcfce7;color:#166534" title="Unidades vendidas">
                        ✅ {formatQty(cat.vendasEfetivadas)} vend.
                      </span>
                    </div>
                  </div>
                  <div class="cat-rank-bar-bg">
                    <div class="cat-rank-bar-fill" style={`width:${Math.max(4, perc)}%`}></div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>

  <!-- Linha 3: Produtos com Contadores de Visualizações, Inserções no Carrinho (por pessoa/intenção) e Vendas Efetivadas -->
  <div class="card" id="tabela-metricas-produtos">
    <div class="row" style="margin-bottom:12px;flex-wrap:wrap;gap:10px">
      <div>
        <h2 style="margin:0">📦 Produtos com Movimento (Visualizações, Intenções no Carrinho por Produto e Vendas)</h2>
        <small class="muted">
          Exibindo {listaProdutos.length} produto(s) com pelo menos um contador maior que zero. A coluna de carrinho mostra quantas pessoas tentaram comprar cada produto.
        </small>
      </div>
      <span class="spacer"></span>

      <form method="get" action="/#tabela-metricas-produtos" class="row" style="gap:8px;margin:0;flex-wrap:wrap">
        <input
          name="q"
          value={sp.get('q') ?? ''}
          placeholder="Buscar produto ou código..."
          style="width:210px"
        />
        <select name="cat" style="width:190px">
          <option value="">Todas as categorias</option>
          {dash.categoriasMaisConsultadas.map((c) => (
            <option value={c.categoria} selected={catFiltro.toLowerCase() === c.categoria.toLowerCase()}>
              {c.icone} {c.categoria}
            </option>
          ))}
        </select>
        <select name="ordem" style="width:210px">
          <option value="vendas" selected={ordem === 'vendas'}>Ordenar: Mais Vendidos ✅</option>
          <option value="carrinho" selected={ordem === 'carrinho'}>Ordenar: Mais Pessoas no Carrinho 🛒</option>
          <option value="visualizacoes" selected={ordem === 'visualizacoes'}>Ordenar: Mais Visualizados 👁️</option>
          <option value="nome" selected={ordem === 'nome'}>Ordenar: Nome (A-Z)</option>
        </select>
        <button type="submit" class="sm">Filtrar</button>
        {(buscaProd || catFiltro || ordem !== 'vendas') && (
          <a class="btn sec sm" href="/#tabela-metricas-produtos">Limpar</a>
        )}
      </form>
    </div>

    {listaProdutos.length === 0 ? (
      <p class="muted">Nenhum produto possui visualizações, inserções no carrinho ou vendas registradas até o momento.</p>
    ) : (
      <div class="tbl-wrap" style="max-height:560px;overflow-y:auto">
        <table>
          <thead>
            <tr>
              <th>Código</th>
              <th>Produto</th>
              <th>Categoria</th>
              <th style="text-align:center">👁️ Visualizações</th>
              <th style="text-align:center" title="Quantidade de pessoas que colocaram este produto no carrinho (intenção de compra)">
                🛒 Inserções no Carrinho (Pessoas)
              </th>
              <th style="text-align:center">✅ Vendas Efetivadas</th>
              <th style="text-align:right">Receita Efetivada</th>
            </tr>
          </thead>
          <tbody>
            {listaProdutos.map((p: any) => {
              const views = Number(p.visualizacoes || 0);
              const cart = Number(p.insercoes_carrinho || 0);
              const soldQty = Number(p.vendas_quantidade || 0);
              const soldOrders = Number(p.vendas_pedidos || 0);
              const soldVal = Number(p.vendas_valor || 0);
              return (
                <tr>
                  <td class="muted" style="white-space:nowrap">{p.codigo || `#${p.id}`}</td>
                  <td>
                    <div class="row" style="gap:8px;flex-wrap:nowrap">
                      {p.foto && (
                        <img
                          src={p.foto}
                          alt={p.nome}
                          loading="lazy"
                          style="width:34px;height:34px;object-fit:contain;border-radius:6px;border:1px solid var(--bd);background:#fff;flex-shrink:0"
                        />
                      )}
                      <div>
                        <a href={`/produtos/${p.id}`} style="font-weight:600">{p.nome}</a>
                        <div class="muted" style="font-size:11.5px">
                          Preço: {formatMoney(Number(p.preco_venda || 0))} · Estoque: {formatQty(Number(p.estoque_atual || 0))} {p.unidade}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="tag" style="background:#f1f5f9;color:#334155">
                      {iconeCategoriaLoja(p.categoria)} {p.categoria}
                    </span>
                  </td>
                  <td style="text-align:center">
                    <span
                      class="metric-pill"
                      style={views > 0 ? 'background:#dbeafe;color:#1e40af' : 'background:#f1f5f9;color:#64748b'}
                    >
                      👁️ {views}
                    </span>
                  </td>
                  <td style="text-align:center">
                    <span
                      class="metric-pill"
                      style={cart > 0 ? 'background:#fef3c7;color:#92400e' : 'background:#f1f5f9;color:#64748b'}
                      title={`${cart} pessoa(s) inseriram o produto "${p.nome}" no carrinho`}
                    >
                      🛒 {cart} {cart === 1 ? 'pessoa' : 'pessoas'}
                    </span>
                  </td>
                  <td style="text-align:center">
                    <span
                      class="metric-pill"
                      style={soldQty > 0 ? 'background:#dcfce7;color:#166534' : 'background:#f1f5f9;color:#64748b'}
                    >
                      ✅ {formatQty(soldQty)} {p.unidade} ({soldOrders} ped.)
                    </span>
                  </td>
                  <td style="text-align:right;font-weight:700;color:#047857">
                    {formatMoney(soldVal)}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <script
    is:inline
    define:vars={{
      PONTOS_CIDADES_MAPA: dash.origensCidadesPaises || [],
      PONTOS_PAISES_MAPA: dash.origensPaises || [],
    }}
  >
    (function () {
      const btnToggle = document.getElementById('btn-toggle-mapa-acessos');
      const btnFechar = document.getElementById('btn-fechar-mapa-acessos');
      const btnReset = document.getElementById('btn-reset-zoom-mapa');
      const boxMapa = document.getElementById('box-mapa-acessos');
      const lblFoco = document.getElementById('lbl-foco-mapa');
      const mapEl = document.getElementById('mapa-origem-leaflet');
      if (!btnToggle || !boxMapa || !mapEl) return;

      let mapInstance = null;
      let markersBounds = null;
      const markersByCoord = new Map();

      function initOrRefreshMap() {
        if (typeof window.L === 'undefined') {
          mapEl.innerHTML =
            '<div style="padding:24px;text-align:center;color:#475569">Não foi possível carregar os blocos do mapa neste momento.</div>';
          return;
        }
        if (mapInstance) {
          setTimeout(() => mapInstance.invalidateSize(), 60);
          return;
        }

        mapInstance = window.L.map(mapEl, {
          center: [-15.78, -47.93],
          zoom: 3,
          scrollWheelZoom: true,
        });

        window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap',
        }).addTo(mapInstance);

        const pontos =
          Array.isArray(PONTOS_CIDADES_MAPA) && PONTOS_CIDADES_MAPA.length > 0
            ? PONTOS_CIDADES_MAPA
            : Array.isArray(PONTOS_PAISES_MAPA)
              ? PONTOS_PAISES_MAPA
              : [];

        const latLngs = [];
        const maxAcc = Math.max(1, ...pontos.map((pt) => Number(pt.acessos || 1)));

        pontos.forEach((pt) => {
          const lat = Number(pt.latitude);
          const lon = Number(pt.longitude);
          if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

          const qtd = Number(pt.acessos || 1);
          const raio = Math.min(26, Math.max(9, 9 + Math.round((qtd / maxAcc) * 16)));
          const titulo = pt.cidadePaisLabel || pt.paisNome || 'Origem';
          const circle = window.L.circleMarker([lat, lon], {
            radius: raio,
            color: '#1e3a8a',
            weight: 2,
            fillColor: '#0284c7',
            fillOpacity: 0.72,
          }).addTo(mapInstance);

          circle.bindPopup(
            '<div style="font-family:system-ui,sans-serif;min-width:170px">' +
              '<div style="font-size:14px;font-weight:800;margin-bottom:3px">' +
              (pt.bandeira || '📍') +
              ' ' +
              titulo +
              '</div>' +
              '<div style="font-size:12.5px;color:#0369a1;font-weight:700">' +
              qtd +
              (qtd === 1 ? ' acesso registrado' : ' acessos registrados') +
              (pt.percentual ? ' (' + pt.percentual + '%)' : '') +
              '</div>' +
              '</div>',
          );

          latLngs.push([lat, lon]);
          markersByCoord.set(lat.toFixed(3) + ',' + lon.toFixed(3), circle);
        });

        if (latLngs.length > 1) {
          markersBounds = window.L.latLngBounds(latLngs);
          mapInstance.fitBounds(markersBounds, { padding: [38, 38], maxZoom: 10 });
        } else if (latLngs.length === 1) {
          mapInstance.setView(latLngs[0], 6);
        }

        setTimeout(() => mapInstance.invalidateSize(), 80);
      }

      function setMapaVisivel(visivel) {
        boxMapa.classList.toggle('open', visivel);
        btnToggle.innerHTML = visivel ? '🗺️ Ocultar Mapa' : '🗺️ Mostrar no Mapa';
        if (visivel) {
          initOrRefreshMap();
        }
      }

      btnToggle.addEventListener('click', () => {
        setMapaVisivel(!boxMapa.classList.contains('open'));
      });

      if (btnFechar) {
        btnFechar.addEventListener('click', () => setMapaVisivel(false));
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          if (!mapInstance) return;
          if (lblFoco) lblFoco.textContent = 'Visão geral de todas as localidades';
          if (markersBounds) {
            mapInstance.fitBounds(markersBounds, { padding: [38, 38], maxZoom: 10 });
          } else {
            mapInstance.setView([-15.78, -47.93], 3);
          }
        });
      }

      document.querySelectorAll('.btn-focar-mapa').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lat = Number(btn.getAttribute('data-lat'));
          const lon = Number(btn.getAttribute('data-lon'));
          const zoom = Number(btn.getAttribute('data-zoom')) || 8;
          const label = btn.getAttribute('data-label') || '';
          setMapaVisivel(true);
          setTimeout(() => {
            if (!mapInstance || !Number.isFinite(lat) || !Number.isFinite(lon)) return;
            mapInstance.invalidateSize();
            mapInstance.setView([lat, lon], zoom, { animate: true });
            if (lblFoco && label) lblFoco.textContent = 'Foco: ' + label;
            const key = lat.toFixed(3) + ',' + lon.toFixed(3);
            const marker = markersByCoord.get(key);
            if (marker) marker.openPopup();
          }, 100);
        });
      });
    })();
  </script>
</Layout>
