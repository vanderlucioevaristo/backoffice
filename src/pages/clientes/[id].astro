---
import Layout from '../../layouts/Layout.astro';
import { db, hashPassword } from '../../lib/auth';
import { str, onlyDigits, cleanDoc, validCPF, validCNPJ, validEmail, UFS } from '../../lib/validate';

const u = Astro.locals.user!;
const idParam = Astro.params.id!;
const isNew = idParam === 'novo';
const id = Number(idParam);
if (!isNew && !Number.isInteger(id)) return Astro.redirect('/clientes');

let erro = '';
let p: Record<string, any> = { tipo_pessoa: 'F', eh_cliente: 1, eh_fornecedor: 0, ativo: 1, cnpj_novo_formato: 0 };

if (!isNew) {
  const row = await db().prepare('SELECT * FROM parceiros WHERE id = ? AND empresa_id = ?').bind(id, u.empresaId).first<any>();
  if (!row) return Astro.redirect('/clientes');
  p = row;
  if (!p.cnpj_novo_formato && p.documento && /[A-Z]/i.test(p.documento)) {
    p.cnpj_novo_formato = 1;
  }
}

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (f.get('_acao') === 'excluir' && !isNew) {
    await db().prepare('DELETE FROM parceiros WHERE id = ? AND empresa_id = ?').bind(id, u.empresaId).run();
    return Astro.redirect('/clientes?ok=excluido');
  }
  const tipo = f.get('tipo_pessoa') === 'J' ? 'J' : 'F';
  const cnpjNovoFormato = tipo === 'J' && f.get('cnpj_novo_formato') ? 1 : 0;
  const rawDoc = str(f, 'documento', 30);
  const docLimpo = tipo === 'J' && cnpjNovoFormato ? cleanDoc(rawDoc) : onlyDigits(rawDoc);

  p = {
    ...p,
    tipo_pessoa: tipo,
    eh_cliente: f.get('eh_cliente') ? 1 : 0,
    eh_fornecedor: f.get('eh_fornecedor') ? 1 : 0,
    cnpj_novo_formato: cnpjNovoFormato,
    nome: str(f, 'nome'), nome_fantasia: str(f, 'nome_fantasia'),
    documento: docLimpo, rg_ie: str(f, 'rg_ie', 30),
    email: str(f, 'email'), telefone: str(f, 'telefone', 30), celular: str(f, 'celular', 30), contato: str(f, 'contato'),
    cep: onlyDigits(str(f, 'cep', 12)), logradouro: str(f, 'logradouro'), numero: str(f, 'numero', 20),
    complemento: str(f, 'complemento', 100), bairro: str(f, 'bairro', 100), cidade: str(f, 'cidade', 100),
    uf: str(f, 'uf', 2).toUpperCase(), observacoes: str(f, 'observacoes', 2000),
    ativo: f.get('ativo') ? 1 : 0,
  };
  if (!p.nome) erro = tipo === 'F' ? 'Informe o nome.' : 'Informe a razão social.';
  else if (!p.eh_cliente && !p.eh_fornecedor) erro = 'Marque ao menos uma opção: Cliente ou Fornecedor.';
  else if (p.documento && tipo === 'F' && !validCPF(p.documento)) erro = 'CPF inválido.';
  else if (p.documento && tipo === 'J' && !validCNPJ(p.documento, !!cnpjNovoFormato)) {
    erro = cnpjNovoFormato
      ? 'CNPJ inválido. No novo formato alfanumérico, informe 12 caracteres (letras/números) + 2 dígitos verificadores numéricos.'
      : 'CNPJ inválido. Caso seja um CNPJ alfanumérico, marque a opção "Novo formato" ao lado do campo.';
  }
  else if (p.email && !validEmail(p.email)) erro = 'E-mail inválido.';
  else if (p.uf && !UFS.includes(p.uf)) erro = 'UF inválida.';
  else if (f.get('senha_loja') && String(f.get('senha_loja')).length < 6) erro = 'A senha da loja do cliente deve ter pelo menos 6 caracteres.';
  else if (p.documento) {
    const dup = await db()
      .prepare('SELECT nome FROM parceiros WHERE empresa_id = ? AND documento = ? AND id <> ?')
      .bind(u.empresaId, p.documento, isNew ? 0 : id).first<{ nome: string }>();
    if (dup) erro = `Já existe um cadastro com este documento: ${dup.nome}.`;
  }

  if (!erro) {
    const novaSenhaLoja = String(f.get('senha_loja') ?? '');
    const cols = ['tipo_pessoa','eh_cliente','eh_fornecedor','cnpj_novo_formato','nome','nome_fantasia','documento','rg_ie','email','telefone','celular','contato',
      'cep','logradouro','numero','complemento','bairro','cidade','uf','observacoes','ativo'];
    const vals = cols.map((c) => (typeof p[c] === 'string' && p[c] === '' ? null : p[c]));
    let targetId = id;
    if (isNew) {
      const ins = await db().prepare(`INSERT INTO parceiros (empresa_id, ${cols.join(',')}) VALUES (?, ${cols.map(() => '?').join(',')}) RETURNING id`)
        .bind(u.empresaId, ...vals).first<{ id: number }>();
      targetId = ins!.id;
    } else {
      await db().prepare(`UPDATE parceiros SET ${cols.map((c) => `${c} = ?`).join(', ')}, atualizado_em = datetime('now') WHERE id = ? AND empresa_id = ?`)
        .bind(...vals, id, u.empresaId).run();
    }
    if (novaSenhaLoja) {
      await db().prepare('UPDATE parceiros SET senha_hash = ? WHERE id = ? AND empresa_id = ?')
        .bind(await hashPassword(novaSenhaLoja), targetId, u.empresaId).run();
    }
    return Astro.redirect('/clientes?ok=salvo');
  }
}
const v = (k: string) => p[k] ?? '';
const pj = p.tipo_pessoa === 'J';
---
<Layout title={isNew ? 'Novo cadastro' : 'Editar cadastro'} active="clientes">
  <div class="row" style="margin-bottom:16px">
    <h1 style="margin:0">{isNew ? 'Novo cliente / fornecedor' : 'Editar cadastro'}</h1>
    <span class="spacer"></span>
    <button type="button" class="btn sec" id="btn-auto">⚡ Cadastro automático</button>
  </div>
  {erro && <div class="msg err">{erro}</div>}
  <div id="auto-aviso" class="msg ok" style="display:none"></div>

  <dialog id="dlg-auto" class="modal">
    <form method="dialog" id="form-auto">
      <h2>Cadastro automático</h2>
      <p class="muted" style="margin-top:0;font-size:13px">
        Informe o CPF ou CNPJ para buscar os dados públicos e preencher o formulário automaticamente.
      </p>
      <div id="auto-erro" class="msg err" style="display:none"></div>
      <p>
        <div class="row" style="justify-content:space-between;margin-bottom:4px">
          <label for="inp-auto-doc" style="margin:0">CPF ou CNPJ *</label>
          <label class="check" style="font-size:12px;margin:0">
            <input type="checkbox" id="chk-auto-cnpj-novo" /> CNPJ novo formato (alfanumérico)
          </label>
        </div>
        <input id="inp-auto-doc" placeholder="Digite somente números ou com pontuação" inputmode="numeric" autocomplete="off" style="text-transform:uppercase" />
      </p>
      <div class="row" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn sec" id="btn-auto-fechar">Cancelar</button>
        <button type="submit" id="btn-auto-buscar">Buscar</button>
      </div>
    </form>
  </dialog>

  <form method="post" id="form">
    <div class="card">
      <h2>Dados principais</h2>
      <div class="grid">
        <div class="c3"><label>Tipo de pessoa *</label>
          <select name="tipo_pessoa" id="tipo">
            <option value="F" selected={!pj}>Pessoa Física</option>
            <option value="J" selected={pj}>Pessoa Jurídica</option>
          </select></div>
        <div class="c6"><label>Cadastrar como *</label>
          <div class="row" style="height:36px">
            <label class="check"><input type="checkbox" name="eh_cliente" checked={!!p.eh_cliente} /> Cliente</label>
            <label class="check"><input type="checkbox" name="eh_fornecedor" checked={!!p.eh_fornecedor} /> Fornecedor</label>
          </div></div>
        <div class="c3"><label>&nbsp;</label><label class="check"><input type="checkbox" name="ativo" checked={!!p.ativo} /> Ativo</label></div>
        <div class="c6"><label id="lbl-nome">{pj ? 'Razão social *' : 'Nome completo *'}</label><input name="nome" value={v('nome')} required /></div>
        <div class="c6"><label id="lbl-fantasia">{pj ? 'Nome fantasia' : 'Apelido'}</label><input name="nome_fantasia" value={v('nome_fantasia')} /></div>
        <div class="c4">
          <div class="row" style="justify-content:space-between;margin-bottom:4px;gap:6px">
            <label id="lbl-doc" style="margin:0">{pj ? 'CNPJ' : 'CPF'}</label>
            <label
              id="wrap-cnpj-novo"
              class="check"
              style={`font-size:12px;margin:0;color:var(--pr);font-weight:600;${pj ? 'display:inline-flex' : 'display:none'}`}
              title="Habilita o novo padrão de CNPJ alfanumérico (letras e números — IN RFB nº 2.229/2024)"
            >
              <input type="checkbox" name="cnpj_novo_formato" id="chk-cnpj-novo" value="1" checked={!!p.cnpj_novo_formato} />
              Novo formato (alfanumérico)
            </label>
          </div>
          <input
            name="documento"
            id="inp-documento"
            value={v('documento')}
            inputmode={pj && p.cnpj_novo_formato ? 'text' : 'numeric'}
            maxlength="18"
            placeholder={pj ? (p.cnpj_novo_formato ? 'AA.AAA.AAA/AAAA-00' : '00.000.000/0000-00') : '000.000.000-00'}
            style="text-transform:uppercase"
          />
        </div>
        <div class="c4"><label id="lbl-rg">{pj ? 'Inscrição estadual' : 'RG'}</label><input name="rg_ie" value={v('rg_ie')} /></div>
        <div class="c4"><label>Pessoa de contato</label><input name="contato" value={v('contato')} /></div>
      </div>
    </div>
    <div class="card">
      <h2>Contato</h2>
      <div class="grid">
        <div class="c4"><label>E-mail</label><input name="email" type="email" value={v('email')} /></div>
        <div class="c3"><label>Telefone</label><input name="telefone" value={v('telefone')} /></div>
        <div class="c2"><label>Celular / WhatsApp</label><input name="celular" value={v('celular')} /></div>
        <div class="c3">
          <label>Senha da Loja Virtual</label>
          <input name="senha_loja" type="password" minlength="6" autocomplete="new-password" placeholder={p.senha_hash ? 'Deixe vazio p/ manter' : 'Definir senha'} />
        </div>
      </div>
    </div>
    <div class="card">
      <div class="row" style="margin-bottom:8px">
        <h2 style="margin:0">Endereço</h2>
        <span id="cep-status" class="muted" style="font-size:13px"></span>
      </div>
      <div class="grid">
        <div class="c3"><label>CEP</label><input name="cep" id="inp-cep" value={v('cep')} inputmode="numeric" maxlength="9" placeholder="00000-000" /></div>
        <div class="c6"><label>Logradouro</label><input name="logradouro" value={v('logradouro')} /></div>
        <div class="c3"><label>Número</label><input name="numero" value={v('numero')} /></div>
        <div class="c4"><label>Complemento</label><input name="complemento" value={v('complemento')} /></div>
        <div class="c4"><label>Bairro</label><input name="bairro" value={v('bairro')} /></div>
        <div class="c3"><label>Cidade</label><input name="cidade" value={v('cidade')} /></div>
        <div class="c1" style="grid-column:span 1"><label>UF</label>
          <select name="uf"><option value=""></option>{UFS.map((s) => <option selected={p.uf === s}>{s}</option>)}</select></div>
      </div>
    </div>
    <div class="card">
      <h2>Observações</h2>
      <textarea name="observacoes" rows="3">{v('observacoes')}</textarea>
    </div>
    <div class="row">
      <button>Salvar</button>
      <a class="btn sec" href="/clientes">Cancelar</a>
      <span class="spacer"></span>
      {!isNew && <button class="dg" name="_acao" value="excluir" formnovalidate onclick="return confirm('Excluir este cadastro definitivamente?')">Excluir</button>}
    </div>
  </form>
</Layout>
<script is:inline>
  const t = document.getElementById('tipo');
  const wrapCnpjNovo = document.getElementById('wrap-cnpj-novo');
  const chkCnpjNovo = document.getElementById('chk-cnpj-novo');
  const inpDocumento = document.getElementById('inp-documento');

  const set = () => {
    const j = t.value === 'J';
    const novoFmt = j && chkCnpjNovo && chkCnpjNovo.checked;
    document.getElementById('lbl-nome').textContent = j ? 'Razão social *' : 'Nome completo *';
    document.getElementById('lbl-fantasia').textContent = j ? 'Nome fantasia' : 'Apelido';
    document.getElementById('lbl-doc').textContent = j ? 'CNPJ' : 'CPF';
    document.getElementById('lbl-rg').textContent = j ? 'Inscrição estadual' : 'RG';
    if (wrapCnpjNovo) wrapCnpjNovo.style.display = j ? 'inline-flex' : 'none';
    if (inpDocumento) {
      inpDocumento.inputMode = novoFmt ? 'text' : 'numeric';
      inpDocumento.placeholder = j
        ? (novoFmt ? 'AA.AAA.AAA/AAAA-00' : '00.000.000/0000-00')
        : '000.000.000-00';
    }
  };
  t.addEventListener('change', set);
  chkCnpjNovo?.addEventListener('change', set);
  inpDocumento?.addEventListener('input', () => {
    const j = t.value === 'J';
    // Se o usuário digitar letras em PJ, marca automaticamente a flag de novo formato
    if (j && /[a-zA-Z]/.test(inpDocumento.value) && chkCnpjNovo && !chkCnpjNovo.checked) {
      chkCnpjNovo.checked = true;
      set();
    }
    inpDocumento.value = inpDocumento.value.toUpperCase();
  });

  // Cadastro automático via diálogo de CPF/CNPJ
  const dlg = document.getElementById('dlg-auto');
  const btnAuto = document.getElementById('btn-auto');
  const btnFechar = document.getElementById('btn-auto-fechar');
  const btnBuscar = document.getElementById('btn-auto-buscar');
  const formAuto = document.getElementById('form-auto');
  const inpDoc = document.getElementById('inp-auto-doc');
  const boxErro = document.getElementById('auto-erro');
  const boxAviso = document.getElementById('auto-aviso');
  const form = document.getElementById('form');

  function abrirDialogo() {
    boxErro.style.display = 'none';
    boxErro.textContent = '';
    const docAtual = form.querySelector('[name="documento"]')?.value || '';
    if (docAtual && !inpDoc.value) inpDoc.value = docAtual;
    dlg.showModal();
    setTimeout(() => inpDoc.focus(), 50);
  }

  btnAuto.addEventListener('click', abrirDialogo);
  btnFechar.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  if (new URLSearchParams(location.search).get('auto') === '1') {
    abrirDialogo();
  }

  const chkAutoCnpjNovo = document.getElementById('chk-auto-cnpj-novo');
  chkAutoCnpjNovo?.addEventListener('change', () => {
    inpDoc.inputMode = chkAutoCnpjNovo.checked ? 'text' : 'numeric';
    inpDoc.placeholder = chkAutoCnpjNovo.checked
      ? 'Ex: 12.ABC.345/01DE-35 (letras e números)'
      : 'Digite somente números ou com pontuação';
  });

  formAuto.addEventListener('submit', async (e) => {
    e.preventDefault();
    boxErro.style.display = 'none';
    const raw = (inpDoc.value || '').toUpperCase();
    const isAlnum = (chkAutoCnpjNovo && chkAutoCnpjNovo.checked) || /[A-Z]/.test(raw);
    const doc = isAlnum ? raw.replace(/[^0-9A-Z]/g, '') : raw.replace(/\D/g, '');
    if (doc.length !== 11 && doc.length !== 14) {
      boxErro.textContent = 'Informe um CPF (11 dígitos) ou CNPJ (14 caracteres).';
      boxErro.style.display = 'block';
      return;
    }

    btnBuscar.disabled = true;
    const txtOriginal = btnBuscar.textContent;
    btnBuscar.textContent = 'Buscando...';

    try {
      const res = await fetch('/api/consulta-doc?doc=' + encodeURIComponent(doc) + (isAlnum ? '&novo=1' : ''));
      const data = await res.json();
      if (!res.ok || data.erro) {
        boxErro.textContent = data.erro || 'Não foi possível consultar o documento.';
        boxErro.style.display = 'block';
        return;
      }

      const d = data.dados || {};
      if (d.tipo_pessoa) {
        t.value = d.tipo_pessoa;
      }
      if (chkCnpjNovo) {
        chkCnpjNovo.checked = !!isAlnum || /[A-Z]/.test(String(d.documento || ''));
      }
      set();
      const campos = [
        'documento', 'nome', 'nome_fantasia', 'rg_ie', 'contato',
        'email', 'telefone', 'celular',
        'cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf', 'observacoes'
      ];
      campos.forEach((k) => {
        if (d[k] !== undefined && d[k] !== null && d[k] !== '') {
          const el = form.querySelector(`[name="${k}"]`);
          if (el) el.value = d[k];
        }
      });
      if (typeof d.ativo === 'boolean') {
        const chk = form.querySelector('[name="ativo"]');
        if (chk) chk.checked = d.ativo;
      }

      dlg.close();
      if (data.aviso) {
        boxAviso.textContent = data.aviso;
        boxAviso.style.display = 'block';
      }
      form.querySelector('[name="nome"]')?.focus();
    } catch {
      boxErro.textContent = 'Falha de comunicação ao consultar os dados públicos.';
      boxErro.style.display = 'block';
    } finally {
      btnBuscar.disabled = false;
      btnBuscar.textContent = txtOriginal;
    }
  });

  // Preenchimento automático do endereço ao informar o CEP (consulta Correios)
  const inpCep = document.getElementById('inp-cep');
  const cepStatus = document.getElementById('cep-status');
  let ultimoCepConsultado = (inpCep?.value || '').replace(/\D/g, '');

  async function buscarCep(forcar = false) {
    const cep = (inpCep?.value || '').replace(/\D/g, '');
    if (cep.length !== 8) return;
    if (!forcar && cep === ultimoCepConsultado) return;
    ultimoCepConsultado = cep;

    if (cepStatus) {
      cepStatus.style.color = 'var(--mu)';
      cepStatus.textContent = 'Consultando CEP nos Correios...';
    }
    try {
      const r = await fetch('/api/consulta-cep?cep=' + encodeURIComponent(cep));
      const data = await r.json();
      if (!r.ok || data.erro) {
        if (cepStatus) {
          cepStatus.style.color = 'var(--dg)';
          cepStatus.textContent = data.erro || 'CEP não encontrado.';
        }
        return;
      }
      const end = data.endereco || {};
      if (end.logradouro !== undefined) form.querySelector('[name="logradouro"]').value = end.logradouro;
      if (end.bairro !== undefined) form.querySelector('[name="bairro"]').value = end.bairro;
      if (end.cidade !== undefined) form.querySelector('[name="cidade"]').value = end.cidade;
      if (end.uf) form.querySelector('[name="uf"]').value = end.uf;
      const compEl = form.querySelector('[name="complemento"]');
      if (end.complemento && compEl && !compEl.value.trim()) compEl.value = end.complemento;

      if (cepStatus) {
        cepStatus.style.color = 'var(--ok)';
        cepStatus.textContent = '✓ Endereço carregado dos Correios';
      }
      form.querySelector('[name="numero"]')?.focus();
    } catch {
      if (cepStatus) {
        cepStatus.style.color = 'var(--dg)';
        cepStatus.textContent = 'Não foi possível consultar o CEP no momento.';
      }
    }
  }

  inpCep?.addEventListener('input', () => {
    const d = (inpCep.value || '').replace(/\D/g, '');
    if (d.length === 8) buscarCep(false);
    else if (cepStatus) cepStatus.textContent = '';
  });
  inpCep?.addEventListener('blur', () => buscarCep(false));
</script>
