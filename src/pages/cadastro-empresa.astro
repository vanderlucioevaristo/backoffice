---
import Layout from '../layouts/Layout.astro';
import { db, createSession, SESSION_COOKIE, signupAllowed } from '../lib/auth';
import { registrarEmpresaComUsuario } from '../lib/empresa-service';
import { str } from '../lib/validate';

if (!signupAllowed()) return Astro.redirect('/login');
if (Astro.locals.user) return Astro.redirect('/');

let erro = '';
let v: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  v = {
    codigo: str(f, 'codigo', 30).toLowerCase(), razao: str(f, 'razao'), fantasia: str(f, 'fantasia'),
    cnpj: str(f, 'cnpj', 20), nome: str(f, 'nome'), email: str(f, 'email'), login: str(f, 'login', 40).toLowerCase(),
  };
  const senha = String(f.get('senha') ?? '');

  const res = await registrarEmpresaComUsuario(db(), {
    codigo: v.codigo,
    razao: v.razao,
    fantasia: v.fantasia,
    cnpj: v.cnpj,
    nome: v.nome,
    email: v.email,
    login: v.login,
    senha,
  });

  if (!res.ok) {
    erro = res.erro ?? 'Erro ao cadastrar empresa.';
  } else {
    const s = await createSession(res.usuarioId!, res.empresaId!);
    Astro.cookies.set(SESSION_COOKIE, s.token, { httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', path: '/', maxAge: s.maxAge });
    return Astro.redirect('/');
  }
}
---
<Layout title="Cadastrar empresa" bare>
  <form method="post" class="card" style="max-width:560px">
    <h1>Cadastrar empresa</h1>
    {erro && <div class="msg err">{erro}</div>}
    <div class="grid">
      <div class="c6"><label>Código da empresa * (usado no login)</label><input name="codigo" value={v.codigo ?? ''} required /></div>
      <div class="c6"><label>CNPJ</label><input name="cnpj" value={v.cnpj ?? ''} inputmode="numeric" /></div>
      <div class="c12"><label>Razão social *</label><input name="razao" value={v.razao ?? ''} required /></div>
      <div class="c12"><label>Nome fantasia</label><input name="fantasia" value={v.fantasia ?? ''} /></div>
      <div class="c12"><h2 style="margin:8px 0 0">Administrador</h2></div>
      <div class="c12"><label>Nome completo *</label><input name="nome" value={v.nome ?? ''} required /></div>
      <div class="c6"><label>Usuário *</label><input name="login" value={v.login ?? ''} required autocomplete="username" /></div>
      <div class="c6"><label>E-mail</label><input name="email" type="email" value={v.email ?? ''} /></div>
      <div class="c12"><label>Senha * (mín. 8 caracteres)</label><input name="senha" type="password" required minlength="8" autocomplete="new-password" /></div>
    </div>
    <p class="row"><button>Criar empresa</button><a href="/login">Voltar</a></p>
  </form>
</Layout>
