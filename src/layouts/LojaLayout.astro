        }
        /* Rodapé e Bot no celular */
        .ml-footer-inner {
          padding: 20px 14px 16px;
          grid-template-columns: 1fr;
          gap: 16px;
        }
        .bot-fab {
          right: 12px;
          bottom: 12px;
          padding: 9px 13px;
          font-size: 12px;
        }
        .bot-win {
          right: 12px;
          left: auto;
          bottom: 56px;
          width: min(295px, calc(100vw - 24px));
          height: 350px;
          max-height: calc(100dvh - 135px);
          border-radius: 12px;
        }
        .bot-head {
