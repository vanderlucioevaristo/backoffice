---
import '../styles/global.css';
import type { LojaEmpresa, SessionClient } from '../lib/auth';
import { formatDoc } from '../lib/validate';

interface Props {
  title: string;
  empresa: LojaEmpresa;
  cliente?: SessionClient | null;
  qtdCarrinho?: number;
  busca?: string;
  catAtiva?: string;
  categorias?: Array<{ categoria: string; qtd: number }>;
  bare?: boolean;
}
const {
  title,
  empresa,
  cliente = null,
  qtdCarrinho = 0,
  busca = '',
  catAtiva = '',
  categorias = [],
  bare = false,
} = Astro.props;
const baseUrl = `/loja/${empresa.codigo}`;

// Usa as cores personalizadas pelo lojista; quando estão no padrão inicial,
// aplica a identidade estilo Mercado Livre (cabeçalho amarelo #ffe600 e botões azuis #3483fa)
const headerBg =
  !empresa.cor_secundaria || empresa.cor_secundaria === '#111827' ? '#ffe600' : empresa.cor_secundaria;
const primaryColor =
  !empresa.cor_primaria || empresa.cor_primaria === '#2563eb' ? '#3483fa' : empresa.cor_primaria;
const pageBg = !empresa.cor_fundo || empresa.cor_fundo === '#f4f6f9' ? '#ebebeb' : empresa.cor_fundo;
const textColor = !empresa.cor_texto || empresa.cor_texto === '#1c2430' ? '#333333' : empresa.cor_texto;
const footerBg = empresa.rodape_cor_fundo || '#ffffff';
const footerTx = empresa.rodape_cor_texto || '#333333';
const whatsDigits = (empresa.rodape_whatsapp ?? '').replace(/\D/g, '');
const whatsHref = whatsDigits
  ? `https://wa.me/${whatsDigits.length <= 11 ? '55' + whatsDigits : whatsDigits}`
  : '';
const anoAtual = new Date().getFullYear();

// Calcula se o fundo do cabeçalho é claro ou escuro para ajustar o contraste do texto
const hex = headerBg.replace('#', '');
const r = parseInt(hex.slice(0, 2) || 'ff', 16);
const g = parseInt(hex.slice(2, 4) || 'e6', 16);
const b = parseInt(hex.slice(4, 6) || '00', 16);
const headerText = (r * 299 + g * 587 + b * 114) / 1000 > 155 ? '#2d3277' : '#ffffff';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {empresa.nome}</title>
    <style is:global define:vars={{
      pr: primaryColor,
      topBg: headerBg,
      topTx: headerText,
      bg: pageBg,
      tx: textColor,
      ftBg: footerBg,
      ftTx: footerTx,
    }}>
      :root {
        --pr: var(--pr);
        --bg: var(--bg);
        --tx: var(--tx);
      }
      body {
        background: var(--bg);
        color: var(--tx);
        font-family: "Proxima Nova", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* Cabeçalho estilo Mercado Livre */
      .ml-header {
        background: var(--topBg);
        color: var(--topTx);
        box-shadow: 0 1px 2px rgba(0,0,0,.1);
      }
      .ml-header-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 10px 16px 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .ml-top-row {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
      }
      .ml-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--topTx) !important;
        font-size: 20px;
        font-weight: 800;
        text-decoration: none !important;
        letter-spacing: -0.3px;
      }
      .ml-brand img {
        max-height: 36px;
        max-width: 130px;
        object-fit: contain;
        border-radius: 4px;
      }
      .ml-search {
        flex: 1;
        min-width: 240px;
        max-width: 600px;
        display: flex;
        background: #fff;
        border-radius: 2px;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,.2);
        overflow: hidden;
      }
      .ml-search input {
        border: none;
        padding: 9px 14px;
        font-size: 15px;
        color: #333;
        width: 100%;
        outline: none;
      }
      .ml-search button {
        background: #fff;
        color: #666;
        border: none;
        border-left: 1px solid #e6e6e6;
        border-radius: 0;
        padding: 0 14px;
        cursor: pointer;
        font-size: 15px;
      }
      .ml-search button:hover { color: #111; }

      .ml-nav-row {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        flex-wrap: wrap;
      }
      .ml-cats {
        display: flex;
        gap: 14px;
        align-items: center;
        flex-wrap: wrap;
        flex: 1;
      }
      .ml-cats a, .ml-user-links a {
        color: var(--topTx);
        opacity: 0.85;
        text-decoration: none;
      }
      .ml-cats a:hover, .ml-cats a.on, .ml-user-links a:hover {
        opacity: 1;
        text-decoration: none;
        font-weight: 600;
      }
      .ml-user-links {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
      }
      .ml-cart-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 700;
      }
      .ml-badge {
        background: var(--pr);
        color: #fff;
        font-size: 11px;
        padding: 1px 6px;
        border-radius: 99px;
      }
      .ml-logout-btn {
        background: none;
        border: none;
        color: var(--topTx);
        opacity: 0.8;
        padding: 0;
        font-size: 13px;
        cursor: pointer;
      }
      .ml-logout-btn:hover { opacity: 1; text-decoration: underline; }

      /* Área principal e cards estilo Mercado Livre */
      .ml-page {
        max-width: 1180px;
        margin: 18px auto 40px;
        padding: 0 16px;
      }
      .prod-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
        gap: 14px;
        align-items: stretch;
      }
      @media (min-width: 960px) {
        .prod-grid {
          grid-template-columns: repeat(5, minmax(0, 1fr));
        }
      }
      .ml-card {
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,.12);
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: box-shadow .16s ease, transform .16s ease;
        overflow: hidden;
      }
      .ml-card:hover {
        box-shadow: 0 7px 16px 0 rgba(0,0,0,.18);
        transform: translateY(-2px);
      }
      .ml-card-thumb {
        height: 92px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        background: #fff;
      }
      .ml-card-thumb img {
        max-width: 72px;
        max-height: 72px;
        width: auto;
        height: auto;
        object-fit: contain;
      }
      .ml-card-thumb .ml-no-img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        background: #f5f5f5;
        display: grid;
        place-items: center;
        font-size: 22px;
      }
      .ml-card-body {
        padding: 10px 12px 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }
      .ml-price {
        font-size: 20px;
        font-weight: 500;
        color: #111;
        line-height: 1.15;
      }
      .ml-stock-badge {
        font-size: 11px;
        font-weight: 600;
        color: #00a650;
      }
      .ml-title {
        font-size: 13px;
        color: rgba(0,0,0,.8);
        font-weight: 400;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 2px;
      }
      .ml-cat-bar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
      }
      .ml-cat-chip {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 99px;
        padding: 5px 12px;
        font-size: 13px;
        color: #333;
        text-decoration: none !important;
      }
      .ml-cat-chip.on {
        background: var(--pr);
        border-color: var(--pr);
        color: #fff;
        font-weight: 600;
      }

      /* Rodapé personalizável da loja */
      .ml-footer {
        margin-top: auto;
        background: var(--ftBg);
        color: var(--ftTx);
        border-top: 1px solid rgba(0,0,0,.1);
        font-size: 13px;
        line-height: 1.5;
      }
      .ml-footer-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 32px 16px 24px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 28px;
      }
      .ml-footer-col h4 {
        margin: 0 0 10px;
        font-size: 14px;
        font-weight: 700;
        color: var(--ftTx);
      }
      .ml-footer-col p,
      .ml-footer-col div {
        color: var(--ftTx);
        opacity: 0.85;
        margin: 0 0 6px;
      }
      .ml-footer-col a {
        color: var(--ftTx);
        opacity: 0.88;
        text-decoration: none;
      }
      .ml-footer-col a:hover {
        opacity: 1;
        text-decoration: underline;
      }
      .ml-footer-bottom {
        border-top: 1px solid rgba(128,128,128,.2);
        padding: 14px 16px;
        text-align: center;
        font-size: 12px;
        opacity: 0.78;
      }
    </style>
  </head>
  <body>
    <header class="ml-header">
      <div class="ml-header-inner">
        <div class="ml-top-row">
          <a href={baseUrl} class="ml-brand">
            {empresa.loja_logo && <img src={empresa.loja_logo} alt={empresa.nome} />}
            <span>{empresa.nome}</span>
          </a>

          {!bare && cliente && (
            <form method="get" action={baseUrl} class="ml-search">
              {catAtiva && <input type="hidden" name="cat" value={catAtiva} />}
              <input name="q" value={busca} placeholder="Buscar produtos, marcas e muito mais…" />
              <button type="submit" title="Buscar">🔍</button>
            </form>
          )}

          <span class="spacer"></span>

          {!bare && cliente && (
            <div class="ml-user-links">
              <span>Olá, <strong>{cliente.nome.split(' ')[0]}</strong></span>
              <a href={`${baseUrl}/meus-pedidos`}>Compras</a>
              <a href={`${baseUrl}/carrinho`} class="ml-cart-pill">
                🛒 Carrinho <span class="ml-badge">{qtdCarrinho}</span>
              </a>
              <form method="post" action={`${baseUrl}/sair`} style="margin:0">
                <button class="ml-logout-btn">Sair</button>
              </form>
            </div>
          )}
        </div>

        {!bare && cliente && categorias.length > 0 && (
          <div class="ml-nav-row">
            <div class="ml-cats">
              <a href={baseUrl} class={!catAtiva ? 'on' : ''}>Todas as categorias</a>
              {categorias.slice(0, 8).map((c) => (
                <a
                  href={`${baseUrl}?cat=${encodeURIComponent(c.categoria)}`}
                  class={catAtiva === c.categoria ? 'on' : ''}
                >
                  {c.categoria}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </header>

    <main class={bare ? 'auth' : 'ml-page'} style={bare ? 'flex:1;width:100%' : 'flex:1;width:100%'}>
      <slot />
    </main>

    <footer class="ml-footer">
      <div class="ml-footer-inner">
        <div class="ml-footer-col">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;opacity:1">
            {empresa.loja_logo && (
              <img
                src={empresa.loja_logo}
                alt={empresa.nome}
                style="max-height:32px;max-width:110px;object-fit:contain;border-radius:4px"
              />
            )}
            <strong style="font-size:16px">{empresa.nome}</strong>
          </div>
          {empresa.rodape_sobre ? (
            <p style="white-space:pre-line">{empresa.rodape_sobre}</p>
          ) : (
            <p>Sua loja virtual oficial com atendimento dedicado e entrega garantida.</p>
          )}
          {(empresa.rodape_instagram || empresa.rodape_facebook) && (
            <div style="display:flex;gap:12px;margin-top:10px;flex-wrap:wrap">
              {empresa.rodape_instagram && (
                <a
                  href={
                    empresa.rodape_instagram.startsWith('http')
                      ? empresa.rodape_instagram
                      : `https://instagram.com/${empresa.rodape_instagram.replace(/^@/, '')}`
                  }
                  target="_blank"
                  rel="noopener"
                >
                  📸 Instagram
                </a>
              )}
              {empresa.rodape_facebook && (
                <a
                  href={
                    empresa.rodape_facebook.startsWith('http')
                      ? empresa.rodape_facebook
                      : `https://${empresa.rodape_facebook}`
                  }
                  target="_blank"
                  rel="noopener"
                >
                  🌐 Facebook / Site
                </a>
              )}
            </div>
          )}
        </div>

        <div class="ml-footer-col">
          <h4>Contato e Atendimento</h4>
          {empresa.rodape_telefone && <div>📞 Telefone: <strong>{empresa.rodape_telefone}</strong></div>}
          {empresa.rodape_whatsapp && (
            <div>
              💬 WhatsApp:{' '}
              <a href={whatsHref} target="_blank" rel="noopener">
                <strong>{empresa.rodape_whatsapp}</strong>
              </a>
            </div>
          )}
          {empresa.rodape_email && (
            <div>
              ✉️ E-mail: <a href={`mailto:${empresa.rodape_email}`}>{empresa.rodape_email}</a>
            </div>
          )}
          {empresa.rodape_horario && <div>🕒 Horário: {empresa.rodape_horario}</div>}
          {!empresa.rodape_telefone && !empresa.rodape_whatsapp && !empresa.rodape_email && !empresa.rodape_horario && (
            <p>Entre em contato com nossa equipe para dúvidas e orçamentos.</p>
          )}
        </div>

        <div class="ml-footer-col">
          <h4>Suporte ao Cliente</h4>
          {empresa.rodape_suporte ? (
            <p style="white-space:pre-line">{empresa.rodape_suporte}</p>
          ) : (
            <p>Dúvidas sobre pedidos, entregas, trocas ou devoluções? Fale com nosso suporte.</p>
          )}
          {cliente && (
            <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
              <a href={baseUrl}>• Catálogo de produtos</a>
              <a href={`${baseUrl}/meus-pedidos`}>• Acompanhar meus pedidos</a>
              <a href={`${baseUrl}/carrinho`}>• Meu carrinho de compras</a>
            </div>
          )}
        </div>

        <div class="ml-footer-col">
          <h4>Endereço e Localização</h4>
          {empresa.rodape_endereco ? (
            <p style="white-space:pre-line">📍 {empresa.rodape_endereco}</p>
          ) : (
            <p>Consulte nossa equipe para informações de retirada ou entrega na sua região.</p>
          )}
        </div>
      </div>

      <div class="ml-footer-bottom">
        {empresa.rodape_copyright ? (
          <span>{empresa.rodape_copyright}</span>
        ) : (
          <span>
            © {anoAtual} {empresa.razao_social || empresa.nome}
            {empresa.cnpj ? ` · CNPJ ${formatDoc(empresa.cnpj)}` : ''} · Todos os direitos reservados.
          </span>
        )}
      </div>
    </footer>
  </body>
</html>
