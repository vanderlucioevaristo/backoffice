          )}
        </div>

        {!bare && cliente && categorias.length > 0 && (
          <div class="ml-nav-row">
            <div class="ml-cats">
              <a href={baseUrl} class={!catAtiva ? 'on' : ''}>
                <span class="nav-cat-ico">{iconeCategoriaLoja('Todas')}</span>
                <span class="nav-cat-txt">Todas as categorias</span>
              </a>
              {categorias.slice(0, 10).map((c) => (
                <a
                  href={`${baseUrl}?cat=${encodeURIComponent(c.categoria)}`}
                  class={catAtiva === c.categoria ? 'on' : ''}
                >
                  <span class="nav-cat-ico">{iconeCategoriaLoja(c.categoria, c.icone)}</span>
                  <span class="nav-cat-txt">{c.categoria}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </header>

    <main class={bare ? 'auth' : 'ml-page'} style={bare ? 'flex:1;width:100%' : 'flex:1;width:100%'}>
      <slot />
    </main>

    <footer class="ml-footer" id="ml-footer">
      <button
        type="button"
        class="ml-footer-toggle"
        id="ml-footer-toggle"
        aria-expanded="false"
        onclick="const f=document.getElementById('ml-footer');const open=f.classList.toggle('expanded');this.setAttribute('aria-expanded',String(open));this.querySelector('.toggle-txt').textContent=open?'Ocultar informações sobre a loja ▲':'Clique para mais informações sobre a loja ▼';if(open)f.scrollIntoView({behavior:'smooth',block:'nearest'});"
      >
        <span>ℹ️</span>
        <span class="toggle-txt">Clique para mais informações sobre a loja ▼</span>
      </button>

      <div class="ml-footer-inner">
        <div class="ml-footer-col">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;opacity:1">
            {empresa.loja_logo && (
              <img
                src={empresa.loja_logo}
                alt={empresa.nome}
                style="max-height:32px;max-width:110px;object-fit:contain;border-radius:4px"
              />
            )}
            <strong style="font-size:16px">{empresa.nome}</strong>
          </div>
          {empresa.rodape_sobre ? (
            <p style="white-space:pre-line">{empresa.rodape_sobre}</p>
          ) : (
            <p>Sua loja virtual oficial com atendimento dedicado e entrega garantida.</p>
          )}
          {(empresa.rodape_instagram || empresa.rodape_facebook) && (
            <div style="display:flex;gap:12px;margin-top:10px;flex-wrap:wrap">
              {empresa.rodape_instagram && (
                <a
                  href={
                    empresa.rodape_instagram.startsWith('http')
                      ? empresa.rodape_instagram
                      : `https://instagram.com/${empresa.rodape_instagram.replace(/^@/, '')}`
                  }
                  target="_blank"
                  rel="noopener"
                >
                  📸 Instagram
                </a>
              )}
              {empresa.rodape_facebook && (
                <a
                  href={
                    empresa.rodape_facebook.startsWith('http')
                      ? empresa.rodape_facebook
                      : `https://${empresa.rodape_facebook}`
                  }
                  target="_blank"
                  rel="noopener"
                >
                  🌐 Facebook / Site
                </a>
              )}
            </div>
          )}
        </div>

        <div class="ml-footer-col">
          <h4>Contato e Atendimento</h4>
          {empresa.rodape_telefone && <div>📞 Telefone: <strong>{empresa.rodape_telefone}</strong></div>}
          {empresa.rodape_whatsapp && (
            <div>
              💬 WhatsApp:{' '}
              <a href={whatsHref} target="_blank" rel="noopener">
                <strong>{empresa.rodape_whatsapp}</strong>
              </a>
            </div>
          )}
          {empresa.rodape_email && (
            <div>
              ✉️ E-mail: <a href={`mailto:${empresa.rodape_email}`}>{empresa.rodape_email}</a>
            </div>
          )}
          {empresa.rodape_horario && <div>🕒 Horário: {empresa.rodape_horario}</div>}
          {!empresa.rodape_telefone && !empresa.rodape_whatsapp && !empresa.rodape_email && !empresa.rodape_horario && (
            <p>Entre em contato com nossa equipe para dúvidas e orçamentos.</p>
          )}
        </div>

        <div class="ml-footer-col">
          <h4>Suporte ao Cliente</h4>
          {empresa.rodape_suporte ? (
            <p style="white-space:pre-line">{empresa.rodape_suporte}</p>
          ) : (
            <p>Dúvidas sobre pedidos, entregas, trocas ou devoluções? Fale com nosso suporte.</p>
          )}
          {cliente && (
            <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
              <a href={baseUrl}>• Catálogo de produtos</a>
              <a href={`${baseUrl}/meu-cadastro`}>• Alterar meu cadastro / endereço</a>
              {empresa.agenda_ativa === 1 && (
                <a href={`${baseUrl}/agenda`}>• {empresa.agenda_menu_texto || 'Agendar serviço'}</a>
              )}
              <a href={`${baseUrl}/meus-pedidos`}>• Acompanhar meus pedidos</a>
              <a href={`${baseUrl}/carrinho`}>• Meu carrinho de compras</a>
            </div>
          )}
        </div>

        <div class="ml-footer-col">
          <h4>Endereço e Localização</h4>
          {empresa.rodape_endereco ? (
            <p style="white-space:pre-line">📍 {empresa.rodape_endereco}</p>
          ) : (
            <p>Consulte nossa equipe para informações de retirada ou entrega na sua região.</p>
          )}
        </div>
      </div>

      <div class="ml-footer-bottom">
        {empresa.rodape_copyright ? (
          <span>{empresa.rodape_copyright}</span>
        ) : (
          <span>
            © {anoAtual} {empresa.razao_social || empresa.nome}
            {empresa.cnpj ? ` · CNPJ ${formatDoc(empresa.cnpj)}` : ''} · Todos os direitos reservados.
          </span>
        )}
      </div>
    </footer>

    <!-- Assistente Virtual da Loja (exibido somente após o cliente fazer login) -->
    {!bare && cliente && (
      <>
        <button type="button" class="bot-fab" id="bot-fab" aria-label="Abrir assistente virtual">
          <span>💬</span>
          <span>Dúvidas? Assistente</span>
        </button>

        <div class="bot-win" id="bot-win" data-empresa={empresa.codigo}>
          <div class="bot-head">
            <div>
              <div class="bot-head-title">🤖 Assistente · {empresa.nome}</div>
              <div class="bot-head-sub">
                {empresa.agenda_ativa === 1
                  ? 'Tire dúvidas sobre pedidos, agendamentos e produtos'
                  : 'Tire dúvidas sobre seus pedidos e produtos'}
              </div>
            </div>
            <button type="button" class="bot-close" id="bot-close" title="Fechar">✕</button>
          </div>

          <div class="bot-msgs" id="bot-msgs">
            <div class="bot-bubble bot">
              Olá, <strong>{cliente.nome}</strong>! 👋 Sou o assistente da <strong>{empresa.nome}</strong>.<br />
              Posso consultar o <strong>status dos seus pedidos</strong>,{empresa.agenda_ativa === 1 ? <> seus <strong>agendamentos e serviços</strong>,</> : ''} verificar <strong>preços e estoque de produtos</strong> ou informar nossos <strong>canais de suporte</strong>. Como posso ajudar?
            </div>
          </div>

          <div class="bot-chips">
            <button type="button" class="bot-chip" data-ask="Qual o status dos meus pedidos?">📦 Meus pedidos</button>
            {empresa.agenda_ativa === 1 && (
              <button type="button" class="bot-chip" data-ask="Quais são os meus agendamentos e serviços disponíveis?">📅 Agendamentos</button>
            )}
            <button type="button" class="bot-chip" data-ask="Quais produtos estão disponíveis em estoque?">🛍️ Produtos e estoque</button>
            <button type="button" class="bot-chip" data-ask="Qual o telefone, WhatsApp e horário de suporte?">📞 Suporte e contato</button>
            <button type="button" class="bot-chip" data-ask="Qual o endereço da loja?">📍 Endereço</button>
          </div>

          <form class="bot-form" id="bot-form">
            <input
              type="text"
              id="bot-input"
              placeholder={
                empresa.agenda_ativa === 1
                  ? 'Pergunte sobre pedidos, agendamentos ou produtos...'
                  : 'Pergunte sobre um pedido ou produto...'
              }
              autocomplete="off"
            />
            <button type="submit" id="bot-send">Enviar</button>
          </form>
        </div>
      </>
    )}

    <script is:inline>
      (function () {
        const fab = document.getElementById('bot-fab');
        const win = document.getElementById('bot-win');
        const closeBtn = document.getElementById('bot-close');
        const msgs = document.getElementById('bot-msgs');
        const form = document.getElementById('bot-form');
        const input = document.getElementById('bot-input');
        const empresaCodigo = win ? win.getAttribute('data-empresa') : '';

        if (!fab || !win || !msgs || !form || !input) return;

        function formatBotHtml(text) {
          return String(text || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/_(.+?)_/g, '<em>$1</em>')
            .replace(/\*(.+?)\*/g, '<em>$1</em>')
            .replace(/\n/g, '<br>');
        }

        function addBubble(text, who) {
          const div = document.createElement('div');
          div.className = 'bot-bubble ' + who;
          if (who === 'bot') {
            div.innerHTML = formatBotHtml(text);
          } else {
            div.textContent = text;
          }
          msgs.appendChild(div);
          msgs.scrollTop = msgs.scrollHeight;
          return div;
        }

        async function askBot(question) {
          const q = String(question || '').trim();
          if (!q) return;
          if (!win.classList.contains('open')) win.classList.add('open');

          addBubble(q, 'user');
          input.value = '';
          const loading = addBubble('Consultando...', 'bot');

          try {
            const resp = await fetch('/api/loja-chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ empresa: empresaCodigo, mensagem: q }),
            });
            const data = await resp.json();
            if (resp.status === 401 || data.sessaoExpirada) {
              window.location.href = `/loja/${empresaCodigo}/sair?expirado=1`;
              return;
            }
            loading.innerHTML = formatBotHtml(
              data.resposta || data.erro || 'Não foi possível obter resposta no momento.',
            );
          } catch {
            loading.textContent = 'Erro de conexão ao consultar o assistente.';
          }
          msgs.scrollTop = msgs.scrollHeight;
        }

        fab.addEventListener('click', () => {
          win.classList.toggle('open');
          if (win.classList.contains('open')) input.focus();
        });

        closeBtn && closeBtn.addEventListener('click', () => win.classList.remove('open'));

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          askBot(input.value);
        });

        document.querySelectorAll('.bot-chip').forEach((btn) => {
          btn.addEventListener('click', () => {
            askBot(btn.getAttribute('data-ask'));
          });
        });
      })();

      // Desconexão automática por inatividade na Loja Virtual
      (function () {
        const sairUrl = document.body.getAttribute('data-sair-url');
        const logoutForm = document.getElementById('loja-logout-form');
        if (!sairUrl && !logoutForm) return;
        const IDLE_LIMIT_MS = Number(document.body.getAttribute('data-idle-ms')) || 5 * 60 * 1000;
        let timer;
        function dropClientSession() {
          if (logoutForm) {
            const baseAction = logoutForm.getAttribute('action') || '';
            logoutForm.action = baseAction + (baseAction.includes('?') ? '&' : '?') + 'expirado=1';
            logoutForm.submit();
          } else if (sairUrl) {
            window.location.href = sairUrl;
          }
        }
        function resetIdleTimer() {
          clearTimeout(timer);
          timer = setTimeout(dropClientSession, IDLE_LIMIT_MS);
        }
        ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach((ev) => {
          window.addEventListener(ev, resetIdleTimer, { passive: true });
        });
        resetIdleTimer();
      })();

      // Telemetria anônima da Loja Virtual: tempo médio de permanência e intervalo médio de retorno (sem individualizar por cliente)
      (function () {
        const empCod = document.body.getAttribute('data-empresa-codigo');
        if (!empCod) return;

        try {
          const tokKey = 'loja_visita_tok_' + empCod;
          const iniKey = 'loja_visita_ini_' + empCod;
          const retKey = 'loja_visita_ret_' + empCod;
          const ultKey = 'loja_ult_acesso_' + empCod;

          const agora = Date.now();
          let token = sessionStorage.getItem(tokKey);
          let iniMs = Number(sessionStorage.getItem(iniKey) || '0');
          let intervaloRetornoSeg = null;

          if (!token || !iniMs) {
            token =
              'vis_' +
              agora.toString(36) +
              '_' +
              Math.random().toString(36).slice(2, 10);
            iniMs = agora;
            sessionStorage.setItem(tokKey, token);
            sessionStorage.setItem(iniKey, String(iniMs));

            const ultAcessoMs = Number(localStorage.getItem(ultKey) || '0');
            if (ultAcessoMs > 0 && agora > ultAcessoMs) {
              const diffSeg = Math.round((agora - ultAcessoMs) / 1000);
              // Considera como retorno uma nova sessão iniciada após pelo menos 60 segundos do acesso anterior
              if (diffSeg >= 60) {
                intervaloRetornoSeg = diffSeg;
                sessionStorage.setItem(retKey, String(diffSeg));
              }
            }
          } else {
            const savedRet = sessionStorage.getItem(retKey);
            if (savedRet) intervaloRetornoSeg = Number(savedRet);
          }

          localStorage.setItem(ultKey, String(agora));

          function enviarPingVisita() {
            const now = Date.now();
            localStorage.setItem(ultKey, String(now));
            const durSeg = Math.max(1, Math.round((now - iniMs) / 1000));
            let tz = '';
            try {
              tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            } catch {}
            const payload = JSON.stringify({
              empresa: empCod,
              acao: 'ping_visita',
              visitaToken: token,
              duracaoSegundos: durSeg,
              intervaloRetornoSegundos: intervaloRetornoSeg,
              timezone: tz,
              idioma: navigator.language || '',
            });

            fetch('/api/loja-metricas', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: payload,
            }).catch(() => {});
          }

          // Envia ping inicial após 2 segundos e atualiza a cada 15 segundos enquanto a aba estiver visível
          setTimeout(enviarPingVisita, 2000);
          setInterval(() => {
            if (document.visibilityState === 'visible') {
              enviarPingVisita();
            }
          }, 15000);

          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') {
              enviarPingVisita();
            }
          });
          window.addEventListener('pagehide', enviarPingVisita);
        } catch {}
      })();

      // Registro do Service Worker PWA e botão de instalação do App da Loja
      (function () {
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
        const isStandalone =
          window.matchMedia('(display-mode: standalone)').matches ||
          window.navigator.standalone === true;
        if (isStandalone) return;

        let deferredPrompt = null;
        const btnPwaLoja = document.getElementById('btn-pwa-loja');
        const isIos = /iphone|ipad|ipod/i.test(window.navigator.userAgent);

        if (isIos && btnPwaLoja) {
          btnPwaLoja.style.display = 'inline-flex';
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          if (btnPwaLoja) btnPwaLoja.style.display = 'inline-flex';
        });

        if (btnPwaLoja) {
          btnPwaLoja.addEventListener('click', async () => {
            if (deferredPrompt) {
              deferredPrompt.prompt();
              await deferredPrompt.userChoice;
              deferredPrompt = null;
              btnPwaLoja.style.display = 'none';
            } else if (isIos) {
              alert(
                'Para instalar o aplicativo no iPhone/iPad:\n1. Toque no ícone de Compartilhar do Safari (quadrado com seta para cima)\n2. Role e toque em "Adicionar à Tela de Início".',
              );
            }
          });
        }
      })();
    </script>
  </body>
</html>
