              </a>
              <a href={`${baseUrl}/meu-cadastro`}>Meu Cadastro</a>
              <a href={`${baseUrl}?fav=1`} title="Ver meus produtos favoritos">❤️ Favoritos</a>
              {empresa.agenda_ativa === 1 && (
                <a href={`${baseUrl}/agenda`} style="font-weight:700">📅 {empresa.agenda_menu_texto || 'Agenda'}</a>
              )}
              <a href={`${baseUrl}/meus-pedidos`}>Compras</a>
              <a href={`${baseUrl}/carrinho`} class="ml-cart-pill">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="9" cy="21" r="1.5" fill="#000000" />
                  <circle cx="20" cy="21" r="1.5" fill="#000000" />
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
                <span>Carrinho</span>
                <span class="ml-badge">{qtdCarrinho}</span>
