---
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/auth';
import { DIAS_SEMANA_LABELS } from '../lib/empresa-service';
import { str } from '../lib/validate';

const u = Astro.locals.user!;
const validColor = (c: string, def: string) => (/^#[0-9a-fA-F]{6}$/.test(c) ? c : def);

let erro = '';
let ok = false;

let emp = await db()
  .prepare(
    `SELECT codigo, razao_social, nome_fantasia, cnpj,
            loja_nome, loja_logo, cor_primaria, cor_secundaria, cor_fundo, cor_texto,
            rodape_sobre, rodape_telefone, rodape_whatsapp, rodape_email,
            rodape_horario, rodape_endereco, rodape_suporte, rodape_instagram,
            rodape_facebook, rodape_copyright, rodape_cor_fundo, rodape_cor_texto,
            COALESCE(agenda_ativa, 0) AS agenda_ativa,
            COALESCE(NULLIF(agenda_menu_texto, ''), 'Agenda') AS agenda_menu_texto,
            COALESCE(agenda_inicio, '08:00') AS agenda_inicio,
            COALESCE(agenda_fim, '18:00') AS agenda_fim,
            COALESCE(agenda_intervalo_min, 30) AS agenda_intervalo_min,
            COALESCE(agenda_dias_semana, '1,2,3,4,5') AS agenda_dias_semana,
            agenda_datas_fechadas
       FROM empresas WHERE id = ?`,
  )
  .bind(u.empresaId)
  .first<any>();

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const lojaNome = str(f, 'loja_nome', 120);
  const corPrimaria = validColor(str(f, 'cor_primaria', 10), '#2563eb');
  const corSecundaria = validColor(str(f, 'cor_secundaria', 10), '#111827');
  const corFundo = validColor(str(f, 'cor_fundo', 10), '#f4f6f9');
  const corTexto = validColor(str(f, 'cor_texto', 10), '#1c2430');
  let lojaLogo = str(f, 'loja_logo', 300_000); // aceita URL ou Data-URL (base64)
  if (f.get('remover_logo')) lojaLogo = '';

  const rodapeSobre = str(f, 'rodape_sobre', 600);
  const rodapeTelefone = str(f, 'rodape_telefone', 60);
  const rodapeWhatsapp = str(f, 'rodape_whatsapp', 60);
  const rodapeEmail = str(f, 'rodape_email', 120);
  const rodapeHorario = str(f, 'rodape_horario', 120);
  const rodapeEndereco = str(f, 'rodape_endereco', 400);
  const rodapeSuporte = str(f, 'rodape_suporte', 600);
  const rodapeInstagram = str(f, 'rodape_instagram', 160);
  const rodapeFacebook = str(f, 'rodape_facebook', 160);
  const rodapeCopyright = str(f, 'rodape_copyright', 240);
  const rodapeCorFundo = validColor(str(f, 'rodape_cor_fundo', 10), '#ffffff');
  const rodapeCorTexto = validColor(str(f, 'rodape_cor_texto', 10), '#333333');
  const agendaAtiva = f.get('agenda_ativa') ? 1 : 0;
  const agendaMenuTexto = str(f, 'agenda_menu_texto', 60) || 'Agenda';
  const agendaInicio = /^\d{2}:\d{2}$/.test(str(f, 'agenda_inicio', 10)) ? str(f, 'agenda_inicio', 10) : '08:00';
  const agendaFim = /^\d{2}:\d{2}$/.test(str(f, 'agenda_fim', 10)) ? str(f, 'agenda_fim', 10) : '18:00';
  const agendaIntervaloMin = Math.max(10, Math.min(120, Number(f.get('agenda_intervalo_min')) || 30));
  const diasMarcados = f
    .getAll('agenda_dias_semana')
    .map((v) => String(v).trim())
    .filter((v) => /^[0-6]$/.test(v));
  const agendaDiasSemana = diasMarcados.join(',');
  const agendaDatasFechadas = str(f, 'agenda_datas_fechadas', 1000);

  if (lojaLogo && !/^(https?:\/\/|data:image\/)/i.test(lojaLogo)) {
    erro = 'A logo deve ser uma URL válida (http/https) ou uma imagem enviada do seu computador.';
  } else {
    await db()
      .prepare(
        `UPDATE empresas
            SET loja_nome = ?, loja_logo = ?, cor_primaria = ?, cor_secundaria = ?, cor_fundo = ?, cor_texto = ?,
                rodape_sobre = ?, rodape_telefone = ?, rodape_whatsapp = ?, rodape_email = ?,
                rodape_horario = ?, rodape_endereco = ?, rodape_suporte = ?, rodape_instagram = ?,
                rodape_facebook = ?, rodape_copyright = ?, rodape_cor_fundo = ?, rodape_cor_texto = ?,
                agenda_ativa = ?, agenda_menu_texto = ?, agenda_inicio = ?, agenda_fim = ?, agenda_intervalo_min = ?,
                agenda_dias_semana = ?, agenda_datas_fechadas = ?
          WHERE id = ?`,
      )
      .bind(
        lojaNome || null,
        lojaLogo || null,
        corPrimaria,
        corSecundaria,
        corFundo,
        corTexto,
        rodapeSobre || null,
        rodapeTelefone || null,
        rodapeWhatsapp || null,
        rodapeEmail || null,
        rodapeHorario || null,
        rodapeEndereco || null,
        rodapeSuporte || null,
        rodapeInstagram || null,
        rodapeFacebook || null,
        rodapeCopyright || null,
        rodapeCorFundo,
        rodapeCorTexto,
        agendaAtiva,
        agendaMenuTexto,
        agendaInicio,
        agendaFim,
        agendaIntervaloMin,
        agendaDiasSemana,
        agendaDatasFechadas || null,
        u.empresaId,
      )
      .run();
    emp = {
      ...emp,
      loja_nome: lojaNome,
      loja_logo: lojaLogo,
      cor_primaria: corPrimaria,
      cor_secundaria: corSecundaria,
      cor_fundo: corFundo,
      cor_texto: corTexto,
      rodape_sobre: rodapeSobre,
      rodape_telefone: rodapeTelefone,
      rodape_whatsapp: rodapeWhatsapp,
      rodape_email: rodapeEmail,
      rodape_horario: rodapeHorario,
      rodape_endereco: rodapeEndereco,
      rodape_suporte: rodapeSuporte,
      rodape_instagram: rodapeInstagram,
      rodape_facebook: rodapeFacebook,
      rodape_copyright: rodapeCopyright,
      rodape_cor_fundo: rodapeCorFundo,
      rodape_cor_texto: rodapeCorTexto,
      agenda_ativa: agendaAtiva,
      agenda_menu_texto: agendaMenuTexto,
      agenda_inicio: agendaInicio,
      agenda_fim: agendaFim,
      agenda_intervalo_min: agendaIntervaloMin,
      agenda_dias_semana: agendaDiasSemana,
      agenda_datas_fechadas: agendaDatasFechadas,
    };
    ok = true;
  }
}

const urlLoja = `/loja/${emp.codigo}`;
const nomeExibicao = emp.loja_nome || emp.nome_fantasia || emp.razao_social;
---
<Layout title="Personalizar Loja Virtual" active="loja-config">
  <div class="row">
    <h1>Personalizar Minha Loja Virtual</h1>
    <span class="spacer"></span>
    <a class="btn" href={urlLoja} target="_blank">🛒 Abrir minha loja ({urlLoja}) ↗</a>
  </div>
  {erro && <div class="msg err">{erro}</div>}
  {ok && <div class="msg ok">Personalização da loja salva com sucesso!</div>}

  <form method="post" id="form-loja">
    <div class="card">
      <h2>Identidade e Logomarca</h2>
      <div class="grid">
        <div class="c6">
          <label>Nome de exibição na loja</label>
          <input name="loja_nome" id="inp-nome" value={emp.loja_nome ?? ''} placeholder={emp.nome_fantasia || emp.razao_social} />
        </div>
        <div class="c6">
          <label>Endereço público da sua loja</label>
          <input readonly value={`${Astro.url.origin}${urlLoja}`} onclick="this.select()" style="background:#f9fafb" />
        </div>

        <div class="c6">
          <label>Enviar imagem da logo (PNG, JPG, SVG ou WebP)</label>
          <input type="file" id="inp-file-logo" accept="image/*" />
        </div>
        <div class="c6">
          <label>Ou informe a URL da logo</label>
          <input name="loja_logo" id="inp-logo" value={emp.loja_logo ?? ''} placeholder="https://..." />
        </div>
        {emp.loja_logo && (
          <div class="c12">
            <label class="check"><input type="checkbox" name="remover_logo" value="1" /> Remover logo atual</label>
          </div>
        )}
      </div>
    </div>

    <div class="card">
      <h2>📅 Agenda de Serviços na Loja Virtual</h2>
      <div class="grid">
        <div class="c12">
          <label class="check" style="font-size:15px;font-weight:700;color:#0f172a">
            <input type="checkbox" name="agenda_ativa" value="1" checked={emp.agenda_ativa === 1} />
            Exibir o menu da Agenda na Loja Virtual (permite que clientes agendem serviços online)
          </label>
          <small class="muted" style="display:block;margin-top:4px">
            Quando marcado, o link aparece no topo da sua loja virtual com o texto personalizado abaixo. Você pode cadastrar os procedimentos e tempos de execução em <a href="/servicos"><strong>Serviços</strong></a> e acompanhar as marcações em <a href="/agendamentos"><strong>Agendamentos</strong></a>.
          </small>
        </div>
        <div class="c6">
          <label>Texto que aparecerá no menu da agenda na loja</label>
          <input
            name="agenda_menu_texto"
            value={emp.agenda_menu_texto || 'Agenda'}
            placeholder="Ex: Agende aqui seu serviço"
          />
        </div>
        <div class="c2">
          <label>Início da agenda</label>
          <input type="time" name="agenda_inicio" value={emp.agenda_inicio || '08:00'} />
        </div>
        <div class="c2">
          <label>Fim da agenda</label>
          <input type="time" name="agenda_fim" value={emp.agenda_fim || '18:00'} />
        </div>
        <div class="c2">
          <label>Intervalo da grade</label>
          <select name="agenda_intervalo_min">
            {[15, 20, 30, 45, 60].map((m) => (
              <option value={m} selected={(emp.agenda_intervalo_min || 30) === m}>
                {m} min
              </option>
            ))}
          </select>
        </div>

        <div class="c12">
          <label>Dias da semana com prestação de serviço</label>
          <div style="display:flex;gap:14px;flex-wrap:wrap;padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
            {DIAS_SEMANA_LABELS.map((d) => {
              const ativos = String(emp.agenda_dias_semana ?? '1,2,3,4,5')
                .split(',')
                .map((s: string) => s.trim());
              return (
                <label class="check" style="font-weight:600;color:#1e293b">
                  <input
                    type="checkbox"
                    name="agenda_dias_semana"
                    value={String(d.valor)}
                    checked={ativos.includes(String(d.valor))}
                  />
                  {d.longo}
                </label>
              );
            })}
          </div>
          <small class="muted" style="display:block;margin-top:4px">
            Desmarque os dias da semana em que não há atendimento (ex.: Domingo, Sábado).
          </small>
        </div>

        <div class="c12">
          <label>Datas específicas sem expediente / feriados / folgas (opcional)</label>
          <div class="row" style="gap:8px;margin-bottom:6px">
            <input type="date" id="inp-add-data-fechada" style="max-width:200px" />
            <button
              type="button"
              class="sec sm"
              onclick="const d=document.getElementById('inp-add-data-fechada').value;const t=document.getElementById('inp-datas-fechadas');if(d&&!t.value.includes(d)){t.value=(t.value?t.value+', ':'')+d;}"
            >
              + Adicionar data sem expediente
            </button>
          </div>
          <input
            name="agenda_datas_fechadas"
            id="inp-datas-fechadas"
            value={emp.agenda_datas_fechadas ?? ''}
            placeholder="Ex: 2026-12-25, 2027-01-01 (datas no formato AAAA-MM-DD separadas por vírgula)"
          />
          <small class="muted" style="display:block;margin-top:4px">
            Nessas datas a agenda mostrará aos clientes que não haverá prestação de serviço.
          </small>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Cores da Loja</h2>
      <div class="grid">
        <div class="c3">
          <label>Cor principal (botões e destaques)</label>
          <input type="color" name="cor_primaria" id="inp-cp" value={emp.cor_primaria || '#2563eb'} style="height:42px;padding:4px" />
        </div>
        <div class="c3">
          <label>Cor do cabeçalho / topo</label>
          <input type="color" name="cor_secundaria" id="inp-cs" value={emp.cor_secundaria || '#111827'} style="height:42px;padding:4px" />
        </div>
        <div class="c3">
          <label>Cor de fundo da página</label>
          <input type="color" name="cor_fundo" id="inp-cf" value={emp.cor_fundo || '#f4f6f9'} style="height:42px;padding:4px" />
        </div>
        <div class="c3">
          <label>Cor dos textos</label>
          <input type="color" name="cor_texto" id="inp-ct" value={emp.cor_texto || '#1c2430'} style="height:42px;padding:4px" />
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Rodapé Personalizável da Loja (Contato, Suporte e Endereço)</h2>
      <div class="grid">
        <div class="c3">
          <label>Telefone de contato</label>
          <input name="rodape_telefone" id="inp-rtel" value={emp.rodape_telefone ?? ''} placeholder="(11) 3000-0000" />
        </div>
        <div class="c3">
          <label>WhatsApp de atendimento</label>
          <input name="rodape_whatsapp" id="inp-rwhats" value={emp.rodape_whatsapp ?? ''} placeholder="(11) 99999-9999" />
        </div>
        <div class="c3">
          <label>E-mail de suporte / SAC</label>
          <input type="email" name="rodape_email" id="inp-remail" value={emp.rodape_email ?? ''} placeholder="contato@sualoja.com.br" />
        </div>
        <div class="c3">
          <label>Horário de atendimento</label>
          <input name="rodape_horario" id="inp-rhor" value={emp.rodape_horario ?? ''} placeholder="Seg a Sex, das 8h às 18h" />
        </div>

        <div class="c6">
          <label>Sobre a loja / Texto institucional</label>
          <textarea
            name="rodape_sobre"
            id="inp-rsobre"
            rows="3"
            placeholder="Breve apresentação da sua empresa exibida na primeira coluna do rodapé..."
          >{emp.rodape_sobre ?? ''}</textarea>
        </div>
        <div class="c6">
          <label>Informações de Suporte, Trocas, Devoluções e Entrega</label>
          <textarea
            name="rodape_suporte"
            id="inp-rsup"
            rows="3"
            placeholder="Ex: Garantia de 90 dias, política de trocas em até 7 dias corridos, suporte técnico..."
          >{emp.rodape_suporte ?? ''}</textarea>
        </div>

        <div class="c12">
          <label>Endereço físico / Localização da loja</label>
          <textarea
            name="rodape_endereco"
            id="inp-rend"
            rows="2"
            placeholder="Ex: Av. Paulista, 1000 - Bela Vista, São Paulo/SP - CEP 01310-100"
          >{emp.rodape_endereco ?? ''}</textarea>
        </div>

        <div class="c3">
          <label>Instagram (usuário ou link)</label>
          <input name="rodape_instagram" value={emp.rodape_instagram ?? ''} placeholder="@sualoja" />
        </div>
        <div class="c3">
          <label>Facebook / Site institucional</label>
          <input name="rodape_facebook" value={emp.rodape_facebook ?? ''} placeholder="https://facebook.com/..." />
        </div>
        <div class="c3">
          <label>Cor de fundo do rodapé</label>
          <input type="color" name="rodape_cor_fundo" id="inp-rcf" value={emp.rodape_cor_fundo || '#ffffff'} style="height:42px;padding:4px" />
        </div>
        <div class="c3">
          <label>Cor do texto do rodapé</label>
          <input type="color" name="rodape_cor_texto" id="inp-rct" value={emp.rodape_cor_texto || '#333333'} style="height:42px;padding:4px" />
        </div>

        <div class="c12">
          <label>Texto de direitos reservados / Copyright (opcional — deixe em branco para usar Razão Social e CNPJ)</label>
          <input
            name="rodape_copyright"
            id="inp-rcopy"
            value={emp.rodape_copyright ?? ''}
            placeholder={`© ${new Date().getFullYear()} ${emp.razao_social} · Todos os direitos reservados.`}
          />
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Pré-visualização ao vivo</h2>
      <div id="preview-box" style={`border:1px solid var(--bd);border-radius:10px;overflow:hidden;background:${emp.cor_fundo};color:${emp.cor_texto}`}>
        <div id="prev-top" style={`display:flex;align-items:center;gap:14px;padding:12px 20px;background:${emp.cor_secundaria};color:#fff`}>
          <img
            id="prev-logo"
            src={emp.loja_logo || ''}
            alt="Logo"
            style={`max-height:40px;max-width:140px;object-fit:contain;border-radius:4px;${emp.loja_logo ? '' : 'display:none'}`}
          />
          <strong id="prev-nome" style="font-size:18px">{nomeExibicao}</strong>
          <span style="flex:1"></span>
          <span style="font-size:13px;opacity:.85">Categorias · Carrinho (2)</span>
        </div>
        <div style="padding:20px;display:flex;gap:16px;align-items:center;flex-wrap:wrap">
          <div style="background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:14px;min-width:220px">
            <div style="font-size:12px;opacity:.65">Categoria Exemplo</div>
            <div style="font-weight:600;margin:4px 0">Produto Exemplo em Estoque</div>
            <div style="font-size:18px;font-weight:700;margin:8px 0">R$ 99,90</div>
            <span
              id="prev-btn"
              style={`display:inline-block;padding:7px 14px;border-radius:6px;background:${emp.cor_primaria};color:#fff;font-size:14px`}
            >
              + Adicionar ao carrinho
            </span>
          </div>
        </div>
        <div
          id="prev-footer"
          style={`padding:16px 20px;border-top:1px solid rgba(0,0,0,.1);background:${emp.rodape_cor_fundo || '#ffffff'};color:${emp.rodape_cor_texto || '#333333'};font-size:12px`}
        >
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px">
            <div>
              <strong id="prev-fnome">{nomeExibicao}</strong>
              <div id="prev-fsobre" style="opacity:.85;margin-top:4px">{emp.rodape_sobre || 'Sua loja virtual oficial.'}</div>
            </div>
            <div>
              <strong>Contato e Atendimento</strong>
              <div id="prev-fcontato" style="opacity:.85;margin-top:4px">
                {[emp.rodape_telefone, emp.rodape_whatsapp, emp.rodape_email, emp.rodape_horario].filter(Boolean).join(' · ') || 'Telefone, WhatsApp e E-mail'}
              </div>
            </div>
            <div>
              <strong>Suporte ao Cliente</strong>
              <div id="prev-fsuporte" style="opacity:.85;margin-top:4px">{emp.rodape_suporte || 'Dúvidas sobre pedidos, entregas e trocas.'}</div>
            </div>
            <div>
              <strong>Endereço</strong>
              <div id="prev-fend" style="opacity:.85;margin-top:4px">{emp.rodape_endereco || 'Endereço da loja'}</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <button>Salvar personalização</button>
    </div>
  </form>
</Layout>

<script is:inline>
  const inpFile = document.getElementById('inp-file-logo');
  const inpLogo = document.getElementById('inp-logo');
  const inpNome = document.getElementById('inp-nome');
  const inpCp = document.getElementById('inp-cp');
  const inpCs = document.getElementById('inp-cs');
  const inpCf = document.getElementById('inp-cf');
  const inpCt = document.getElementById('inp-ct');

  const prevBox = document.getElementById('preview-box');
  const prevTop = document.getElementById('prev-top');
  const prevLogo = document.getElementById('prev-logo');
  const prevNome = document.getElementById('prev-nome');
  const prevBtn = document.getElementById('prev-btn');
  const prevFooter = document.getElementById('prev-footer');
  const prevFnome = document.getElementById('prev-fnome');
  const prevFsobre = document.getElementById('prev-fsobre');
  const prevFcontato = document.getElementById('prev-fcontato');
  const prevFsuporte = document.getElementById('prev-fsuporte');
  const prevFend = document.getElementById('prev-fend');

  const inpRtel = document.getElementById('inp-rtel');
  const inpRwhats = document.getElementById('inp-rwhats');
  const inpRemail = document.getElementById('inp-remail');
  const inpRhor = document.getElementById('inp-rhor');
  const inpRsobre = document.getElementById('inp-rsobre');
  const inpRsup = document.getElementById('inp-rsup');
  const inpRend = document.getElementById('inp-rend');
  const inpRcf = document.getElementById('inp-rcf');
  const inpRct = document.getElementById('inp-rct');

  function syncPreview() {
    prevBox.style.background = inpCf.value;
    prevBox.style.color = inpCt.value;
    prevTop.style.background = inpCs.value;
    prevBtn.style.background = inpCp.value;
    const nome = inpNome.value.trim() || inpNome.placeholder;
    prevNome.textContent = nome;
    prevFnome.textContent = nome;
    if (inpLogo.value.trim()) {
      prevLogo.src = inpLogo.value.trim();
      prevLogo.style.display = 'block';
    } else {
      prevLogo.style.display = 'none';
    }
    prevFooter.style.background = inpRcf.value;
    prevFooter.style.color = inpRct.value;
    prevFsobre.textContent = inpRsobre.value.trim() || 'Sua loja virtual oficial.';
    prevFcontato.textContent =
      [inpRtel.value.trim(), inpRwhats.value.trim(), inpRemail.value.trim(), inpRhor.value.trim()]
        .filter(Boolean)
        .join(' · ') || 'Telefone, WhatsApp e E-mail';
    prevFsuporte.textContent = inpRsup.value.trim() || 'Dúvidas sobre pedidos, entregas e trocas.';
    prevFend.textContent = inpRend.value.trim() || 'Endereço da loja';
  }

  [
    inpLogo, inpNome, inpCp, inpCs, inpCf, inpCt,
    inpRtel, inpRwhats, inpRemail, inpRhor, inpRsobre, inpRsup, inpRend, inpRcf, inpRct,
  ].forEach((el) => el && el.addEventListener('input', syncPreview));

  // Converte imagem selecionada para Data-URL compactada (até 320px de largura) para salvar direto no banco
  inpFile.addEventListener('change', () => {
    const file = inpFile.files && inpFile.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        const maxW = 320;
        const maxH = 120;
        let w = img.width;
        let h = img.height;
        const ratio = Math.min(maxW / w, maxH / h, 1);
        w = Math.round(w * ratio);
        h = Math.round(h * ratio);
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        inpLogo.value = canvas.toDataURL('image/png');
        syncPreview();
      };
      img.src = String(reader.result);
    };
    reader.readAsDataURL(file);
  });
</script>
